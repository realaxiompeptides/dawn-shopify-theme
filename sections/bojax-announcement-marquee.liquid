<section
  id="BojaxAnnouncement-{{ section.id }}"
  class="bojax-announcement"
  style="
    --bojax-announcement-speed: {{ section.settings.speed }}s;
    --bojax-announcement-background: {{ section.settings.background }};
    --bojax-announcement-text: {{ section.settings.text_color }};
    --bojax-announcement-accent: {{ section.settings.accent_color }};
  "
  aria-label="Store announcements"
>
  <div class="bojax-announcement__viewport">
    <div class="bojax-announcement__track">
      <div class="bojax-announcement__group">
        {% for block in section.blocks %}
          <div
            class="bojax-announcement__item"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}">
            {% endif %}

            {% case block.settings.icon %}
              {% when 'star' %}
                <span class="bojax-announcement__icon" aria-hidden="true">
                  ★
                </span>

              {% when 'bolt' %}
                <span class="bojax-announcement__icon" aria-hidden="true">
                  ϟ
                </span>

              {% when 'diamond' %}
                <span class="bojax-announcement__icon" aria-hidden="true">
                  ◆
                </span>

              {% when 'check' %}
                <span class="bojax-announcement__icon" aria-hidden="true">
                  ✓
                </span>
            {% endcase %}

            <span class="bojax-announcement__text">
              {{ block.settings.text }}
            </span>

            {% if block.settings.link != blank %}
              </a>
            {% endif %}
          </div>

          <span
            class="bojax-announcement__separator"
            aria-hidden="true"
          ></span>
        {% endfor %}
      </div>

      <div
        class="bojax-announcement__group"
        aria-hidden="true"
      >
        {% for block in section.blocks %}
          <div class="bojax-announcement__item">
            {% case block.settings.icon %}
              {% when 'star' %}
                <span class="bojax-announcement__icon">
                  ★
                </span>

              {% when 'bolt' %}
                <span class="bojax-announcement__icon">
                  ϟ
                </span>

              {% when 'diamond' %}
                <span class="bojax-announcement__icon">
                  ◆
                </span>

              {% when 'check' %}
                <span class="bojax-announcement__icon">
                  ✓
                </span>
            {% endcase %}

            <span class="bojax-announcement__text">
              {{ block.settings.text }}
            </span>
          </div>

          <span class="bojax-announcement__separator"></span>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .bojax-announcement {
    position: sticky;
    top: 0;
    z-index: 100001;

    display: block;
    width: 100%;
    height: 4.4rem;

    overflow: hidden;

    border-top: 1px solid rgba(216, 184, 106, 0.22);
    border-bottom: 1px solid rgba(216, 184, 106, 0.28);

    background:
      radial-gradient(
        circle at 50% 0,
        rgba(216, 184, 106, 0.13),
        transparent 65%
      ),
      linear-gradient(
        90deg,
        #050504,
        var(--bojax-announcement-background),
        #050504
      );

    color: var(--bojax-announcement-text);

    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.32);
  }

  .bojax-announcement__viewport {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .bojax-announcement__track {
    display: flex;
    width: max-content;
    min-width: 200%;
    height: 100%;

    align-items: center;

    animation:
      bojaxAnnouncementScroll
      var(--bojax-announcement-speed)
      linear
      infinite;

    will-change: transform;
  }

  .bojax-announcement__group {
    display: flex;
    flex: 0 0 auto;
    min-width: 50%;
    height: 100%;

    align-items: center;
  }

  .bojax-announcement__item {
    display: inline-flex;
    flex: 0 0 auto;
    height: 100%;
    padding: 0 2.8rem;

    align-items: center;
    justify-content: center;
    gap: 0.85rem;

    color: var(--bojax-announcement-text);

    font-size: 1rem;
    font-weight: 850;
    letter-spacing: 0.17em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .bojax-announcement__item a {
    display: inline-flex;
    height: 100%;

    align-items: center;
    gap: 0.85rem;

    color: inherit;
    text-decoration: none;
  }

  .bojax-announcement__icon {
    color: var(--bojax-announcement-accent);

    font-size: 1.1rem;
    line-height: 1;
  }

  .bojax-announcement__separator {
    display: block;
    flex: 0 0 1px;

    width: 1px;
    height: 2rem;

    background:
      linear-gradient(
        180deg,
        transparent,
        var(--bojax-announcement-accent),
        transparent
      );

    opacity: 0.8;
  }

  @keyframes bojaxAnnouncementScroll {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media screen and (max-width: 749px) {
    .bojax-announcement {
      height: 4rem;
    }

    .bojax-announcement__item {
      padding: 0 2rem;

      font-size: 0.84rem;
      letter-spacing: 0.13em;
    }

    .bojax-announcement__separator {
      height: 1.7rem;
    }

    .bojax-announcement__icon {
      font-size: 0.95rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bojax-announcement__track {
      animation-duration: 90s;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bojax moving announcement",
  "tag": "section",
  "class": "bojax-announcement-section",
  "max_blocks": 6,
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "min": 12,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Movement speed",
      "default": 26,
      "info": "A smaller number moves faster."
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#090806"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Icons and dividing lines",
      "default": "#D8B86A"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "star",
          "options": [
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "bolt",
              "label": "Bolt"
            },
            {
              "value": "diamond",
              "label": "Diamond"
            },
            {
              "value": "check",
              "label": "Check"
            },
            {
              "value": "none",
              "label": "No icon"
            }
          ]
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "The complete Bojax Method"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bojax moving announcement",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "icon": "star",
            "text": "Limited-time course pricing"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "icon": "bolt",
            "text": "20M+ views across TikTok"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "icon": "diamond",
            "text": "Created by Bojax"
          }
        }
      ]
    }
  ]
}
{% endschema %}
