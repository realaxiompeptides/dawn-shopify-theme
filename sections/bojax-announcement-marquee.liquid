<section
  id="BojaxAnnouncement-{{ section.id }}"
  class="bojax-announcement"
  style="
    --bojax-marquee-speed: {{ section.settings.speed }}s;
    --bojax-marquee-background: {{ section.settings.background_color }};
    --bojax-marquee-text: {{ section.settings.text_color }};
    --bojax-marquee-gold: {{ section.settings.accent_color }};
  "
  aria-label="Store announcements"
>
  <div class="bojax-announcement__viewport">
    <div class="bojax-announcement__track">
      {% for copy_number in (1..2) %}
        <div
          class="bojax-announcement__group"
          {% if copy_number == 2 %}
            aria-hidden="true"
          {% endif %}
        >
          {% for block in section.blocks %}
            <div
              class="bojax-announcement__item"
              {% if copy_number == 1 %}
                {{ block.shopify_attributes }}
              {% endif %}
            >
              {% if block.settings.link != blank and copy_number == 1 %}
                <a
                  class="bojax-announcement__link"
                  href="{{ block.settings.link }}"
                >
              {% else %}
                <div class="bojax-announcement__link">
              {% endif %}

                {% unless block.settings.icon == 'none' %}
                  <span
                    class="bojax-announcement__icon"
                    aria-hidden="true"
                  >
                    {% case block.settings.icon %}
                      {% when 'star' %}
                        ★
                      {% when 'bolt' %}
                        ϟ
                      {% when 'diamond' %}
                        ◆
                      {% when 'check' %}
                        ✓
                      {% when 'flame' %}
                        ✦
                    {% endcase %}
                  </span>
                {% endunless %}

                <span class="bojax-announcement__text">
                  {{ block.settings.text }}
                </span>

              {% if block.settings.link != blank and copy_number == 1 %}
                </a>
              {% else %}
                </div>
              {% endif %}
            </div>

            <span
              class="bojax-announcement__divider"
              aria-hidden="true"
            ></span>
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .bojax-announcement-section {
    position: relative !important;
    z-index: 100001 !important;

    display: block !important;
    width: 100% !important;

    visibility: visible !important;
    opacity: 1 !important;
  }

  .bojax-announcement {
    position: relative;
    z-index: 100001;

    display: block;
    width: 100%;
    height: 4.5rem;

    overflow: hidden;

    border-top: 1px solid var(--bojax-marquee-gold);
    border-bottom: 1px solid var(--bojax-marquee-gold);

    background: var(--bojax-marquee-background);
    color: var(--bojax-marquee-text);

    box-shadow:
      0 0.5rem 2rem rgba(0, 0, 0, 0.14);

    isolation: isolate;
  }

  .bojax-announcement::before {
    position: absolute;
    inset: 0;
    z-index: 0;

    background:
      linear-gradient(
        90deg,
        rgba(216, 184, 106, 0.06),
        transparent 24%,
        transparent 76%,
        rgba(216, 184, 106, 0.06)
      );

    content: "";
    pointer-events: none;
  }

  .bojax-announcement__viewport {
    position: relative;
    z-index: 1;

    display: block;
    width: 100%;
    height: 100%;

    overflow: hidden;
  }

  .bojax-announcement__track {
    display: flex;
    width: max-content;
    min-width: 200%;
    height: 100%;

    align-items: center;

    animation:
      bojaxAnnouncementMarquee
      var(--bojax-marquee-speed)
      linear
      infinite;

    transform: translate3d(0, 0, 0);
    will-change: transform;
  }

  .bojax-announcement__group {
    display: flex;
    flex: 0 0 auto;
    height: 100%;

    align-items: center;
  }

  .bojax-announcement__item {
    display: flex;
    flex: 0 0 auto;
    height: 100%;
    padding: 0 3rem;

    align-items: center;
    justify-content: center;

    white-space: nowrap;
  }

  .bojax-announcement__link {
    display: inline-flex;
    height: 100%;

    align-items: center;
    justify-content: center;
    gap: 0.9rem;

    color: var(--bojax-marquee-text) !important;

    font-size: 1.05rem;
    font-weight: 850;
    letter-spacing: 0.16em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
  }

  a.bojax-announcement__link:hover {
    color: #000000 !important;
    text-decoration: none;
  }

  .bojax-announcement__text {
    display: inline-block;
    color: inherit;
  }

  .bojax-announcement__icon {
    display: inline-flex;

    color: var(--bojax-marquee-gold);

    font-size: 1.25rem;
    font-weight: 900;
    line-height: 1;
  }

  .bojax-announcement__divider {
    display: block;
    flex: 0 0 2px;

    width: 2px;
    height: 2.4rem;

    background:
      linear-gradient(
        180deg,
        transparent 0%,
        var(--bojax-marquee-gold) 22%,
        var(--bojax-marquee-gold) 78%,
        transparent 100%
      );

    opacity: 0.95;
  }

  @keyframes bojaxAnnouncementMarquee {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .bojax-announcement:hover .bojax-announcement__track {
    animation-play-state: running;
  }

  @media screen and (max-width: 749px) {
    .bojax-announcement {
      height: 4rem;
    }

    .bojax-announcement__item {
      padding: 0 2.1rem;
    }

    .bojax-announcement__link {
      gap: 0.7rem;

      font-size: 0.86rem;
      letter-spacing: 0.12em;
    }

    .bojax-announcement__icon {
      font-size: 1.05rem;
    }

    .bojax-announcement__divider {
      width: 1px;
      height: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bojax-announcement__track {
      animation-duration: 80s;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bojax moving announcement",
  "tag": "section",
  "class": "bojax-announcement-section",
  "max_blocks": 6,
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "min": 12,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Movement speed",
      "default": 24,
      "info": "A smaller number moves faster."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#090909"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Icons and dividing lines",
      "default": "#C79B3B"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "star",
          "options": [
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "bolt",
              "label": "Bolt"
            },
            {
              "value": "diamond",
              "label": "Diamond"
            },
            {
              "value": "check",
              "label": "Check"
            },
            {
              "value": "flame",
              "label": "Spark"
            },
            {
              "value": "none",
              "label": "No icon"
            }
          ]
        },
        {
          "type": "text",
          "id": "text",
          "label": "Announcement text",
          "default": "The complete Bojax Method"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bojax moving announcement",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "icon": "star",
            "text": "Limited-time course pricing"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "icon": "bolt",
            "text": "20M+ views across TikTok"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "icon": "diamond",
            "text": "Created by Bojax"
          }
        }
      ]
    }
  ]
}
{% endschema %}
