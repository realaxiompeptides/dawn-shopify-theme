<section
  class="bojax-marquee"
  style="
    --bojax-marquee-speed:
      {{ section.settings.speed }}s;
  "
  aria-label="Store announcement"
>
  <div class="bojax-marquee__track">

    {% for repetition in (1..4) %}
      <div
        class="bojax-marquee__group"
        aria-hidden="{% if repetition == 1 %}false{% else %}true{% endif %}"
      >
        {% for block in section.blocks %}
          <div
            class="bojax-marquee__item"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.link != blank %}
              <a
                href="{{ block.settings.link }}"
                class="bojax-marquee__link"
              >
            {% endif %}

            {% if block.settings.show_dot %}
              <span
                class="bojax-marquee__dot"
                aria-hidden="true"
              ></span>
            {% endif %}

            <span>
              {{ block.settings.text }}
            </span>

            {% if block.settings.link != blank %}
              </a>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endfor %}

  </div>
</section>

{% stylesheet %}
  .bojax-marquee {
    position:
      relative;

    z-index:
      10;

    width:
      100%;

    overflow:
      hidden;

    border-bottom:
      1px solid rgba(0, 0, 0, 0.12);

    background:
      #ffffff;

    color:
      #000000;
  }

  .bojax-marquee__track {
    display:
      flex;

    width:
      max-content;

    animation:
      bojax-marquee-scroll
      var(--bojax-marquee-speed, 24s)
      linear
      infinite;

    will-change:
      transform;
  }

  .bojax-marquee:hover
  .bojax-marquee__track {
    animation-play-state:
      paused;
  }

  .bojax-marquee__group {
    display:
      flex;

    flex-shrink:
      0;

    align-items:
      center;
  }

  .bojax-marquee__item {
    display:
      inline-flex;

    min-height:
      42px;

    padding:
      9px 28px;

    align-items:
      center;

    gap:
      12px;

    color:
      #000000;

    font-size:
      1.15rem;

    font-weight:
      850;

    letter-spacing:
      0.1em;

    line-height:
      1;

    text-transform:
      uppercase;

    white-space:
      nowrap;
  }

  .bojax-marquee__link {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      12px;

    color:
      inherit;

    text-decoration:
      none;
  }

  .bojax-marquee__link:hover {
    color:
      inherit;

    opacity:
      0.65;
  }

  .bojax-marquee__dot {
    display:
      block;

    flex:
      0 0 5px;

    width:
      5px;

    height:
      5px;

    border-radius:
      50%;

    background:
      #000000;
  }

  @keyframes bojax-marquee-scroll {
    from {
      transform:
        translateX(0);
    }

    to {
      transform:
        translateX(-25%);
    }
  }

  @media screen and (max-width: 749px) {
    .bojax-marquee__item {
      min-height:
        38px;

      padding:
        8px 20px;

      font-size:
        1.05rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bojax-marquee__track {
      animation:
        none;

      transform:
        none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bojax moving announcement",
  "tag": "section",
  "class": "bojax-announcement-section",
  "max_blocks": 8,
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "min": 12,
      "max": 50,
      "step": 2,
      "unit": "s",
      "label": "Movement speed",
      "default": 24,
      "info": "Lower numbers move faster."
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Announcement message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Message",
          "default": "Instant course access"
        },
        {
          "type": "checkbox",
          "id": "show_dot",
          "label": "Show separator dot",
          "default": true
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bojax moving announcement",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "Instant course access"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "Built by Bojax"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "Lifetime updates included"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "Start your transformation"
          }
        }
      ]
    }
  ]
}
{% endschema %}
