<script>
  (() => {
    const initializeBojaxCurriculum = (section) => {
      if (!section || section.dataset.curriculumInitialized === 'true') {
        return;
      }

      section.dataset.curriculumInitialized = 'true';

      const stats = section.querySelector('[data-curriculum-stats]');
      const counters = Array.from(
        section.querySelectorAll('.bojax-curriculum__counter')
      );

      if (!stats || counters.length === 0) return;

      let hasAnimated = false;

      const animateCounter = (counter) => {
        const target = Number(counter.dataset.count) || 0;
        const suffix = counter.dataset.suffix || '';
        const duration = 1500;
        const startTime = performance.now();

        const updateCounter = (currentTime) => {
          const elapsed = currentTime - startTime;
          const progress = Math.min(elapsed / duration, 1);

          const easedProgress =
            1 - Math.pow(1 - progress, 4);

          const currentValue = Math.round(
            target * easedProgress
          );

          counter.textContent = `${currentValue}${suffix}`;

          if (progress < 1) {
            window.requestAnimationFrame(updateCounter);
          } else {
            counter.textContent = `${target}${suffix}`;
          }
        };

        window.requestAnimationFrame(updateCounter);
      };

      const startCounters = () => {
        if (hasAnimated) return;

        hasAnimated = true;
        counters.forEach(animateCounter);
      };

      if (!('IntersectionObserver' in window)) {
        startCounters();
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;

            startCounters();
            observer.disconnect();
          });
        },
        {
          threshold: 0.28
        }
      );

      observer.observe(stats);
    };

    const initializeAllCurriculums = (root = document) => {
      root
        .querySelectorAll('[data-bojax-curriculum]')
        .forEach(initializeBojaxCurriculum);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        initializeAllCurriculums();
      });
    } else {
      initializeAllCurriculums();
    }

    document.addEventListener(
      'shopify:section:load',
      (event) => {
        initializeAllCurriculums(event.target);
      }
    );
  })();
</script>

