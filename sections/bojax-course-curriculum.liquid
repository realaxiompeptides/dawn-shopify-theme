<section
  id="BojaxCurriculum-{{ section.id }}"
  class="bojax-curriculum"
  data-bojax-curriculum
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
>
  <div class="bojax-curriculum__container">

    <header class="bojax-curriculum__header">
      {% if section.settings.eyebrow != blank %}
        <p class="bojax-curriculum__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="bojax-curriculum__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="bojax-curriculum__description">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </header>

    {% if section.settings.show_summary %}
      <div class="bojax-curriculum__summary">
        <div class="bojax-curriculum__summary-item">
          <strong>{{ section.blocks.size }}</strong>
          <span>Complete modules</span>
        </div>

        <div class="bojax-curriculum__summary-item">
          <strong>{{ section.settings.lesson_count }}</strong>
          <span>Step-by-step lessons</span>
        </div>

        <div class="bojax-curriculum__summary-item">
          <strong>∞</strong>
          <span>Lifetime access</span>
        </div>
      </div>
    {% endif %}

    <div class="bojax-included">
      <div class="bojax-included__header">
        {% if section.settings.included_eyebrow != blank %}
          <p class="bojax-included__eyebrow">
            {{ section.settings.included_eyebrow }}
          </p>
        {% endif %}

        {% if section.settings.included_heading != blank %}
          <h3 class="bojax-included__heading">
            {{ section.settings.included_heading }}
          </h3>
        {% endif %}

        {% if section.settings.included_description != blank %}
          <p class="bojax-included__description">
            {{ section.settings.included_description }}
          </p>
        {% endif %}
      </div>

      <div class="bojax-included__grid">
        {% for i in (1..8) %}
          {% assign included_key = 'included_' | append: i %}
          {% assign included_text = section.settings[included_key] %}

          {% if included_text != blank %}
            <div class="bojax-included__item">
              <span class="bojax-included__check" aria-hidden="true">
                <svg viewBox="0 0 20 20">
                  <path
                    d="m5 10.5 3.1 3.1L15.5 6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>

              <span>{{ included_text }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="bojax-curriculum__lessons-header">
      <div>
        {% if section.settings.lessons_eyebrow != blank %}
          <p class="bojax-curriculum__lessons-eyebrow">
            {{ section.settings.lessons_eyebrow }}
          </p>
        {% endif %}

        {% if section.settings.lessons_heading != blank %}
          <h3 class="bojax-curriculum__lessons-heading">
            {{ section.settings.lessons_heading }}
          </h3>
        {% endif %}
      </div>

      {% if section.blocks.size > 1 %}
        <div class="bojax-curriculum__controls">
          <button
            type="button"
            class="bojax-curriculum__control"
            data-curriculum-previous
            aria-label="Previous course module"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="m15 5-7 7 7 7"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>

          <button
            type="button"
            class="bojax-curriculum__control"
            data-curriculum-next
            aria-label="Next course module"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="m9 5 7 7-7 7"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
        </div>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="bojax-curriculum__carousel-wrap">
        <div
          class="bojax-curriculum__carousel"
          data-curriculum-carousel
          tabindex="0"
          aria-label="Course modules"
        >
          {% for block in section.blocks %}
            <article
              class="bojax-module-card{% if block.settings.featured %} bojax-module-card--featured{% endif %}"
              data-curriculum-slide
              {{ block.shopify_attributes }}
            >
              <div class="bojax-module-card__media">
                {% if block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 1200
                    | image_tag:
                      class: 'bojax-module-card__image',
                      loading: 'lazy',
                      widths: '360, 540, 750, 1000, 1200',
                      sizes: '(max-width: 749px) 86vw, (max-width: 989px) 48vw, 36vw',
                      alt: block.settings.image.alt
                  }}
                {% else %}
                  <div class="bojax-module-card__placeholder">
                    <span>
                      {{ forloop.index | prepend: '0' | slice: -2, 2 }}
                    </span>
                  </div>
                {% endif %}

                <div class="bojax-module-card__overlay"></div>

                {% if block.settings.badge != blank %}
                  <span class="bojax-module-card__badge">
                    {{ block.settings.badge }}
                  </span>
                {% endif %}

                <span class="bojax-module-card__module-number">
                  Module {{ forloop.index | prepend: '0' | slice: -2, 2 }}
                </span>
              </div>

              <div class="bojax-module-card__body">
                <div class="bojax-module-card__meta">
                  {% if block.settings.lesson_count != blank %}
                    <span class="bojax-module-card__lesson-count">
                      {{ block.settings.lesson_count }}
                    </span>
                  {% endif %}

                  {% if block.settings.featured %}
                    <span class="bojax-module-card__featured-label">
                      Featured
                    </span>
                  {% endif %}
                </div>

                {% if block.settings.title != blank %}
                  <h4 class="bojax-module-card__title">
                    {{ block.settings.title }}
                  </h4>
                {% endif %}

                {% if block.settings.description != blank %}
                  <div class="bojax-module-card__description">
                    {{ block.settings.description }}
                  </div>
                {% endif %}

                <div class="bojax-module-card__lessons">
                  {% if block.settings.point_1 != blank %}
                    <div class="bojax-module-card__lesson">
                      <span class="bojax-module-card__check">
                        <svg viewBox="0 0 20 20" aria-hidden="true">
                          <path
                            d="m5 10.5 3.1 3.1L15.5 6"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </span>

                      <span>{{ block.settings.point_1 }}</span>
                    </div>
                  {% endif %}

                  {% if block.settings.point_2 != blank %}
                    <div class="bojax-module-card__lesson">
                      <span class="bojax-module-card__check">
                        <svg viewBox="0 0 20 20" aria-hidden="true">
                          <path
                            d="m5 10.5 3.1 3.1L15.5 6"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </span>

                      <span>{{ block.settings.point_2 }}</span>
                    </div>
                  {% endif %}

                  {% if block.settings.point_3 != blank %}
                    <div class="bojax-module-card__lesson">
                      <span class="bojax-module-card__check">
                        <svg viewBox="0 0 20 20" aria-hidden="true">
                          <path
                            d="m5 10.5 3.1 3.1L15.5 6"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </span>

                      <span>{{ block.settings.point_3 }}</span>
                    </div>
                  {% endif %}

                  {% if block.settings.point_4 != blank %}
                    <div class="bojax-module-card__lesson">
                      <span class="bojax-module-card__check">
                        <svg viewBox="0 0 20 20" aria-hidden="true">
                          <path
                            d="m5 10.5 3.1 3.1L15.5 6"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </span>

                      <span>{{ block.settings.point_4 }}</span>
                    </div>
                  {% endif %}
                </div>
              </div>
            </article>
          {% endfor %}
        </div>

        {% if section.blocks.size > 1 %}
          <div class="bojax-curriculum__dots" data-curriculum-dots>
            {% for block in section.blocks %}
              <button
                type="button"
                class="bojax-curriculum__dot{% if forloop.first %} is-active{% endif %}"
                data-curriculum-dot="{{ forloop.index0 }}"
                aria-label="Go to course module {{ forloop.index }}"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              ></button>
            {% endfor %}
          </div>
        {% endif %}

        <p class="bojax-curriculum__swipe-hint">
          Swipe or use the arrows to explore every module
        </p>
      </div>
    {% endif %}

    {% if section.settings.footer_text != blank %}
      <p class="bojax-curriculum__footer-text">
        {{ section.settings.footer_text }}
      </p>
    {% endif %}

    {% if section.settings.button_text != blank %}
      <div class="bojax-curriculum__actions">
        <a
          class="bojax-curriculum__button"
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            href="/products/bojax-course"
          {% endif %}
        >
          <span>{{ section.settings.button_text }}</span>

          <svg
            aria-hidden="true"
            viewBox="0 0 20 20"
            width="20"
            height="20"
          >
            <path
              d="M4 10h11M11 5l5 5-5 5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .bojax-curriculum {
    --bojax-green: #78ff9a;
    --bojax-green-dark: #31c85c;
    --bojax-card-width: 38rem;

    position: relative;
    overflow: hidden;
    padding: 9rem 0;
    background:
      radial-gradient(
        circle at 10% 8%,
        rgba(77, 255, 124, 0.09),
        transparent 28rem
      ),
      radial-gradient(
        circle at 90% 25%,
        rgba(255, 255, 255, 0.055),
        transparent 32rem
      ),
      #030303;
    color: #fff;
  }

  .bojax-curriculum::before {
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(120, 255, 154, 0.45),
        transparent
      );
    content: "";
  }

  .bojax-curriculum__container {
    width: min(calc(100% - 4rem), 122rem);
    margin: 0 auto;
  }

  .bojax-curriculum__header {
    max-width: 84rem;
    margin: 0 auto;
    text-align: center;
  }

  .bojax-curriculum__eyebrow,
  .bojax-included__eyebrow,
  .bojax-curriculum__lessons-eyebrow {
    margin: 0 0 1.6rem;
    color: var(--bojax-green);
    font-size: 1.05rem;
    font-weight: 900;
    letter-spacing: 0.3em;
    line-height: 1;
    text-transform: uppercase;
  }

  .bojax-curriculum__heading {
    margin: 0;
    color: #fff;
    font-size: clamp(4.2rem, 7vw, 7.6rem);
    font-weight: 900;
    letter-spacing: -0.065em;
    line-height: 0.94;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .bojax-curriculum__description {
    max-width: 70rem;
    margin: 2.4rem auto 0;
    color: rgba(255, 255, 255, 0.66);
    font-size: clamp(1.55rem, 2vw, 1.9rem);
    line-height: 1.65;
  }

  .bojax-curriculum__description p {
    margin: 0;
  }

  .bojax-curriculum__summary {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 76rem;
    margin: 4rem auto 0;
    padding: 2.2rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.11);
    border-bottom: 1px solid rgba(255, 255, 255, 0.11);
  }

  .bojax-curriculum__summary-item {
    display: grid;
    padding: 0 2rem;
    gap: 0.7rem;
    text-align: center;
  }

  .bojax-curriculum__summary-item + .bojax-curriculum__summary-item {
    border-left: 1px solid rgba(255, 255, 255, 0.11);
  }

  .bojax-curriculum__summary-item strong {
    color: var(--bojax-green);
    font-size: clamp(2.8rem, 4vw, 4rem);
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .bojax-curriculum__summary-item span {
    color: rgba(255, 255, 255, 0.52);
    font-size: 1.15rem;
    line-height: 1.3;
  }

  .bojax-included {
    max-width: 104rem;
    margin: 6rem auto 0;
    padding: 3.5rem;
    border: 1px solid rgba(120, 255, 154, 0.18);
    border-radius: 2.6rem;
    background:
      linear-gradient(
        145deg,
        rgba(120, 255, 154, 0.065),
        rgba(255, 255, 255, 0.025)
      );
    box-shadow: 0 3rem 9rem rgba(0, 0, 0, 0.35);
  }

  .bojax-included__header {
    max-width: 70rem;
  }

  .bojax-included__heading {
    margin: 0;
    color: #fff;
    font-size: clamp(3rem, 5vw, 5rem);
    font-weight: 900;
    letter-spacing: -0.055em;
    line-height: 1;
    text-transform: uppercase;
  }

  .bojax-included__description {
    max-width: 68rem;
    margin: 1.5rem 0 0;
    color: rgba(255, 255, 255, 0.6);
    font-size: 1.5rem;
    line-height: 1.6;
  }

  .bojax-included__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 3rem;
    gap: 1.4rem 2.6rem;
  }

  .bojax-included__item {
    display: flex;
    min-width: 0;
    align-items: flex-start;
    gap: 1.2rem;
    color: rgba(255, 255, 255, 0.86);
    font-size: 1.45rem;
    font-weight: 650;
    line-height: 1.45;
  }

  .bojax-included__check,
  .bojax-module-card__check {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 50%;
    background:
      linear-gradient(
        145deg,
        var(--bojax-green),
        var(--bojax-green-dark)
      );
    color: #051107;
    box-shadow: 0 0 2.5rem rgba(120, 255, 154, 0.22);
  }

  .bojax-included__check {
    width: 2.4rem;
    height: 2.4rem;
    margin-top: 0.05rem;
  }

  .bojax-included__check svg {
    width: 1.35rem;
    height: 1.35rem;
  }

  .bojax-curriculum__lessons-header {
    display: flex;
    margin-top: 7rem;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .bojax-curriculum__lessons-heading {
    margin: 0;
    color: #fff;
    font-size: clamp(3.4rem, 6vw, 6rem);
    font-weight: 900;
    letter-spacing: -0.06em;
    line-height: 0.96;
    text-transform: uppercase;
  }

  .bojax-curriculum__controls {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .bojax-curriculum__control {
    display: grid;
    width: 5rem;
    height: 5rem;
    padding: 0;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.045);
    color: #fff;
    cursor: pointer;
    transition:
      border-color 180ms ease,
      background 180ms ease,
      transform 180ms ease;
  }

  .bojax-curriculum__control:hover {
    border-color: var(--bojax-green);
    background: rgba(120, 255, 154, 0.1);
    transform: translateY(-0.2rem);
  }

  .bojax-curriculum__control svg {
    width: 2.2rem;
    height: 2.2rem;
  }

  .bojax-curriculum__carousel-wrap {
    margin-top: 2.6rem;
  }

  .bojax-curriculum__carousel {
    display: flex;
    margin-inline: calc((100vw - min(calc(100vw - 4rem), 122rem)) / -2);
    padding:
      1rem
      max(
        2rem,
        calc((100vw - 122rem) / 2)
      )
      2.2rem;
    gap: 1.8rem;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scroll-padding-inline:
      max(
        2rem,
        calc((100vw - 122rem) / 2)
      );
    overscroll-behavior-inline: contain;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .bojax-curriculum__carousel::-webkit-scrollbar {
    display: none;
  }

  .bojax-module-card {
    flex: 0 0 var(--bojax-card-width);
    min-width: 0;
    overflow: hidden;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 2.4rem;
    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.075),
        rgba(255, 255, 255, 0.02)
      );
    box-shadow: 0 2.4rem 7rem rgba(0, 0, 0, 0.36);
    transition:
      border-color 180ms ease,
      transform 180ms ease;
  }

  .bojax-module-card:hover {
    border-color: rgba(120, 255, 154, 0.42);
    transform: translateY(-0.4rem);
  }

  .bojax-module-card--featured {
    border-color: rgba(120, 255, 154, 0.38);
    box-shadow:
      0 2.4rem 7rem rgba(0, 0, 0, 0.4),
      0 0 4rem rgba(120, 255, 154, 0.06);
  }

  .bojax-module-card__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background:
      linear-gradient(
        135deg,
        #1a241c,
        #070807
      );
  }

  .bojax-module-card__image,
  .bojax-module-card__placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }

  .bojax-module-card__image {
    object-fit: cover;
    transition:
      filter 300ms ease,
      transform 450ms ease;
  }

  .bojax-module-card:hover .bojax-module-card__image {
    filter: contrast(1.04) brightness(1.03);
    transform: scale(1.035);
  }

  .bojax-module-card__placeholder {
    display: grid;
    place-items: center;
    background:
      radial-gradient(
        circle at center,
        rgba(120, 255, 154, 0.14),
        transparent 55%
      );
  }

  .bojax-module-card__placeholder span {
    color: rgba(120, 255, 154, 0.18);
    font-size: 9rem;
    font-weight: 900;
    letter-spacing: -0.08em;
  }

  .bojax-module-card__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        transparent 38%,
        rgba(0, 0, 0, 0.78)
      );
    pointer-events: none;
  }

  .bojax-module-card__badge {
    position: absolute;
    top: 1.4rem;
    left: 1.4rem;
    z-index: 2;
    padding: 0.75rem 1.1rem;
    border: 1px solid rgba(120, 255, 154, 0.42);
    border-radius: 99rem;
    background: rgba(5, 15, 8, 0.72);
    color: var(--bojax-green);
    font-size: 0.95rem;
    font-weight: 900;
    letter-spacing: 0.13em;
    line-height: 1;
    text-transform: uppercase;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .bojax-module-card__module-number {
    position: absolute;
    right: 1.5rem;
    bottom: 1.4rem;
    z-index: 2;
    color: rgba(255, 255, 255, 0.72);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .bojax-module-card__body {
    padding: 2.4rem;
  }

  .bojax-module-card__meta {
    display: flex;
    min-height: 2.3rem;
    margin-bottom: 1.4rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .bojax-module-card__lesson-count,
  .bojax-module-card__featured-label {
    font-size: 1rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .bojax-module-card__lesson-count {
    color: rgba(255, 255, 255, 0.46);
  }

  .bojax-module-card__featured-label {
    color: var(--bojax-green);
  }

  .bojax-module-card__title {
    margin: 0;
    color: #fff;
    font-size: 2.45rem;
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 1.06;
    text-wrap: balance;
  }

  .bojax-module-card__description {
    margin-top: 1.2rem;
    color: rgba(255, 255, 255, 0.6);
    font-size: 1.4rem;
    line-height: 1.6;
  }

  .bojax-module-card__description p {
    margin: 0;
  }

  .bojax-module-card__lessons {
    display: grid;
    margin-top: 2rem;
    gap: 1.15rem;
  }

  .bojax-module-card__lesson {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    color: rgba(255, 255, 255, 0.84);
    font-size: 1.28rem;
    line-height: 1.45;
  }

  .bojax-module-card__check {
    width: 2rem;
    height: 2rem;
    margin-top: 0.05rem;
  }

  .bojax-module-card__check svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .bojax-curriculum__dots {
    display: flex;
    margin-top: 1.4rem;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .bojax-curriculum__dot {
    width: 0.8rem;
    height: 0.8rem;
    padding: 0;
    border: 0;
    border-radius: 99rem;
    background: rgba(255, 255, 255, 0.22);
    cursor: pointer;
    transition:
      background 180ms ease,
      transform 180ms ease,
      width 180ms ease;
  }

  .bojax-curriculum__dot.is-active {
    width: 2.8rem;
    background: var(--bojax-green);
  }

  .bojax-curriculum__swipe-hint {
