<section
  id="BojaxCurriculum-{{ section.id }}"
  class="bojax-curriculum"
  data-bojax-curriculum
>
  <div class="bojax-curriculum__glow" aria-hidden="true"></div>

  <div class="bojax-curriculum__container">
    <header class="bojax-curriculum__header">
      {% if section.settings.eyebrow != blank %}
        <p class="bojax-curriculum__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="bojax-curriculum__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="bojax-curriculum__description">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </header>

    <div
      class="bojax-curriculum__stats"
      data-bojax-stats
    >
      <div class="bojax-curriculum__stat">
        <strong
          class="bojax-curriculum__counter"
          data-counter-target="{{ section.settings.module_count }}"
          data-counter-suffix="{{ section.settings.module_suffix }}"
        >
          0{{ section.settings.module_suffix }}
        </strong>

        <span>{{ section.settings.module_label }}</span>

        {% if section.settings.module_note != blank %}
          <small>{{ section.settings.module_note }}</small>
        {% endif %}
      </div>

      <div class="bojax-curriculum__stat">
        <strong
          class="bojax-curriculum__counter"
          data-counter-target="{{ section.settings.lesson_count }}"
          data-counter-suffix="{{ section.settings.lesson_suffix }}"
        >
          0{{ section.settings.lesson_suffix }}
        </strong>

        <span>{{ section.settings.lesson_label }}</span>

        {% if section.settings.lesson_note != blank %}
          <small>{{ section.settings.lesson_note }}</small>
        {% endif %}
      </div>

      <div class="bojax-curriculum__stat">
        <strong>{{ section.settings.access_value }}</strong>
        <span>{{ section.settings.access_label }}</span>

        {% if section.settings.access_note != blank %}
          <small>{{ section.settings.access_note }}</small>
        {% endif %}
      </div>

      <div class="bojax-curriculum__stat">
        <strong>{{ section.settings.updates_value }}</strong>
        <span>{{ section.settings.updates_label }}</span>

        {% if section.settings.updates_note != blank %}
          <small>{{ section.settings.updates_note }}</small>
        {% endif %}
      </div>
    </div>

    <div class="bojax-curriculum__intro">
      <div class="bojax-curriculum__intro-copy">
        {% if section.settings.curriculum_eyebrow != blank %}
          <p class="bojax-curriculum__intro-eyebrow">
            {{ section.settings.curriculum_eyebrow }}
          </p>
        {% endif %}

        {% if section.settings.curriculum_heading != blank %}
          <h3 class="bojax-curriculum__intro-heading">
            {{ section.settings.curriculum_heading }}
          </h3>
        {% endif %}

        {% if section.settings.curriculum_description != blank %}
          <div class="bojax-curriculum__intro-description">
            {{ section.settings.curriculum_description }}
          </div>
        {% endif %}
      </div>

      <div class="bojax-curriculum__topic-total">
        <span>{{ section.blocks.size }}</span>
        <small>Detailed topics</small>
      </div>
    </div>

    {% if section.blocks.size > 0 %}
      <div class="bojax-curriculum__topics">
        {% for block in section.blocks %}
          <article
            class="bojax-topic-card{% if block.settings.featured %} bojax-topic-card--featured{% endif %}"
            {{ block.shopify_attributes }}
          >
            <div class="bojax-topic-card__header">
              <span class="bojax-topic-card__check" aria-hidden="true">
                <svg viewBox="0 0 20 20">
                  <path
                    d="M5 10.5 8.2 13.7 15.5 6.2"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>

              <div class="bojax-topic-card__heading">
                {% if block.settings.category != blank %}
                  <p class="bojax-topic-card__category">
                    {{ block.settings.category }}
                  </p>
                {% endif %}

                {% if block.settings.title != blank %}
                  <h4 class="bojax-topic-card__title">
                    {{ block.settings.title }}
                  </h4>
                {% endif %}
              </div>

              {% if block.settings.lesson_count != blank %}
                <span class="bojax-topic-card__lesson-count">
                  {{ block.settings.lesson_count }}
                </span>
              {% endif %}
            </div>

            {% if block.settings.description != blank %}
              <div class="bojax-topic-card__description">
                {{ block.settings.description }}
              </div>
            {% endif %}

            <div class="bojax-topic-card__lessons">
              {% if block.settings.point_1 != blank %}
                <div class="bojax-topic-card__lesson">
                  <span class="bojax-topic-card__small-check">
                    <svg viewBox="0 0 20 20" aria-hidden="true">
                      <path
                        d="M5 10.5 8.2 13.7 15.5 6.2"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>

                  <span>{{ block.settings.point_1 }}</span>
                </div>
              {% endif %}

              {% if block.settings.point_2 != blank %}
                <div class="bojax-topic-card__lesson">
                  <span class="bojax-topic-card__small-check">
                    <svg viewBox="0 0 20 20" aria-hidden="true">
                      <path
                        d="M5 10.5 8.2 13.7 15.5 6.2"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>

                  <span>{{ block.settings.point_2 }}</span>
                </div>
              {% endif %}

              {% if block.settings.point_3 != blank %}
                <div class="bojax-topic-card__lesson">
                  <span class="bojax-topic-card__small-check">
                    <svg viewBox="0 0 20 20" aria-hidden="true">
                      <path
                        d="M5 10.5 8.2 13.7 15.5 6.2"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>

                  <span>{{ block.settings.point_3 }}</span>
                </div>
              {% endif %}

              {% if block.settings.point_4 != blank %}
                <div class="bojax-topic-card__lesson">
                  <span class="bojax-topic-card__small-check">
                    <svg viewBox="0 0 20 20" aria-hidden="true">
                      <path
                        d="M5 10.5 8.2 13.7 15.5 6.2"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>

                  <span>{{ block.settings.point_4 }}</span>
                </div>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="bojax-curriculum__empty">
        <h3>Curriculum blocks need to be reloaded</h3>

        <p>
          Remove this section from the homepage and add
          “Bojax course curriculum” again to load every course topic.
        </p>
      </div>
    {% endif %}

    {% if section.settings.closing_heading != blank %}
      <div class="bojax-curriculum__closing">
        <p>{{ section.settings.closing_eyebrow }}</p>

        <h3>{{ section.settings.closing_heading }}</h3>

        {% if section.settings.closing_text != blank %}
          <div class="bojax-curriculum__closing-text">
            {{ section.settings.closing_text }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% if section.settings.disclaimer != blank %}
      <p class="bojax-curriculum__disclaimer">
        {{ section.settings.disclaimer }}
      </p>
    {% endif %}

    {% if section.settings.button_text != blank %}
      <div class="bojax-curriculum__actions">
        <a
          class="bojax-curriculum__button"
          href="{% if section.settings.button_link != blank %}{{ section.settings.button_link }}{% else %}/products/bojax-course{% endif %}"
        >
          <span>{{ section.settings.button_text }}</span>

          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path
              d="M4 10h11M11 5l5 5-5 5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .bojax-curriculum {
    --bojax-gold: #d8b86a;
    --bojax-gold-light: #f2dc9d;
    --bojax-gold-soft: rgba(216, 184, 106, 0.12);
    --bojax-green: #4ae276;

    position: relative;
    overflow: hidden;
    padding: 8.5rem 0;
    background:
      radial-gradient(
        circle at 50% 0,
        rgba(216, 184, 106, 0.12),
        transparent 33rem
      ),
      linear-gradient(
        180deg,
        #050505 0%,
        #0a0907 47%,
        #030303 100%
      );
    color: #ffffff;
  }

  .bojax-curriculum::before {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 1px;
    background:
      linear-gradient(
        90deg,
        transparent,
        var(--bojax-gold),
        #ffffff,
        var(--bojax-gold),
        transparent
      );
    content: "";
    opacity: 0.65;
  }

  .bojax-curriculum__glow {
    position: absolute;
    top: 32rem;
    right: -18rem;
    width: 44rem;
    height: 44rem;
    border-radius: 50%;
    background: rgba(216, 184, 106, 0.11);
    filter: blur(10rem);
    pointer-events: none;
  }

  .bojax-curriculum__container {
    position: relative;
    z-index: 1;
    width: min(calc(100% - 4rem), 122rem);
    margin: 0 auto;
  }

  .bojax-curriculum__header {
    max-width: 88rem;
    margin: 0 auto;
    text-align: center;
  }

  .bojax-curriculum__eyebrow,
  .bojax-curriculum__intro-eyebrow {
    margin: 0 0 1.7rem;
    color: var(--bojax-gold-light);
    font-size: 1rem;
    font-weight: 850;
    letter-spacing: 0.34em;
    line-height: 1;
    text-transform: uppercase;
  }

  .bojax-curriculum__heading {
    margin: 0;
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(4.5rem, 7vw, 8rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.94;
    text-wrap: balance;
  }

  .bojax-curriculum__description {
    max-width: 74rem;
    margin: 2.3rem auto 0;
    color: rgba(255, 255, 255, 0.64);
    font-size: clamp(1.5rem, 2vw, 1.9rem);
    line-height: 1.65;
  }

  .bojax-curriculum__description p,
  .bojax-curriculum__intro-description p,
  .bojax-topic-card__description p,
  .bojax-curriculum__closing-text p {
    margin: 0;
  }

  /* Statistics */

  .bojax-curriculum__stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 4.8rem;
    overflow: hidden;
    border: 1px solid rgba(216, 184, 106, 0.28);
    border-radius: 2.4rem;
    background:
      linear-gradient(
        145deg,
        rgba(216, 184, 106, 0.09),
        rgba(255, 255, 255, 0.025)
      );
    box-shadow:
      0 3rem 9rem rgba(0, 0, 0, 0.38),
      inset 0 1px rgba(255, 255, 255, 0.05);
  }

  .bojax-curriculum__stat {
    display: grid;
    min-width: 0;
    min-height: 16rem;
    padding: 2.5rem 1.2rem;
    place-content: center;
    gap: 0.9rem;
    text-align: center;
  }

  .bojax-curriculum__stat + .bojax-curriculum__stat {
    border-left: 1px solid rgba(216, 184, 106, 0.18);
  }

  .bojax-curriculum__stat strong {
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3.5rem, 5vw, 5.4rem);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 0.95;
  }

  .bojax-curriculum__stat span {
    color: var(--bojax-gold-light);
    font-size: 0.95rem;
    font-weight: 850;
    letter-spacing: 0.17em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .bojax-curriculum__stat small {
    color: rgba(255, 255, 255, 0.4);
    font-size: 1rem;
    line-height: 1.4;
  }

  /* Curriculum heading */

  .bojax-curriculum__intro {
    display: flex;
    margin-top: 7rem;
    padding-bottom: 3rem;
    align-items: flex-end;
    justify-content: space-between;
    gap: 3rem;
    border-bottom: 1px solid rgba(216, 184, 106, 0.23);
  }

  .bojax-curriculum__intro-copy {
    max-width: 80rem;
  }

  .bojax-curriculum__intro-heading {
    margin: 0;
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3.8rem, 6vw, 6.5rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .bojax-curriculum__intro-description {
    max-width: 72rem;
    margin-top: 1.6rem;
    color: rgba(255, 255, 255, 0.59);
    font-size: 1.48rem;
    line-height: 1.65;
  }

  .bojax-curriculum__topic-total {
    display: grid;
    flex: 0 0 auto;
    min-width: 18rem;
    padding: 1.8rem;
    gap: 0.5rem;
    border: 1px solid rgba(216, 184, 106, 0.27);
    border-radius: 1.7rem;
    background: var(--bojax-gold-soft);
    text-align: center;
  }

  .bojax-curriculum__topic-total span {
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 3.2rem;
    font-weight: 700;
    line-height: 1;
  }

  .bojax-curriculum__topic-total small {
    color: var(--bojax-gold-light);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  /* Topics */

  .bojax-curriculum__topics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 2.2rem;
    gap: 1.4rem;
  }

  .bojax-topic-card {
    position: relative;
    min-width: 0;
    padding: 2.4rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 2rem;
    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.055),
        rgba(255, 255, 255, 0.015)
      );
    box-shadow: 0 2rem 6rem rgba(0, 0, 0, 0.22);
  }

  .bojax-topic-card--featured {
    border-color: rgba(216, 184, 106, 0.42);
    background:
      linear-gradient(
        145deg,
        rgba(216, 184, 106, 0.1),
        rgba(255, 255, 255, 0.018)
      );
  }

  .bojax-topic-card__header {
    display: flex;
    align-items: flex-start;
    gap: 1.3rem;
  }

  /* Green is only used for checks */

  .bojax-topic-card__check {
    display: grid;
    flex: 0 0 3rem;
    width: 3rem;
    height: 3rem;
    margin-top: 0.1rem;
    place-items: center;
    border-radius: 50%;
    background: var(--bojax-green);
    color: #031008;
    box-shadow: 0 0 2.2rem rgba(74, 226, 118, 0.18);
  }

  .bojax-topic-card__check svg {
    width: 1.7rem;
    height: 1.7rem;
  }

  .bojax-topic-card__heading {
    flex: 1 1 auto;
    min-width: 0;
  }

  .bojax-topic-card__category {
    margin: 0 0 0.6rem;
    color: var(--bojax-gold-light);
    font-size: 0.86rem;
    font-weight: 850;
    letter-spacing: 0.18em;
    line-height: 1;
    text-transform: uppercase;
  }

  .bojax-topic-card__title {
    margin: 0;
    color: #ffffff;
    font-size: 1.72rem;
    font-weight: 850;
    letter-spacing: -0.025em;
    line-height: 1.25;
  }

  .bojax-topic-card__lesson-count {
    flex: 0 0 auto;
    padding: 0.65rem 0.85rem;
    border: 1px solid rgba(216, 184, 106, 0.25);
    border-radius: 99rem;
    background: rgba(216, 184, 106, 0.07);
    color: var(--bojax-gold-light);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    white-space: nowrap;
    text-transform: uppercase;
  }

  .bojax-topic-card__description {
    margin: 1.4rem 0 0 4.3rem;
    color: rgba(255, 255, 255, 0.51);
    font-size: 1.27rem;
    line-height: 1.6;
  }

  .bojax-topic-card__lessons {
    display: grid;
    margin: 1.7rem 0 0 4.3rem;
    gap: 1rem;
  }

  .bojax-topic-card__lesson {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    color: rgba(255, 255, 255, 0.79);
    font-size: 1.17rem;
    line-height: 1.45;
  }

  .bojax-topic-card__small-check {
    display: grid;
    flex: 0 0 1.8rem;
    width: 1.8rem;
    height: 1.8rem;
    margin-top: 0.05rem;
    place-items: center;
    color: var(--bojax-green);
  }

  .bojax-topic-card__small-check svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  .bojax-curriculum__empty {
    margin-top: 2.5rem;
    padding: 3rem;
    border: 1px solid rgba(216, 184, 106, 0.35);
    border-radius: 2rem;
    background: var(--bojax-gold-soft);
    text-align: center;
  }

  .bojax-curriculum__empty h3 {
    margin: 0;
    color: #ffffff;
    font-size: 2.2rem;
  }

  .bojax-curriculum__empty p {
    max-width: 60rem;
    margin: 1rem auto 0;
    color: rgba(255, 255, 255, 0.62);
    font-size: 1.35rem;
    line-height: 1.6;
  }

  /* Closing */

  .bojax-curriculum__closing {
    margin-top: 4rem;
    padding: 3.2rem;
    border: 1px solid rgba(216, 184, 106, 0.3);
    border-radius: 2.3rem;
    background:
      linear-gradient(
        135deg,
        rgba(216, 184, 106, 0.12),
        rgba(255, 255, 255, 0.02)
      );
    text-align: center;
  }

  .bojax-curriculum__closing > p {
    margin: 0 0 1.1rem;
    color: var(--bojax-gold-light);
    font-size: 0.95rem;
    font-weight: 850;
    letter-spacing: 0.23em;
    text-transform: uppercase;
  }

  .bojax-curriculum__closing h3 {
    margin: 0;
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3rem, 5vw, 5rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .bojax-curriculum__closing-text {
    max-width: 72rem;
    margin: 1.6rem auto 0;
    color: rgba(255, 255, 255, 0.6);
    font-size: 1.4rem;
    line-height: 1.65;
  }

  .bojax-curriculum__disclaimer {
    max-width: 84rem;
    margin: 2.7rem auto 0;
    color: rgba(255, 255, 255, 0.34);
    font-size: 1.05rem;
    line-height: 1.6;
    text-align: center;
  }

  .bojax-curriculum__actions {
    display: flex;
    margin-top: 3rem;
    justify-content: center;
  }

  .bojax-curriculum__button {
    display: inline-flex;
    width: min(100%, 46rem);
    min-height: 6.3rem;
    padding: 1.5rem 3rem;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    border: 1px solid var(--bojax-gold-light);
    border-radius: 1.5rem;
    background:
      linear-gradient(
        135deg,
        #f8edd0,
        #ffffff
      );
    color: #090806;
    font-size: 1.48rem;
    font-weight: 900;
    line-height: 1;
    text-decoration: none;
    box-shadow:
      0 2rem 5rem rgba(0, 0, 0, 0.35),
      0 0 3.5rem rgba(216, 184, 106, 0.13);
  }

  .bojax-curriculum__button svg {
    width: 2rem;
    height: 2rem;
  }

  @media screen and (max-width: 989px) {
    .bojax-curriculum__stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .bojax-curriculum__stat:nth-child(3) {
      border-top: 1px solid rgba(216, 184, 106, 0.18);
      border-left: 0;
    }

    .bojax-curriculum__stat:nth-child(4) {
      border-top: 1px solid rgba(216, 184, 106, 0.18);
    }
  }

  @media screen and (max-width: 749px) {
    .bojax-curriculum {
      padding: 6.2rem 0;
    }

    .bojax-curriculum__container {
      width: calc(100% - 2.8rem);
    }

    .bojax-curriculum__eyebrow,
    .bojax-curriculum__intro-eyebrow {
      font-size: 0.88rem;
      letter-spacing: 0.25em;
    }

    .bojax-curriculum__heading {
      font-size: clamp(4.1rem, 13vw, 5.7rem);
    }

    .bojax-curriculum__description {
      margin-top: 1.9rem;
      font-size: 1.42rem;
    }

    .bojax-curriculum__stats {
      margin-top: 3.7rem;
      border-radius: 2rem;
    }

    .bojax-curriculum__stat {
      min-height: 12.2rem;
      padding: 1.7rem 0.6rem;
    }

    .bojax-curriculum__stat strong {
      font-size: clamp(3rem, 10vw, 4rem);
    }

    .bojax-curriculum__stat span {
      font-size: 0.75rem;
      letter-spacing: 0.12em;
    }

    .bojax-curriculum__stat small {
      padding: 0 0.5rem;
      font-size: 0.86rem;
    }

    .bojax-curriculum__intro {
      display: grid;
      margin-top: 5.3rem;
      padding-bottom: 2.4rem;
      gap: 2rem;
    }

    .bojax-curriculum__intro-heading {
      font-size: 4rem;
    }

    .bojax-curriculum__intro-description {
      font-size: 1.34rem;
    }

    .bojax-curriculum__topic-total {
      width: 100%;
      min-width: 0;
    }

    .bojax-curriculum__topics {
      grid-template-columns: 1fr;
      margin-top: 1.6rem;
      gap: 1.1rem;
    }

    .bojax-topic-card {
      padding: 1.7rem 1.4rem;
      border-radius: 1.7rem;
    }

    .bojax-topic-card__header {
      gap: 1rem;
    }

    .bojax-topic-card__check {
      flex-basis: 2.7rem;
