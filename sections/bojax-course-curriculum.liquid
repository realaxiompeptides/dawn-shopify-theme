<section
  id="BojaxCurriculum-{{ section.id }}"
  class="bojax-curriculum"
  data-bojax-curriculum
  style="
    --bojax-accent: {{ section.settings.accent_color }};
    --bojax-accent-soft: {{ section.settings.accent_color | color_modify: 'alpha', 0.16 }};
    --bojax-check: {{ section.settings.check_color }};
  "
>
  <div class="bojax-curriculum__background" aria-hidden="true">
    <span class="bojax-curriculum__orb bojax-curriculum__orb--one"></span>
    <span class="bojax-curriculum__orb bojax-curriculum__orb--two"></span>
    <span class="bojax-curriculum__grid-lines"></span>
  </div>

  <div class="bojax-curriculum__container">
    <header class="bojax-curriculum__header">
      {% if section.settings.eyebrow != blank %}
        <p class="bojax-curriculum__eyebrow">
          <span></span>
          {{ section.settings.eyebrow }}
          <span></span>
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="bojax-curriculum__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="bojax-curriculum__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

      {% if section.settings.header_badge != blank %}
        <div class="bojax-curriculum__header-badge">
          <span class="bojax-curriculum__header-badge-icon">
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path
                d="M5 10.5 8.2 13.7 15.5 6.2"
                fill="none"
                stroke="currentColor"
                stroke-width="2.3"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>

          <span>{{ section.settings.header_badge }}</span>
        </div>
      {% endif %}
    </header>

    {% if section.settings.show_stats %}
      <div class="bojax-curriculum__stats" data-curriculum-stats>
        <div class="bojax-curriculum__stat">
          <div class="bojax-curriculum__stat-top">
            <strong
              class="bojax-curriculum__counter"
              data-count="{{ section.settings.module_count }}"
              data-suffix="{{ section.settings.module_suffix }}"
            >
              0{{ section.settings.module_suffix }}
            </strong>
          </div>

          <span>{{ section.settings.module_label }}</span>

          {% if section.settings.module_note != blank %}
            <small>{{ section.settings.module_note }}</small>
          {% endif %}
        </div>

        <div class="bojax-curriculum__stat">
          <div class="bojax-curriculum__stat-top">
            <strong
              class="bojax-curriculum__counter"
              data-count="{{ section.settings.lesson_count }}"
              data-suffix="{{ section.settings.lesson_suffix }}"
            >
              0{{ section.settings.lesson_suffix }}
            </strong>
          </div>

          <span>{{ section.settings.lesson_label }}</span>

          {% if section.settings.lesson_note != blank %}
            <small>{{ section.settings.lesson_note }}</small>
          {% endif %}
        </div>

        <div class="bojax-curriculum__stat">
          <div class="bojax-curriculum__stat-top">
            <strong>{{ section.settings.access_value }}</strong>
          </div>

          <span>{{ section.settings.access_label }}</span>

          {% if section.settings.access_note != blank %}
            <small>{{ section.settings.access_note }}</small>
          {% endif %}
        </div>

        <div class="bojax-curriculum__stat">
          <div class="bojax-curriculum__stat-top">
            <strong>{{ section.settings.updates_value }}</strong>
          </div>

          <span>{{ section.settings.updates_label }}</span>

          {% if section.settings.updates_note != blank %}
            <small>{{ section.settings.updates_note }}</small>
          {% endif %}
        </div>
      </div>
    {% endif %}

    <div class="bojax-curriculum__overview">
      <div class="bojax-curriculum__overview-copy">
        {% if section.settings.included_eyebrow != blank %}
          <p class="bojax-curriculum__overview-eyebrow">
            {{ section.settings.included_eyebrow }}
          </p>
        {% endif %}

        {% if section.settings.included_heading != blank %}
          <h3 class="bojax-curriculum__overview-heading">
            {{ section.settings.included_heading }}
          </h3>
        {% endif %}

        {% if section.settings.included_description != blank %}
          <div class="bojax-curriculum__overview-description">
            {{ section.settings.included_description }}
          </div>
        {% endif %}
      </div>

      <div class="bojax-curriculum__overview-total">
        <span class="bojax-curriculum__overview-total-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M7 3h10a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
            />
            <path
              d="M9 8h6M9 12h6M9 16h4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
            />
          </svg>
        </span>

        <div>
          <strong>{{ section.blocks.size }}</strong>
          <span>Topics shown below</span>
        </div>
      </div>
    </div>

    {% if section.blocks.size > 0 %}
      <div class="bojax-curriculum__topics">
        {% for block in section.blocks %}
          <article
            class="bojax-topic{% if block.settings.featured %} bojax-topic--featured{% endif %}"
            {{ block.shopify_attributes }}
          >
            <div class="bojax-topic__top">
              <span class="bojax-topic__check" aria-hidden="true">
                <svg viewBox="0 0 20 20">
                  <path
                    d="M5 10.5 8.2 13.7 15.5 6.2"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>

              <div class="bojax-topic__heading-wrap">
                {% if block.settings.category != blank %}
                  <span class="bojax-topic__category">
                    {{ block.settings.category }}
                  </span>
                {% endif %}

                {% if block.settings.title != blank %}
                  <h4 class="bojax-topic__title">
                    {{ block.settings.title }}
                  </h4>
                {% endif %}
              </div>

              {% if block.settings.lesson_count != blank %}
                <span class="bojax-topic__lesson-count">
                  {{ block.settings.lesson_count }}
                </span>
              {% endif %}
            </div>

            {% if block.settings.description != blank %}
              <div class="bojax-topic__description">
                {{ block.settings.description }}
              </div>
            {% endif %}

            {% if block.settings.point_1 != blank
              or block.settings.point_2 != blank
              or block.settings.point_3 != blank
              or block.settings.point_4 != blank
            %}
              <div class="bojax-topic__details">
                {% if block.settings.point_1 != blank %}
                  <div class="bojax-topic__detail">
                    <span>
                      <svg viewBox="0 0 20 20" aria-hidden="true">
                        <path
                          d="M5 10.5 8.2 13.7 15.5 6.2"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </span>
                    {{ block.settings.point_1 }}
                  </div>
                {% endif %}

                {% if block.settings.point_2 != blank %}
                  <div class="bojax-topic__detail">
                    <span>
                      <svg viewBox="0 0 20 20" aria-hidden="true">
                        <path
                          d="M5 10.5 8.2 13.7 15.5 6.2"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </span>
                    {{ block.settings.point_2 }}
                  </div>
                {% endif %}

                {% if block.settings.point_3 != blank %}
                  <div class="bojax-topic__detail">
                    <span>
                      <svg viewBox="0 0 20 20" aria-hidden="true">
                        <path
                          d="M5 10.5 8.2 13.7 15.5 6.2"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </span>
                    {{ block.settings.point_3 }}
                  </div>
                {% endif %}

                {% if block.settings.point_4 != blank %}
                  <div class="bojax-topic__detail">
                    <span>
                      <svg viewBox="0 0 20 20" aria-hidden="true">
                        <path
                          d="M5 10.5 8.2 13.7 15.5 6.2"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </span>
                    {{ block.settings.point_4 }}
                  </div>
                {% endif %}
              </div>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    {% endif %}

    <div class="bojax-curriculum__purchase-includes">
      {% if section.settings.feature_heading != blank %}
        <div class="bojax-curriculum__purchase-heading">
          <p>{{ section.settings.feature_eyebrow }}</p>
          <h3>{{ section.settings.feature_heading }}</h3>
        </div>
      {% endif %}

      <div class="bojax-curriculum__purchase-grid">
        {% for i in (1..6) %}
          {% assign feature_key = 'feature_' | append: i %}
          {% assign feature_text = section.settings[feature_key] %}

          {% if feature_text != blank %}
            <div class="bojax-curriculum__purchase-item">
              <span class="bojax-curriculum__purchase-check">
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path
                    d="M5 10.5 8.2 13.7 15.5 6.2"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.25"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>

              <span>{{ feature_text }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    {% if section.settings.disclaimer != blank %}
      <p class="bojax-curriculum__disclaimer">
        {{ section.settings.disclaimer }}
      </p>
    {% endif %}

    {% if section.settings.button_text != blank %}
      <div class="bojax-curriculum__actions">
        <a
          class="bojax-curriculum__button"
          href="{% if section.settings.button_link != blank %}{{ section.settings.button_link }}{% else %}/products/bojax-course{% endif %}"
        >
          <span>{{ section.settings.button_text }}</span>

          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path
              d="M4 10h11M11 5l5 5-5 5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .bojax-curriculum {
    position: relative;
    overflow: hidden;
    padding: 9rem 0;
    background:
      linear-gradient(
        180deg,
        #020205 0%,
        #070711 36%,
        #030304 100%
      );
    color: #fff;
  }

  .bojax-curriculum__background {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .bojax-curriculum__orb {
    position: absolute;
    display: block;
    border-radius: 50%;
    filter: blur(8rem);
    opacity: 0.24;
  }

  .bojax-curriculum__orb--one {
    top: 2rem;
    left: -12rem;
    width: 38rem;
    height: 38rem;
    background: var(--bojax-accent);
  }

  .bojax-curriculum__orb--two {
    top: 42rem;
    right: -16rem;
    width: 42rem;
    height: 42rem;
    background: #7a4cff;
    opacity: 0.16;
  }

  .bojax-curriculum__grid-lines {
    position: absolute;
    inset: 0;
    opacity: 0.12;
    background-image:
      linear-gradient(
        rgba(255, 255, 255, 0.09) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.09) 1px,
        transparent 1px
      );
    background-size: 7rem 7rem;
    mask-image:
      linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.8),
        transparent 70%
      );
    -webkit-mask-image:
      linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.8),
        transparent 70%
      );
  }

  .bojax-curriculum::before {
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background:
      linear-gradient(
        90deg,
        transparent,
        var(--bojax-accent),
        rgba(255, 255, 255, 0.65),
        transparent
      );
    opacity: 0.75;
    content: "";
  }

  .bojax-curriculum__container {
    position: relative;
    z-index: 2;
    width: min(calc(100% - 4rem), 122rem);
    margin: 0 auto;
  }

  .bojax-curriculum__header {
    max-width: 90rem;
    margin: 0 auto;
    text-align: center;
  }

  .bojax-curriculum__eyebrow {
    display: flex;
    margin: 0 0 2rem;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    color: rgba(255, 255, 255, 0.68);
    font-size: 1.05rem;
    font-weight: 850;
    letter-spacing: 0.34em;
    line-height: 1;
    text-transform: uppercase;
  }

  .bojax-curriculum__eyebrow span {
    width: 4.2rem;
    height: 1px;
    background:
      linear-gradient(
        90deg,
        transparent,
        var(--bojax-accent)
      );
  }

  .bojax-curriculum__eyebrow span:last-child {
    background:
      linear-gradient(
        90deg,
        var(--bojax-accent),
        transparent
      );
  }

  .bojax-curriculum__heading {
    margin: 0;
    color: #fff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(4.5rem, 7.5vw, 8.4rem);
    font-weight: 500;
    letter-spacing: -0.062em;
    line-height: 0.92;
    text-wrap: balance;
    text-shadow: 0 0 5rem rgba(255, 255, 255, 0.07);
  }

  .bojax-curriculum__description {
    max-width: 75rem;
    margin: 2.5rem auto 0;
    color: rgba(255, 255, 255, 0.68);
    font-size: clamp(1.55rem, 2vw, 1.95rem);
    line-height: 1.65;
  }

  .bojax-curriculum__description p,
  .bojax-curriculum__overview-description p,
  .bojax-topic__description p {
    margin: 0;
  }

  .bojax-curriculum__header-badge {
    display: inline-flex;
    margin-top: 2.8rem;
    padding: 1rem 1.5rem;
    align-items: center;
    gap: 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 99rem;
    background: rgba(255, 255, 255, 0.055);
    color: rgba(255, 255, 255, 0.82);
    font-size: 1.15rem;
    font-weight: 700;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .bojax-curriculum__header-badge-icon {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 50%;
    background: var(--bojax-check);
    color: #031108;
  }

  .bojax-curriculum__header-badge-icon svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  /* Animated statistics */

  .bojax-curriculum__stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 5rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 2.4rem;
    background:
      linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.075),
        rgba(255, 255, 255, 0.018)
      );
    box-shadow:
      0 3rem 9rem rgba(0, 0, 0, 0.38),
      inset 0 1px rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .bojax-curriculum__stat {
    position: relative;
    display: grid;
    min-width: 0;
    min-height: 17rem;
    padding: 2.6rem 1.5rem;
    place-content: center;
    gap: 0.9rem;
    text-align: center;
  }

  .bojax-curriculum__stat + .bojax-curriculum__stat {
    border-left: 1px solid rgba(255, 255, 255, 0.1);
  }

  .bojax-curriculum__stat::before {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at 50% 0,
        var(--bojax-accent-soft),
        transparent 65%
      );
    opacity: 0;
    transition: opacity 300ms ease;
    content: "";
  }

  .bojax-curriculum__stat:hover::before {
    opacity: 1;
  }

  .bojax-curriculum__stat-top {
    position: relative;
    min-height: 5rem;
  }

  .bojax-curriculum__stat strong {
    position: relative;
    color: #fff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3.5rem, 5vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 0.95;
  }

  .bojax-curriculum__stat span {
    position: relative;
    color: rgba(255, 255, 255, 0.74);
    font-size: 1rem;
    font-weight: 850;
    letter-spacing: 0.18em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .bojax-curriculum__stat small {
    position: relative;
    color: rgba(255, 255, 255, 0.4);
    font-size: 1.05rem;
    line-height: 1.4;
  }

  /* Curriculum intro */

  .bojax-curriculum__overview {
    display: flex;
    margin-top: 7rem;
    padding-bottom: 3rem;
    align-items: flex-end;
    justify-content: space-between;
    gap: 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .bojax-curriculum__overview-copy {
    max-width: 80rem;
  }

  .bojax-curriculum__overview-eyebrow {
    margin: 0 0 1.5rem;
    color: var(--bojax-accent);
    font-size: 1.05rem;
    font-weight: 850;
    letter-spacing: 0.31em;
    text-transform: uppercase;
  }

  .bojax-curriculum__overview-heading {
    margin: 0;
    color: #fff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3.8rem, 6vw, 6.5rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .bojax-curriculum__overview-description {
    max-width: 72rem;
    margin-top: 1.8rem;
    color: rgba(255, 255, 255, 0.6);
    font-size: 1.5rem;
    line-height: 1.65;
  }

  .bojax-curriculum__overview-total {
    display: flex;
    flex: 0 0 auto;
    min-width: 20rem;
    padding: 1.8rem;
    align-items: center;
    gap: 1.4rem;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 1.7rem;
    background: rgba(255, 255, 255, 0.045);
  }

  .bojax-curriculum__overview-total-icon {
    display: grid;
    flex: 0 0 4.5rem;
    width: 4.5rem;
    height: 4.5rem;
    place-items: center;
    border-radius: 1.2rem;
    background: var(--bojax-accent-soft);
    color: var(--bojax-accent);
  }

  .bojax-curriculum__overview-total-icon svg {
    width: 2.4rem;
    height: 2.4rem;
  }

  .bojax-curriculum__overview-total div {
    display: grid;
    gap: 0.3rem;
  }

  .bojax-curriculum__overview-total strong {
    color: #fff;
    font-size: 2.5rem;
    font-weight: 900;
    line-height: 1;
  }

  .bojax-curriculum__overview-total span {
    color: rgba(255, 255, 255, 0.46);
    font-size: 1rem;
    font-weight: 750;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  /* Topic cards */

  .bojax-curriculum__topics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 2.5rem;
    gap: 1.5rem;
  }

  .bojax-topic {
    position: relative;
    min-width: 0;
    padding: 2.4rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 2rem;
    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.06),
        rgba(255, 255, 255, 0.015)
      );
    transition:
      border-color 200ms ease,
      background 200ms ease,
      transform 200ms ease;
  }

  .bojax-topic::after {
    position: absolute;
    top: -8rem;
    right: -8rem;
    width: 18rem;
    height: 18rem;
    border-radius: 50%;
    background: var(--bojax-accent);
    filter: blur(7rem);
    opacity: 0;
    transition: opacity 250ms ease;
    content: "";
  }

  .bojax-topic:hover {
    border-color: rgba(255, 255, 255, 0.24);
    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.085),
        rgba(255, 255, 255, 0.02)
      );
    transform: translateY(-0.3rem);
  }

  .bojax-topic:hover::after {
    opacity: 0.13;
  }

  .bojax-topic--featured {
    border-color: color-mix(
      in srgb,
      var(--bojax-accent) 42%,
      transparent
    );
  }

  .bojax-topic__top {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-start;
    gap: 1.3rem;
  }

  .bojax-topic__check {
    display: grid;
    flex: 0 0 3rem;
    width: 3rem;
    height: 3rem;
    margin-top: 0.1rem;
    place-items: center;
    border-radius: 50%;
    background: var(--bojax-check);
    color: #031108;
    box-shadow: 0 0 2.4rem rgba(76, 235, 121, 0.2);
  }

  .bojax-topic__check svg {
    width: 1.7rem;
    height: 1.7rem;
  }

  .bojax-topic__heading-wrap {
    flex: 1 1 auto;
    min-width: 0;
  }

  .bojax-topic__category {
    display: block;
    margin-bottom: 0.65rem;
    color: var(--bojax-accent);
    font-size: 0.9rem;
    font-weight: 850;
    letter-spacing: 0.17em;
    line-height: 1;
    text-transform: uppercase;
  }

  .bojax-topic__title {
    margin: 0;
    color: rgba(255, 255, 255, 0.96);
    font-size: 1.75rem;
    font-weight: 850;
    letter-spacing: -0.025em;
    line-height: 1.25;
  }

  .bojax-topic__lesson-count {
    flex: 0 0 auto;
    padding: 0.65rem 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 99rem;
    background: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.48);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    white-space: nowrap;
    text-transform: uppercase;
