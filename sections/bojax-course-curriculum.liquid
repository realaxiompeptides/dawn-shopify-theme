        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Highlight this module",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bojax course curriculum",
      "blocks": [
        {
          "type": "module",
          "settings": {
            "badge": "Core module",
            "lesson_count": "5 lessons",
