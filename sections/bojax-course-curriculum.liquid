<section
  id="BojaxCurriculum-{{ section.id }}"
  class="bojax-curriculum"
>
  <div class="bojax-curriculum__container">
    <header class="bojax-curriculum__header">
      {% if section.settings.eyebrow != blank %}
        <p class="bojax-curriculum__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="bojax-curriculum__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="bojax-curriculum__description">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </header>

    {% if section.settings.show_stats %}
      <div class="bojax-curriculum__stats">
        <div class="bojax-curriculum__stat">
          <strong>{{ section.settings.module_count }}</strong>
          <span>{{ section.settings.module_label }}</span>
        </div>

        <div class="bojax-curriculum__stat">
          <strong>{{ section.settings.lesson_count }}</strong>
          <span>{{ section.settings.lesson_label }}</span>
        </div>

        <div class="bojax-curriculum__stat">
          <strong>{{ section.settings.access_value }}</strong>
          <span>{{ section.settings.access_label }}</span>
        </div>

        <div class="bojax-curriculum__stat">
          <strong>{{ section.settings.updates_value }}</strong>
          <span>{{ section.settings.updates_label }}</span>
        </div>
      </div>
    {% endif %}

    <div class="bojax-curriculum__included">
      <div class="bojax-curriculum__included-header">
        {% if section.settings.included_eyebrow != blank %}
          <p class="bojax-curriculum__included-eyebrow">
            {{ section.settings.included_eyebrow }}
          </p>
        {% endif %}

        {% if section.settings.included_heading != blank %}
          <h3 class="bojax-curriculum__included-heading">
            {{ section.settings.included_heading }}
          </h3>
        {% endif %}

        {% if section.settings.included_description != blank %}
          <div class="bojax-curriculum__included-description">
            {{ section.settings.included_description }}
          </div>
        {% endif %}
      </div>

      {% if section.blocks.size > 0 %}
        <div class="bojax-curriculum__list">
          {% for block in section.blocks %}
            <article
              class="bojax-curriculum__item"
              {{ block.shopify_attributes }}
            >
              <span class="bojax-curriculum__check" aria-hidden="true">
                <svg viewBox="0 0 20 20">
                  <path
                    d="M5 10.5 8.2 13.7 15.5 6.2"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.25"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>

              <div class="bojax-curriculum__item-content">
                {% if block.settings.title != blank %}
                  <h4 class="bojax-curriculum__item-title">
                    {{ block.settings.title }}
                  </h4>
                {% endif %}

                {% if block.settings.description != blank %}
                  <div class="bojax-curriculum__item-description">
                    {{ block.settings.description }}
                  </div>
                {% endif %}
              </div>
            </article>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    {% if section.settings.feature_heading != blank %}
      <div class="bojax-curriculum__features">
        <h3 class="bojax-curriculum__feature-heading">
          {{ section.settings.feature_heading }}
        </h3>

        <div class="bojax-curriculum__feature-grid">
          {% if section.settings.feature_1 != blank %}
            <div class="bojax-curriculum__feature">
              <span class="bojax-curriculum__check bojax-curriculum__check--small">
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path
                    d="M5 10.5 8.2 13.7 15.5 6.2"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.25"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>

              <span>{{ section.settings.feature_1 }}</span>
            </div>
          {% endif %}

          {% if section.settings.feature_2 != blank %}
            <div class="bojax-curriculum__feature">
              <span class="bojax-curriculum__check bojax-curriculum__check--small">
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path
                    d="M5 10.5 8.2 13.7 15.5 6.2"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.25"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>

              <span>{{ section.settings.feature_2 }}</span>
            </div>
          {% endif %}

          {% if section.settings.feature_3 != blank %}
            <div class="bojax-curriculum__feature">
              <span class="bojax-curriculum__check bojax-curriculum__check--small">
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path
                    d="M5 10.5 8.2 13.7 15.5 6.2"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.25"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>

              <span>{{ section.settings.feature_3 }}</span>
            </div>
          {% endif %}

          {% if section.settings.feature_4 != blank %}
            <div class="bojax-curriculum__feature">
              <span class="bojax-curriculum__check bojax-curriculum__check--small">
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path
                    d="M5 10.5 8.2 13.7 15.5 6.2"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.25"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>

              <span>{{ section.settings.feature_4 }}</span>
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}

    {% if section.settings.disclaimer != blank %}
      <p class="bojax-curriculum__disclaimer">
        {{ section.settings.disclaimer }}
      </p>
    {% endif %}

    {% if section.settings.button_text != blank %}
      <div class="bojax-curriculum__actions">
        <a
          class="bojax-curriculum__button"
          href="{% if section.settings.button_link != blank %}{{ section.settings.button_link }}{% else %}/products/bojax-course{% endif %}"
        >
          <span>{{ section.settings.button_text }}</span>

          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path
              d="M4 10h11M11 5l5 5-5 5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .bojax-curriculum {
    --bojax-check-green: #49d871;

    position: relative;
    overflow: hidden;
    padding: 8.5rem 0;
    background:
      radial-gradient(
        circle at 50% 0,
        rgba(255, 255, 255, 0.045),
        transparent 34rem
      ),
      #030303;
    color: #ffffff;
  }

  .bojax-curriculum::before {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 1px;
    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.17),
        transparent
      );
    content: "";
  }

  .bojax-curriculum__container {
    width: min(calc(100% - 4rem), 118rem);
    margin: 0 auto;
  }

  .bojax-curriculum__header {
    max-width: 82rem;
    margin: 0 auto;
    text-align: center;
  }

  .bojax-curriculum__eyebrow,
  .bojax-curriculum__included-eyebrow {
    margin: 0 0 1.6rem;
    color: rgba(255, 255, 255, 0.53);
    font-size: 1.05rem;
    font-weight: 850;
    letter-spacing: 0.31em;
    line-height: 1;
    text-transform: uppercase;
  }

  .bojax-curriculum__heading {
    margin: 0;
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(4.2rem, 7vw, 7rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .bojax-curriculum__description {
    max-width: 70rem;
    margin: 2.2rem auto 0;
    color: rgba(255, 255, 255, 0.63);
    font-size: clamp(1.5rem, 2vw, 1.85rem);
    line-height: 1.65;
  }

  .bojax-curriculum__description p,
  .bojax-curriculum__included-description p,
  .bojax-curriculum__item-description p {
    margin: 0;
  }

  /* Course totals */

  .bojax-curriculum__stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 4.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.11);
    border-bottom: 1px solid rgba(255, 255, 255, 0.11);
  }

  .bojax-curriculum__stat {
    display: grid;
    min-width: 0;
    min-height: 13rem;
    padding: 2.4rem 1.4rem;
    place-content: center;
    gap: 1rem;
    text-align: center;
  }

  .bojax-curriculum__stat + .bojax-curriculum__stat {
    border-left: 1px solid rgba(255, 255, 255, 0.11);
  }

  .bojax-curriculum__stat strong {
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.8rem, 4vw, 4.2rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .bojax-curriculum__stat span {
    color: rgba(255, 255, 255, 0.48);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  /* Everything included */

  .bojax-curriculum__included {
    margin-top: 6rem;
    padding: 4rem;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 2.6rem;
    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.055),
        rgba(255, 255, 255, 0.016)
      );
    box-shadow: 0 3rem 9rem rgba(0, 0, 0, 0.3);
  }

  .bojax-curriculum__included-header {
    max-width: 76rem;
  }

  .bojax-curriculum__included-heading {
    margin: 0;
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3.4rem, 5vw, 5.4rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .bojax-curriculum__included-description {
    max-width: 68rem;
    margin-top: 1.5rem;
    color: rgba(255, 255, 255, 0.57);
    font-size: 1.5rem;
    line-height: 1.6;
  }

  .bojax-curriculum__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 3.5rem;
    gap: 0;
  }

  .bojax-curriculum__item {
    display: flex;
    min-width: 0;
    padding: 2rem 2rem 2rem 0;
    align-items: flex-start;
    gap: 1.4rem;
    border-top: 1px solid rgba(255, 255, 255, 0.09);
  }

  .bojax-curriculum__item:nth-child(even) {
    padding-right: 0;
    padding-left: 2rem;
    border-left: 1px solid rgba(255, 255, 255, 0.09);
  }

  .bojax-curriculum__check {
    display: grid;
    flex: 0 0 2.5rem;
    width: 2.5rem;
    height: 2.5rem;
    margin-top: 0.1rem;
    place-items: center;
    border: 1px solid rgba(73, 216, 113, 0.38);
    border-radius: 50%;
    background: rgba(73, 216, 113, 0.11);
    color: var(--bojax-check-green);
  }

  .bojax-curriculum__check svg {
    width: 1.45rem;
    height: 1.45rem;
  }

  .bojax-curriculum__check--small {
    flex-basis: 2.1rem;
    width: 2.1rem;
    height: 2.1rem;
  }

  .bojax-curriculum__check--small svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  .bojax-curriculum__item-content {
    min-width: 0;
  }

  .bojax-curriculum__item-title {
    margin: 0;
    color: rgba(255, 255, 255, 0.94);
    font-size: 1.55rem;
    font-weight: 800;
    letter-spacing: -0.015em;
    line-height: 1.35;
  }

  .bojax-curriculum__item-description {
    margin-top: 0.6rem;
    color: rgba(255, 255, 255, 0.49);
    font-size: 1.27rem;
    line-height: 1.55;
  }

  /* Additional access features */

  .bojax-curriculum__features {
    margin-top: 4rem;
    padding: 3rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 2rem;
    background: rgba(255, 255, 255, 0.022);
  }

  .bojax-curriculum__feature-heading {
    margin: 0 0 2.2rem;
    color: #ffffff;
    font-size: 2.2rem;
    font-weight: 850;
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  .bojax-curriculum__feature-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.4rem 2.5rem;
  }

  .bojax-curriculum__feature {
    display: flex;
    min-width: 0;
    align-items: flex-start;
    gap: 1.1rem;
    color: rgba(255, 255, 255, 0.73);
    font-size: 1.35rem;
    font-weight: 650;
    line-height: 1.5;
  }

  .bojax-curriculum__disclaimer {
    max-width: 78rem;
    margin: 2.8rem auto 0;
    color: rgba(255, 255, 255, 0.34);
    font-size: 1.1rem;
    line-height: 1.6;
    text-align: center;
  }

  .bojax-curriculum__actions {
    display: flex;
    margin-top: 3rem;
    justify-content: center;
  }

  .bojax-curriculum__button {
    display: inline-flex;
    width: min(100%, 44rem);
    min-height: 6.2rem;
    padding: 1.5rem 2.8rem;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    border: 1px solid #ffffff;
    border-radius: 1.5rem;
    background: #f4f1ec;
    color: #080808;
    font-size: 1.48rem;
    font-weight: 900;
    line-height: 1;
    text-decoration: none;
    box-shadow: 0 2rem 5rem rgba(255, 255, 255, 0.07);
    transition:
      background 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .bojax-curriculum__button:hover {
    background: #ffffff;
    color: #080808;
    box-shadow: 0 2.4rem 6rem rgba(255, 255, 255, 0.12);
    transform: translateY(-0.2rem);
  }

  .bojax-curriculum__button svg {
    width: 2rem;
    height: 2rem;
  }

  @media screen and (max-width: 749px) {
    .bojax-curriculum {
      padding: 6.2rem 0;
    }

    .bojax-curriculum__container {
      width: calc(100% - 2.8rem);
    }

    .bojax-curriculum__heading {
      font-size: clamp(3.8rem, 11vw, 5.2rem);
    }

    .bojax-curriculum__description {
      margin-top: 1.8rem;
      font-size: 1.42rem;
    }

    .bojax-curriculum__stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: 3.5rem;
    }

    .bojax-curriculum__stat {
      min-height: 10.5rem;
      padding: 1.8rem 0.8rem;
    }

    .bojax-curriculum__stat:nth-child(3) {
      border-left: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.11);
    }

    .bojax-curriculum__stat:nth-child(4) {
      border-top: 1px solid rgba(255, 255, 255, 0.11);
    }

    .bojax-curriculum__stat strong {
      font-size: 3rem;
    }

    .bojax-curriculum__stat span {
      font-size: 0.82rem;
      letter-spacing: 0.12em;
    }

    .bojax-curriculum__included {
      margin-top: 4.5rem;
      padding: 2.5rem 1.7rem;
      border-radius: 2.1rem;
    }

    .bojax-curriculum__included-heading {
      font-size: 3.6rem;
    }

    .bojax-curriculum__included-description {
      font-size: 1.35rem;
    }

    .bojax-curriculum__list {
      grid-template-columns: 1fr;
      margin-top: 2.7rem;
    }

    .bojax-curriculum__item,
    .bojax-curriculum__item:nth-child(even) {
      padding: 1.6rem 0;
      border-left: 0;
    }

    .bojax-curriculum__item-title {
      font-size: 1.42rem;
    }

    .bojax-curriculum__item-description {
      font-size: 1.2rem;
    }

    .bojax-curriculum__features {
      margin-top: 2.7rem;
      padding: 2.2rem 1.7rem;
    }

    .bojax-curriculum__feature-grid {
      grid-template-columns: 1fr;
    }

    .bojax-curriculum__feature-heading {
      font-size: 2rem;
    }

    .bojax-curriculum__button {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bojax course curriculum",
  "tag": "section",
  "class": "bojax-curriculum-section",
  "max_blocks": 24,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "WHAT YOU GET"
