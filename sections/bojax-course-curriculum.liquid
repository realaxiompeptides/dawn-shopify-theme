<section
  id="BojaxCurriculum-{{ section.id }}"
  class="bojax-curriculum"
  data-bojax-curriculum
  style="
    --bojax-section-top: {{ section.settings.padding_top }}px;
    --bojax-section-bottom: {{ section.settings.padding_bottom }}px;
    --bojax-heading-gap: {{ section.settings.heading_gap }}px;
    --bojax-stats-gap: {{ section.settings.stats_gap }}px;
    --bojax-list-gap: {{ section.settings.list_gap }}px;
    --bojax-card-gap: {{ section.settings.card_gap }}px;
  "
>
  <div class="bojax-curriculum__ambient" aria-hidden="true">
    <span class="bojax-curriculum__orb bojax-curriculum__orb--left"></span>
    <span class="bojax-curriculum__orb bojax-curriculum__orb--right"></span>
    <span class="bojax-curriculum__grid-lines"></span>
  </div>

  <div class="bojax-curriculum__container">
    <header class="bojax-curriculum__header">
      {% if section.settings.eyebrow != blank %}
        <p class="bojax-curriculum__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="bojax-curriculum__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="bojax-curriculum__description">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </header>

    {% if section.settings.show_stats %}
      <div
        class="bojax-curriculum__stats"
        data-bojax-curriculum-stats
      >
        <div class="bojax-curriculum__stat">
          <strong
            class="bojax-curriculum__counter"
            data-counter-target="{{ section.settings.module_count }}"
            data-counter-suffix="{{ section.settings.module_suffix }}"
          >
            0{{ section.settings.module_suffix }}
          </strong>

          <span>{{ section.settings.module_label }}</span>
        </div>

        <div class="bojax-curriculum__stat">
          <strong
            class="bojax-curriculum__counter"
            data-counter-target="{{ section.settings.lesson_count }}"
            data-counter-suffix="{{ section.settings.lesson_suffix }}"
          >
            0{{ section.settings.lesson_suffix }}
          </strong>

          <span>{{ section.settings.lesson_label }}</span>
        </div>

        <div class="bojax-curriculum__stat">
          <strong>{{ section.settings.access_value }}</strong>
          <span>{{ section.settings.access_label }}</span>
        </div>

        <div class="bojax-curriculum__stat">
          <strong>{{ section.settings.updates_value }}</strong>
          <span>{{ section.settings.updates_label }}</span>
        </div>
      </div>
    {% endif %}

    <div class="bojax-curriculum__included">
      <div class="bojax-curriculum__included-header">
        {% if section.settings.included_eyebrow != blank %}
          <p class="bojax-curriculum__included-eyebrow">
            {{ section.settings.included_eyebrow }}
          </p>
        {% endif %}

        {% if section.settings.included_heading != blank %}
          <h3 class="bojax-curriculum__included-heading">
            {{ section.settings.included_heading }}
          </h3>
        {% endif %}

        {% if section.settings.included_description != blank %}
          <div class="bojax-curriculum__included-description">
            {{ section.settings.included_description }}
          </div>
        {% endif %}
      </div>

      {% if section.blocks.size > 0 %}
        <div class="bojax-curriculum__checklist">
          {% for block in section.blocks %}
            <article
              class="bojax-curriculum__item{% if block.settings.featured %} bojax-curriculum__item--featured{% endif %}"
              {{ block.shopify_attributes }}
            >
              <span class="bojax-curriculum__check" aria-hidden="true">
                <svg viewBox="0 0 20 20">
                  <path
                    d="M5 10.5 8.2 13.7 15.5 6.2"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.35"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>

              <div class="bojax-curriculum__item-copy">
                {% if block.settings.category != blank %}
                  <p class="bojax-curriculum__item-category">
                    {{ block.settings.category }}
                  </p>
                {% endif %}

                {% if block.settings.title != blank %}
                  <h4 class="bojax-curriculum__item-title">
                    {{ block.settings.title }}
                  </h4>
                {% endif %}

                {% if block.settings.description != blank %}
                  <div class="bojax-curriculum__item-description">
                    {{ block.settings.description }}
                  </div>
                {% endif %}
              </div>
            </article>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    {% if section.settings.closing_text != blank %}
      <div class="bojax-curriculum__closing">
        <span class="bojax-curriculum__closing-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path
              d="M12 3 5.5 6v5.2c0 4.2 2.7 8 6.5 9.8 3.8-1.8 6.5-5.6 6.5-9.8V6L12 3Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linejoin="round"
            />
            <path
              d="m9.3 12 1.8 1.8 3.8-4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>

        <p>{{ section.settings.closing_text }}</p>
      </div>
    {% endif %}

    {% if section.settings.disclaimer != blank %}
      <p class="bojax-curriculum__disclaimer">
        {{ section.settings.disclaimer }}
      </p>
    {% endif %}

    {% if section.settings.button_text != blank %}
      <div class="bojax-curriculum__actions">
        <a
          class="bojax-curriculum__button"
          href="#pricing"
          data-scroll-to-pricing
        >
          <span>{{ section.settings.button_text }}</span>

          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path
              d="M4 10h11M11 5l5 5-5 5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .bojax-curriculum {
    --bojax-gold: #d8b86a;
    --bojax-gold-light: #f1d895;
    --bojax-gold-soft: rgba(216, 184, 106, 0.11);
    --bojax-green: #4ce47a;

    position: relative;
    overflow: hidden;

    padding-top: var(--bojax-section-top, 48px);
    padding-bottom: var(--bojax-section-bottom, 72px);

    background:
      radial-gradient(
        circle at 50% 0,
        rgba(216, 184, 106, 0.13),
        transparent 31rem
      ),
      linear-gradient(
        180deg,
        #030303 0%,
        #090806 50%,
        #030303 100%
      );

    color: #ffffff;
  }

  .bojax-curriculum::before {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;

    height: 1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        var(--bojax-gold),
        rgba(255, 255, 255, 0.75),
        var(--bojax-gold),
        transparent
      );

    content: "";
    opacity: 0.72;
  }

  .bojax-curriculum__ambient {
    position: absolute;
    inset: 0;

    overflow: hidden;
    pointer-events: none;
  }

  .bojax-curriculum__orb {
    position: absolute;
    display: block;

    border-radius: 50%;
    background: var(--bojax-gold);

    filter: blur(10rem);
  }

  .bojax-curriculum__orb--left {
    top: 5rem;
    left: -24rem;

    width: 44rem;
    height: 44rem;

    opacity: 0.1;
  }

  .bojax-curriculum__orb--right {
    right: -24rem;
    bottom: 5rem;

    width: 46rem;
    height: 46rem;

    opacity: 0.07;
  }

  .bojax-curriculum__grid-lines {
    position: absolute;
    inset: 0;

    opacity: 0.045;

    background-image:
      linear-gradient(
        rgba(216, 184, 106, 0.55) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(216, 184, 106, 0.55) 1px,
        transparent 1px
      );

    background-size: 7rem 7rem;

    mask-image:
      linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.8),
        transparent 75%
      );

    -webkit-mask-image:
      linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.8),
        transparent 75%
      );
  }

  .bojax-curriculum__container {
    position: relative;
    z-index: 2;

    width: min(calc(100% - 4rem), 116rem);
    margin: 0 auto;
  }

  /* Header */

  .bojax-curriculum__header {
    max-width: 82rem;
    margin: 0 auto;

    text-align: center;
  }

  .bojax-curriculum__eyebrow {
    margin: 0 0 1.2rem;

    color: var(--bojax-gold-light);

    font-size: 1rem;
    font-weight: 850;
    letter-spacing: 0.34em;
    line-height: 1;
    text-transform: uppercase;
  }

  .bojax-curriculum__heading {
    margin: 0;

    color: #ffffff;

    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(4rem, 7vw, 7rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.95;

    text-wrap: balance;
  }

  .bojax-curriculum__description {
    max-width: 68rem;
    margin: var(--bojax-heading-gap, 18px) auto 0;

    color: rgba(255, 255, 255, 0.62);

    font-size: clamp(1.45rem, 2vw, 1.8rem);
    line-height: 1.62;
  }

  .bojax-curriculum__description p,
  .bojax-curriculum__included-description p,
  .bojax-curriculum__item-description p {
    margin: 0;
  }

  /* Animated statistics */

  .bojax-curriculum__stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));

    margin-top: var(--bojax-stats-gap, 34px);

    overflow: hidden;

    border: 1px solid rgba(216, 184, 106, 0.28);
    border-radius: 2.2rem;

    background:
      linear-gradient(
        145deg,
        rgba(216, 184, 106, 0.09),
        rgba(255, 255, 255, 0.018)
      );

    box-shadow:
      0 2.5rem 7rem rgba(0, 0, 0, 0.35),
      inset 0 1px rgba(255, 255, 255, 0.04);
  }

  .bojax-curriculum__stat {
    display: grid;
    min-width: 0;
    min-height: 13rem;
    padding: 2rem 1rem;

    place-content: center;
    gap: 0.8rem;

    text-align: center;
  }

  .bojax-curriculum__stat + .bojax-curriculum__stat {
    border-left: 1px solid rgba(216, 184, 106, 0.16);
  }

  .bojax-curriculum__stat strong {
    color: #ffffff;

    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3rem, 4.5vw, 4.8rem);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 0.95;
  }

  .bojax-curriculum__stat span {
    color: var(--bojax-gold-light);

    font-size: 0.88rem;
    font-weight: 850;
    letter-spacing: 0.16em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  /* Checklist container */

  .bojax-curriculum__included {
    margin-top: var(--bojax-list-gap, 48px);
    padding: 3.4rem;

    border: 1px solid rgba(216, 184, 106, 0.25);
    border-radius: 2.4rem;

    background:
      radial-gradient(
        circle at 50% 0,
        rgba(216, 184, 106, 0.07),
        transparent 30rem
      ),
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.045),
        rgba(255, 255, 255, 0.012)
      );

    box-shadow:
      0 3rem 9rem rgba(0, 0, 0, 0.3),
      inset 0 1px rgba(255, 255, 255, 0.04);
  }

  .bojax-curriculum__included-header {
    max-width: 76rem;
  }

  .bojax-curriculum__included-eyebrow {
    margin: 0 0 1.2rem;

    color: var(--bojax-gold-light);

    font-size: 0.95rem;
    font-weight: 850;
    letter-spacing: 0.28em;
    line-height: 1;
    text-transform: uppercase;
  }

  .bojax-curriculum__included-heading {
    margin: 0;

    color: #ffffff;

    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3.3rem, 5vw, 5.2rem);
    font-weight: 500;
    letter-spacing: -0.052em;
    line-height: 1;
  }

  .bojax-curriculum__included-description {
    max-width: 68rem;
    margin-top: 1.4rem;

    color: rgba(255, 255, 255, 0.56);

    font-size: 1.4rem;
    line-height: 1.6;
  }

  /* Compact two-column checklist */

  .bojax-curriculum__checklist {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));

    margin-top: 2.7rem;

    gap: var(--bojax-card-gap, 10px);
  }

  .bojax-curriculum__item {
    display: flex;
    min-width: 0;
    min-height: 8.8rem;
    padding: 1.6rem;

    align-items: flex-start;
    gap: 1.2rem;

    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 1.5rem;

    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.045),
        rgba(0, 0, 0, 0.12)
      );
  }

  .bojax-curriculum__item--featured {
    border-color: rgba(216, 184, 106, 0.34);

    background:
      linear-gradient(
        145deg,
        rgba(216, 184, 106, 0.09),
        rgba(255, 255, 255, 0.014)
      );
  }

  .bojax-curriculum__check {
    display: grid;
    flex: 0 0 2.7rem;

    width: 2.7rem;
    height: 2.7rem;
    margin-top: 0.05rem;

    place-items: center;

    border-radius: 50%;

    background: var(--bojax-green);
    color: #031108;

    box-shadow:
      0 0 2rem rgba(76, 228, 122, 0.18);
  }

  .bojax-curriculum__check svg {
    width: 1.55rem;
    height: 1.55rem;
  }

  .bojax-curriculum__item-copy {
    min-width: 0;
  }

  .bojax-curriculum__item-category {
    margin: 0 0 0.45rem;

    color: var(--bojax-gold-light);

    font-size: 0.75rem;
    font-weight: 850;
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .bojax-curriculum__item-title {
    margin: 0;

    color: rgba(255, 255, 255, 0.95);

    font-size: 1.42rem;
    font-weight: 820;
    letter-spacing: -0.02em;
    line-height: 1.28;
  }

  .bojax-curriculum__item-description {
    margin-top: 0.55rem;

    color: rgba(255, 255, 255, 0.46);

    font-size: 1.12rem;
    line-height: 1.48;
  }

  /* Closing line */

  .bojax-curriculum__closing {
    display: flex;
    max-width: 78rem;
    margin: 2.5rem auto 0;
    padding: 1.5rem 1.8rem;

    align-items: center;
    justify-content: center;
    gap: 1rem;

    border: 1px solid rgba(216, 184, 106, 0.19);
    border-radius: 1.5rem;

    background: rgba(216, 184, 106, 0.05);

    text-align: center;
  }

  .bojax-curriculum__closing-icon {
    display: grid;
    flex: 0 0 3rem;

    width: 3rem;
    height: 3rem;

    place-items: center;

    border-radius: 0.9rem;

    background: var(--bojax-gold-soft);
    color: var(--bojax-gold-light);
  }

  .bojax-curriculum__closing-icon svg {
    width: 1.8rem;
    height: 1.8rem;
  }

  .bojax-curriculum__closing p {
    margin: 0;

    color: rgba(255, 255, 255, 0.68);

    font-size: 1.25rem;
    line-height: 1.5;
  }

  .bojax-curriculum__disclaimer {
    max-width: 82rem;
    margin: 2rem auto 0;

    color: rgba(255, 255, 255, 0.3);

    font-size: 1rem;
    line-height: 1.55;
    text-align: center;
  }

  .bojax-curriculum__actions {
    display: flex;
    margin-top: 2.5rem;

    justify-content: center;
  }

  .bojax-curriculum__button {
    display: inline-flex;
    width: min(100%, 46rem);
    min-height: 6rem;
    padding: 1.4rem 2.8rem;

    align-items: center;
    justify-content: center;
    gap: 1rem;

    border: 1px solid var(--bojax-gold-light);
    border-radius: 1.5rem;

    background:
      linear-gradient(
        135deg,
        #ffffff,
        #f5e7bf
      );

    color: #080704;

    font-size: 1.45rem;
    font-weight: 900;
    line-height: 1;
    text-decoration: none;

    box-shadow:
      0 2rem 5rem rgba(0, 0, 0, 0.32),
      0 0 3rem rgba(216, 184, 106, 0.12);
  }

  .bojax-curriculum__button svg {
    width: 2rem;
    height: 2rem;
  }

  @media screen and (max-width: 989px) {
    .bojax-curriculum__stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .bojax-curriculum__stat:nth-child(3) {
      border-top: 1px solid rgba(216, 184, 106, 0.16);
      border-left: 0;
    }

    .bojax-curriculum__stat:nth-child(4) {
      border-top: 1px solid rgba(216, 184, 106, 0.16);
    }
  }

  @media screen and (max-width: 749px) {
    .bojax-curriculum__container {
      width: calc(100% - 2rem);
    }

    .bojax-curriculum__eyebrow {
      margin-bottom: 1rem;

      font-size: 0.82rem;
      letter-spacing: 0.24em;
    }

    .bojax-curriculum__heading {
      font-size: clamp(3.7rem, 12vw, 5.2rem);
    }

    .bojax-curriculum__description {
      font-size: 1.32rem;
    }

    .bojax-curriculum__stats {
      border-radius: 1.8rem;
    }

    .bojax-curriculum__stat {
      min-height: 10rem;
      padding: 1.4rem 0.4rem;
    }

    .bojax-curriculum__stat strong {
      font-size: clamp(2.7rem, 9vw, 3.7rem);
    }

    .bojax-curriculum__stat span {
      font-size: 0.67rem;
      letter-spacing: 0.1em;
    }

    .bojax-curriculum__included {
      padding: 2.2rem 1.2rem;

      border-radius: 1.9rem;
    }

    .bojax-curriculum__included-eyebrow {
      font-size: 0.78rem;
      letter-spacing: 0.2em;
    }

    .bojax-curriculum__included-heading {
      font-size: 3.4rem;
    }

    .bojax-curriculum__included-description {
      font-size: 1.25rem;
    }

    .bojax-curriculum__checklist {
      grid-template-columns: repeat(2, minmax(0, 1fr));

      margin-top: 2rem;
    }

    .bojax-curriculum__item {
      min-height: 8.2rem;
      padding: 1.05rem 0.8rem;

      gap: 0.7rem;

      border-radius: 1.25rem;
    }

    .bojax-curriculum__check {
      flex-basis: 2.15rem;

      width: 2.15rem;
      height: 2.15rem;
    }

    .bojax-curriculum__check svg {
      width: 1.25rem;
      height: 1.25rem;
    }

    .bojax-curriculum__item-category {
      margin-bottom: 0.35rem;

      font-size: 0.52rem;
      letter-spacing: 0.08em;
    }

    .bojax-curriculum__item-title {
      font-size: 1.02rem;
      line-height: 1.22;
    }

    .bojax-curriculum__item-description {
      margin-top: 0.4rem;

      font-size: 0.78rem;
      line-height: 1.35;
    }

    .bojax-curriculum__closing {
      padding: 1.3rem;
    }

    .bojax-curriculum__closing p {
      font-size: 1.08rem;
    }

    .bojax-curriculum__button {
      width: 100%;
    }
  }

  @media screen and (max-width: 380px) {
    .bojax-curriculum__included {
      padding-right: 0.9rem;
      padding-left: 0.9rem;
    }

    .bojax-curriculum__item {
      padding-right: 0.65rem;
      padding-left: 0.65rem;
    }

    .bojax-curriculum__check {
      flex-basis: 1.95rem;

      width: 1.95rem;
      height: 1.95rem;
    }

    .bojax-curriculum__item-title {
      font-size: 0.94rem;
    }

    .bojax-curriculum__item-description {
      font-size: 0.72rem;
    }
  }
{% endstylesheet %}

<script>
  (() => {
    const initializeCurriculum = (section) => {
      if (
        !section ||
        section.dataset.bojaxCurriculumInitialized === 'true'
      ) {
        return;
      }

      section.dataset.bojaxCurriculumInitialized = 'true';

      const stats = section.querySelector(
        '[data-bojax-curriculum-stats]'
      );

      const counters = Array.from(
        section.querySelectorAll('[data-counter-target]')
      );

      if (!stats || counters.length === 0) return;

      let hasAnimated = false;

      const animateCounter = (counter) => {
        const target =
          Number(counter.getAttribute('data-counter-target')) || 0;

        const suffix =
          counter.getAttribute('data-counter-suffix') || '';

        const duration = 1500;
        const startTime = performance.now();

        const update = (currentTime) => {
          const elapsed = currentTime - startTime;
          const progress = Math.min(elapsed / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 4);
          const value = Math.round(target * eased);

          counter.textContent = `${value}${suffix}`;

          if (progress < 1) {
            window.requestAnimationFrame(update);
          } else {
            counter.textContent = `${target}${suffix}`;
          }
        };

        window.requestAnimationFrame(update);
      };

      const beginAnimation = () => {
        if (hasAnimated) return;

        hasAnimated = true;

        counters.forEach((counter) => {
          animateCounter(counter);
        });
      };

      if (!('IntersectionObserver' in window)) {
        beginAnimation();
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;

            beginAnimation();
            observer.disconnect();
          });
        },
        {
          threshold: 0.2
        }
      );

      observer.observe(stats);
    };

    const initializeAll = (root = document) => {
      if (
        root.matches &&
        root.matches('[data-bojax-curriculum]')
      ) {
        initializeCurriculum(root);
      }

      root
        .querySelectorAll?.('[data-bojax-curriculum]')
        .forEach(initializeCurriculum);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        initializeAll(document);
      });
    } else {
      initializeAll(document);
    }

    document.addEventListener('shopify:section:load', (event) => {
      initializeAll(event.target);
    });
