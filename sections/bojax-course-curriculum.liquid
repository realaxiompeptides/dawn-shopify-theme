<script>
  (() => {
    const initializeCurriculum = (section) => {
      if (!section || section.dataset.curriculumReady === 'true') return;

      const carousel = section.querySelector('[data-curriculum-carousel]');
      const slides = Array.from(section.querySelectorAll('[data-curriculum-slide]'));
      const previousButton = section.querySelector('[data-curriculum-previous]');
      const nextButton = section.querySelector('[data-curriculum-next]');
      const dots = Array.from(section.querySelectorAll('[data-curriculum-dot]'));

      if (!carousel || slides.length === 0) return;

      section.dataset.curriculumReady = 'true';

      const autoplayEnabled = section.dataset.autoplay === 'true';
      const autoplaySpeed = Number(section.dataset.autoplaySpeed) || 5000;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      let activeIndex = 0;
      let autoplayTimer = null;
      let scrollTimer = null;
      let interactionPaused = false;

      const getSlideLeft = (index) => {
        const slide = slides[index];
        return slide ? slide.offsetLeft - carousel.offsetLeft : 0;
      };

      const updateDots = (index) => {
        activeIndex = Math.max(0, Math.min(index, slides.length - 1));

        dots.forEach((dot, dotIndex) => {
          const isActive = dotIndex === activeIndex;
          dot.classList.toggle('is-active', isActive);
          dot.setAttribute('aria-current', isActive ? 'true' : 'false');
        });
      };

      const goToSlide = (index, behavior = 'smooth') => {
        if (slides.length === 0) return;

        const normalizedIndex =
          ((index % slides.length) + slides.length) % slides.length;

        carousel.scrollTo({
          left: getSlideLeft(normalizedIndex),
          behavior
        });

        updateDots(normalizedIndex);
      };

      const findClosestSlide = () => {
        const carouselLeft = carousel.scrollLeft;
        let closestIndex = 0;
        let closestDistance = Infinity;

        slides.forEach((slide, index) => {
          const slideLeft = slide.offsetLeft - carousel.offsetLeft;
          const distance = Math.abs(slideLeft - carouselLeft);

          if (distance < closestDistance) {
            closestDistance = distance;
            closestIndex = index;
          }
        });

        return closestIndex;
      };

      const stopAutoplay = () => {
        if (autoplayTimer) {
          window.clearInterval(autoplayTimer);
          autoplayTimer = null;
        }
      };

      const startAutoplay = () => {
        stopAutoplay();

        if (
          !autoplayEnabled ||
          reducedMotion ||
          interactionPaused ||
          slides.length < 2
        ) {
          return;
        }

        autoplayTimer = window.setInterval(() => {
          goToSlide(activeIndex + 1);
        }, autoplaySpeed);
      };

      previousButton?.addEventListener('click', () => {
        goToSlide(activeIndex - 1);
        startAutoplay();
      });

      nextButton?.addEventListener('click', () => {
        goToSlide(activeIndex + 1);
        startAutoplay();
      });

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          goToSlide(Number(dot.dataset.curriculumDot));
          startAutoplay();
        });
      });

      carousel.addEventListener(
        'scroll',
        () => {
          window.clearTimeout(scrollTimer);

          scrollTimer = window.setTimeout(() => {
            updateDots(findClosestSlide());
          }, 100);
        },
        { passive: true }
      );

      const pauseInteraction = () => {
        interactionPaused = true;
        stopAutoplay();
      };

      const resumeInteraction = () => {
        interactionPaused = false;
        startAutoplay();
      };

      carousel.addEventListener('pointerdown', pauseInteraction);
      carousel.addEventListener('touchstart', pauseInteraction, { passive: true });
      carousel.addEventListener('focusin', pauseInteraction);

      carousel.addEventListener('pointerup', resumeInteraction);
      carousel.addEventListener('pointercancel', resumeInteraction);
      carousel.addEventListener('touchend', resumeInteraction, { passive: true });
      carousel.addEventListener('focusout', resumeInteraction);

      section.addEventListener('mouseenter', pauseInteraction);
      section.addEventListener('mouseleave', resumeInteraction);

      window.addEventListener('resize', () => {
        goToSlide(activeIndex, 'auto');
      });

      updateDots(0);
      startAutoplay();
    };

    const initializeAllCurriculums = (root = document) => {
      root
        .querySelectorAll('[data-bojax-curriculum]')
        .forEach(initializeCurriculum);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        initializeAllCurriculums();
      });
    } else {
      initializeAllCurriculums();
    }

    document.addEventListener('shopify:section:load', (event) => {
      initializeAllCurriculums(event.target);
    });
  })();
</script>

