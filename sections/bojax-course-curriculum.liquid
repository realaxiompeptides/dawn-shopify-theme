<section
  id="BojaxCurriculum-{{ section.id }}"
  class="bojax-curriculum"
>
  <div class="bojax-curriculum__container">
    <header class="bojax-curriculum__header">
      {% if section.settings.eyebrow != blank %}
        <p class="bojax-curriculum__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="bojax-curriculum__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="bojax-curriculum__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

      {% if section.settings.show_summary %}
        <div class="bojax-curriculum__summary">
          <div class="bojax-curriculum__summary-item">
            <strong>{{ section.blocks.size }}</strong>
            <span>Course modules</span>
          </div>

          <div class="bojax-curriculum__summary-item">
            <strong>{{ section.settings.lesson_count }}</strong>
            <span>Step-by-step lessons</span>
          </div>

          <div class="bojax-curriculum__summary-item">
            <strong>∞</strong>
            <span>Lifetime access</span>
          </div>
        </div>
      {% endif %}
    </header>

    {% if section.blocks.size > 0 %}
      <div class="bojax-curriculum__grid">
        {% for block in section.blocks %}
          <article
            class="bojax-module-card{% if block.settings.featured %} bojax-module-card--featured{% endif %}"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.image != blank %}
              <div class="bojax-module-card__media">
                {{
                  block.settings.image
                  | image_url: width: 1000
                  | image_tag:
                    class: 'bojax-module-card__image',
                    loading: 'lazy',
                    widths: '320, 500, 750, 1000',
                    sizes: '(max-width: 749px) 82vw, (max-width: 989px) 45vw, 31vw',
                    alt: block.settings.image.alt
                }}

                <div class="bojax-module-card__media-overlay"></div>

                {% if block.settings.badge != blank %}
                  <span class="bojax-module-card__badge">
                    {{ block.settings.badge }}
                  </span>
                {% endif %}
              </div>
            {% else %}
              <div class="bojax-module-card__media bojax-module-card__media--placeholder">
                <span class="bojax-module-card__placeholder-number">
                  {{ forloop.index | prepend: '0' | slice: -2, 2 }}
                </span>

                {% if block.settings.badge != blank %}
                  <span class="bojax-module-card__badge">
                    {{ block.settings.badge }}
                  </span>
                {% endif %}
              </div>
            {% endif %}

            <div class="bojax-module-card__body">
              <div class="bojax-module-card__meta">
                <span class="bojax-module-card__number">
                  Module {{ forloop.index | prepend: '0' | slice: -2, 2 }}
                </span>

                {% if block.settings.lesson_count != blank %}
                  <span class="bojax-module-card__lessons">
                    {{ block.settings.lesson_count }}
                  </span>
                {% endif %}
              </div>

              {% if block.settings.title != blank %}
                <h3 class="bojax-module-card__title">
                  {{ block.settings.title }}
                </h3>
              {% endif %}

              {% if block.settings.description != blank %}
                <div class="bojax-module-card__description">
                  {{ block.settings.description }}
                </div>
              {% endif %}

              {% if block.settings.point_1 != blank
                or block.settings.point_2 != blank
                or block.settings.point_3 != blank
              %}
                <ul class="bojax-module-card__points">
                  {% if block.settings.point_1 != blank %}
                    <li>{{ block.settings.point_1 }}</li>
                  {% endif %}

                  {% if block.settings.point_2 != blank %}
                    <li>{{ block.settings.point_2 }}</li>
                  {% endif %}

                  {% if block.settings.point_3 != blank %}
                    <li>{{ block.settings.point_3 }}</li>
                  {% endif %}
                </ul>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.footer_text != blank %}
      <p class="bojax-curriculum__footer-text">
        {{ section.settings.footer_text }}
      </p>
    {% endif %}

    {% if section.settings.button_text != blank %}
      <div class="bojax-curriculum__actions">
        <a
          class="bojax-curriculum__button"
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            href="#BojaxHero-{{ section.id }}"
          {% endif %}
        >
          <span>{{ section.settings.button_text }}</span>

          <svg
            aria-hidden="true"
            viewBox="0 0 20 20"
            width="20"
            height="20"
          >
            <path
              d="M4 10h11M11 5l5 5-5 5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .bojax-curriculum {
    position: relative;
    overflow: hidden;
    padding: 9rem 0;
    background:
      radial-gradient(
        circle at 50% 0,
        rgba(255, 255, 255, 0.055),
        transparent 34rem
      ),
      #000;
    color: #fff;
  }

  .bojax-curriculum::before {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 1px;
    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.18),
        transparent
      );
    content: "";
  }

  .bojax-curriculum__container {
    width: min(calc(100% - 4rem), 120rem);
    margin: 0 auto;
  }

  .bojax-curriculum__header {
    max-width: 82rem;
    margin: 0 auto;
    text-align: center;
  }

  .bojax-curriculum__eyebrow {
    margin: 0 0 1.8rem;
    color: rgba(255, 255, 255, 0.58);
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.32em;
    line-height: 1;
    text-transform: uppercase;
  }

  .bojax-curriculum__heading {
    margin: 0;
    color: #fff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(4.2rem, 7vw, 7.5rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .bojax-curriculum__description {
    max-width: 68rem;
    margin: 2.4rem auto 0;
    color: rgba(255, 255, 255, 0.62);
    font-size: clamp(1.55rem, 2vw, 1.9rem);
    line-height: 1.65;
  }

  .bojax-curriculum__description p {
    margin: 0;
  }

  .bojax-curriculum__summary {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 72rem;
    margin: 4rem auto 0;
    padding: 2.2rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.11);
    border-bottom: 1px solid rgba(255, 255, 255, 0.11);
  }

  .bojax-curriculum__summary-item {
    display: grid;
    padding: 0 2rem;
    gap: 0.7rem;
    text-align: center;
  }

  .bojax-curriculum__summary-item + .bojax-curriculum__summary-item {
    border-left: 1px solid rgba(255, 255, 255, 0.11);
  }

  .bojax-curriculum__summary-item strong {
    color: #fff;
    font-size: clamp(2.7rem, 4vw, 4rem);
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .bojax-curriculum__summary-item span {
    color: rgba(255, 255, 255, 0.5);
    font-size: 1.15rem;
    line-height: 1.3;
  }

  .bojax-curriculum__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 5.5rem;
    gap: 2rem;
  }

  .bojax-module-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 2.2rem;
    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.065),
        rgba(255, 255, 255, 0.018)
      );
    box-shadow: 0 2rem 6rem rgba(0, 0, 0, 0.25);
    transition:
      border-color 180ms ease,
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .bojax-module-card:hover {
    border-color: rgba(255, 255, 255, 0.25);
    box-shadow: 0 2.6rem 7rem rgba(0, 0, 0, 0.4);
    transform: translateY(-0.4rem);
  }

  .bojax-module-card--featured {
    border-color: rgba(255, 255, 255, 0.3);
  }

  .bojax-module-card__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background:
      linear-gradient(
        135deg,
        #202020,
        #080808
      );
  }

  .bojax-module-card__media--placeholder {
    display: grid;
    place-items: center;
  }

  .bojax-module-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition: transform 450ms ease;
  }

  .bojax-module-card:hover .bojax-module-card__image {
    transform: scale(1.035);
  }

  .bojax-module-card__media-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        transparent 45%,
        rgba(0, 0, 0, 0.7)
      );
    pointer-events: none;
  }

  .bojax-module-card__placeholder-number {
    color: rgba(255, 255, 255, 0.08);
    font-size: 9rem;
    font-weight: 900;
    letter-spacing: -0.08em;
    line-height: 1;
  }

  .bojax-module-card__badge {
    position: absolute;
    top: 1.4rem;
    left: 1.4rem;
    z-index: 2;
    padding: 0.7rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 99rem;
    background: rgba(0, 0, 0, 0.62);
    color: #fff;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .bojax-module-card__body {
    padding: 2.3rem;
  }

  .bojax-module-card__meta {
    display: flex;
    margin-bottom: 1.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
  }

  .bojax-module-card__number,
  .bojax-module-card__lessons {
    color: rgba(255, 255, 255, 0.44);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
  }

  .bojax-module-card__title {
    margin: 0;
    color: #fff;
    font-size: 2.3rem;
    font-weight: 850;
    letter-spacing: -0.045em;
    line-height: 1.08;
    text-wrap: balance;
  }

  .bojax-module-card__description {
    margin-top: 1.2rem;
    color: rgba(255, 255, 255, 0.58);
    font-size: 1.4rem;
    line-height: 1.6;
  }

  .bojax-module-card__description p {
    margin: 0;
  }

  .bojax-module-card__points {
    display: grid;
    margin: 1.8rem 0 0;
    padding: 0;
    gap: 1rem;
    list-style: none;
  }

  .bojax-module-card__points li {
    position: relative;
    padding-left: 2.5rem;
    color: rgba(255, 255, 255, 0.76);
    font-size: 1.25rem;
    line-height: 1.45;
  }

  .bojax-module-card__points li::before {
    position: absolute;
    top: 0.15rem;
    left: 0;
    display: grid;
    width: 1.7rem;
    height: 1.7rem;
    place-items: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    content: "✓";
    font-size: 0.95rem;
    font-weight: 900;
  }

  .bojax-curriculum__footer-text {
    max-width: 72rem;
    margin: 4rem auto 0;
    color: rgba(255, 255, 255, 0.48);
    font-size: 1.35rem;
    line-height: 1.6;
    text-align: center;
  }

  .bojax-curriculum__actions {
    display: flex;
    margin-top: 2.8rem;
    justify-content: center;
  }

  .bojax-curriculum__button {
    display: inline-flex;
    min-width: min(100%, 34rem);
    min-height: 6rem;
    padding: 1.5rem 3rem;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    border: 1px solid #fff;
    border-radius: 1.4rem;
    background: #fff;
    color: #000;
    font-size: 1.45rem;
    font-weight: 850;
    letter-spacing: 0.01em;
    line-height: 1;
    text-decoration: none;
    box-shadow: 0 2rem 5rem rgba(255, 255, 255, 0.1);
    transition:
      background 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .bojax-curriculum__button:hover {
    background: #e9e9e9;
    color: #000;
    box-shadow: 0 2.4rem 6rem rgba(255, 255, 255, 0.16);
    transform: translateY(-0.2rem);
  }

  .bojax-curriculum__button svg {
    transition: transform 180ms ease;
  }

  .bojax-curriculum__button:hover svg {
    transform: translateX(0.4rem);
  }

  @media screen and (max-width: 989px) {
    .bojax-curriculum__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .bojax-curriculum {
      padding: 6.5rem 0;
    }

    .bojax-curriculum__container {
      width: calc(100% - 2.8rem);
    }

    .bojax-curriculum__eyebrow {
      margin-bottom: 1.5rem;
      font-size: 1rem;
      letter-spacing: 0.26em;
    }

    .bojax-curriculum__heading {
      font-size: clamp(4rem, 12vw, 5.5rem);
    }

    .bojax-curriculum__description {
      margin-top: 2rem;
      font-size: 1.48rem;
    }

    .bojax-curriculum__summary {
      margin-top: 3.2rem;
      padding: 1.8rem 0;
    }

    .bojax-curriculum__summary-item {
      padding: 0 0.8rem;
    }

    .bojax-curriculum__summary-item strong {
      font-size: 2.6rem;
    }

    .bojax-curriculum__summary-item span {
      font-size: 0.95rem;
    }

    .bojax-curriculum__grid {
      display: flex;
      margin: 4rem -1.4rem 0;
      padding: 0 1.4rem 1.4rem;
      gap: 1.4rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .bojax-curriculum__grid::-webkit-scrollbar {
      display: none;
    }

    .bojax-module-card {
      flex: 0 0 min(84vw, 34rem);
      scroll-snap-align: center;
    }

    .bojax-module-card__body {
      padding: 2rem;
    }

    .bojax-module-card__title {
      font-size: 2.15rem;
    }

    .bojax-curriculum__footer-text {
      margin-top: 3rem;
      font-size: 1.25rem;
    }

    .bojax-curriculum__button {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bojax course curriculum",
  "tag": "section",
  "class": "bojax-curriculum-section",
  "max_blocks": 16,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "WHAT YOU GET"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Main heading",
      "default": "The complete Bojax method"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>A complete appearance-improvement system that shows you what to focus on, what to avoid, and how to build your personal plan.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "Show course summary",
      "default": true
    },
    {
      "type": "text",
      "id": "lesson_count",
      "label": "Total lesson count",
      "default": "40+"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Text beneath modules",
      "default": "Everything is organized into one clear system so you can stop piecing together contradictory advice."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Get instant access"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "module",
      "name": "Course module",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Module preview image"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "placeholder": "Core module"
        },
