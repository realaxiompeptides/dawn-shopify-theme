<section
  id="BojaxCurriculum-{{ section.id }}"
  class="bojax-curriculum"
  data-bojax-curriculum
>
  <div class="bojax-curriculum__ambient" aria-hidden="true">
    <span class="bojax-curriculum__ambient-orb bojax-curriculum__ambient-orb--left"></span>
    <span class="bojax-curriculum__ambient-orb bojax-curriculum__ambient-orb--right"></span>
    <span class="bojax-curriculum__ambient-lines"></span>
  </div>

  <div class="bojax-curriculum__container">
    <header class="bojax-curriculum__header">
      {% if section.settings.eyebrow != blank %}
        <p class="bojax-curriculum__eyebrow">
          <span></span>
          {{ section.settings.eyebrow }}
          <span></span>
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="bojax-curriculum__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="bojax-curriculum__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

      {% if section.settings.badge_text != blank %}
        <div class="bojax-curriculum__badge">
          <span class="bojax-curriculum__badge-check" aria-hidden="true">
            <svg viewBox="0 0 20 20">
              <path
                d="M5 10.5 8.2 13.7 15.5 6.2"
                fill="none"
                stroke="currentColor"
                stroke-width="2.3"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>

          <span>{{ section.settings.badge_text }}</span>
        </div>
      {% endif %}
    </header>

    {% if section.settings.show_stats %}
      <div
        class="bojax-curriculum__stats"
        data-bojax-curriculum-stats
      >
        <div class="bojax-curriculum__stat">
          <strong
            class="bojax-curriculum__counter"
            data-counter-target="{{ section.settings.module_count }}"
            data-counter-suffix="{{ section.settings.module_suffix }}"
          >
            0{{ section.settings.module_suffix }}
          </strong>

          <span>{{ section.settings.module_label }}</span>

          {% if section.settings.module_note != blank %}
            <small>{{ section.settings.module_note }}</small>
          {% endif %}
        </div>

        <div class="bojax-curriculum__stat">
          <strong
            class="bojax-curriculum__counter"
            data-counter-target="{{ section.settings.lesson_count }}"
            data-counter-suffix="{{ section.settings.lesson_suffix }}"
          >
            0{{ section.settings.lesson_suffix }}
          </strong>

          <span>{{ section.settings.lesson_label }}</span>

          {% if section.settings.lesson_note != blank %}
            <small>{{ section.settings.lesson_note }}</small>
          {% endif %}
        </div>

        <div class="bojax-curriculum__stat">
          <strong>{{ section.settings.access_value }}</strong>
          <span>{{ section.settings.access_label }}</span>

          {% if section.settings.access_note != blank %}
            <small>{{ section.settings.access_note }}</small>
          {% endif %}
        </div>

        <div class="bojax-curriculum__stat">
          <strong>{{ section.settings.updates_value }}</strong>
          <span>{{ section.settings.updates_label }}</span>

          {% if section.settings.updates_note != blank %}
            <small>{{ section.settings.updates_note }}</small>
          {% endif %}
        </div>
      </div>
    {% endif %}

    <div class="bojax-curriculum__intro">
      <div class="bojax-curriculum__intro-copy">
        {% if section.settings.curriculum_eyebrow != blank %}
          <p class="bojax-curriculum__intro-eyebrow">
            {{ section.settings.curriculum_eyebrow }}
          </p>
        {% endif %}

        {% if section.settings.curriculum_heading != blank %}
          <h3 class="bojax-curriculum__intro-heading">
            {{ section.settings.curriculum_heading }}
          </h3>
        {% endif %}

        {% if section.settings.curriculum_description != blank %}
          <div class="bojax-curriculum__intro-description">
            {{ section.settings.curriculum_description }}
          </div>
        {% endif %}
      </div>

      <div class="bojax-curriculum__topic-count">
        <strong>{{ section.blocks.size }}</strong>
        <span>Detailed topics</span>
      </div>
    </div>

    {% if section.blocks.size > 0 %}
      <div class="bojax-curriculum__grid">
        {% for block in section.blocks %}
          <article
            class="bojax-topic-card{% if block.settings.featured %} bojax-topic-card--featured{% endif %}"
            {{ block.shopify_attributes }}
          >
            <div class="bojax-topic-card__top">
              <span class="bojax-topic-card__main-check" aria-hidden="true">
                <svg viewBox="0 0 20 20">
                  <path
                    d="M5 10.5 8.2 13.7 15.5 6.2"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>

              <div class="bojax-topic-card__heading">
                {% if block.settings.category != blank %}
                  <p class="bojax-topic-card__category">
                    {{ block.settings.category }}
                  </p>
                {% endif %}

                {% if block.settings.title != blank %}
                  <h4 class="bojax-topic-card__title">
                    {{ block.settings.title }}
                  </h4>
                {% endif %}
              </div>

              {% if block.settings.lesson_count != blank %}
                <span class="bojax-topic-card__lesson-count">
                  {{ block.settings.lesson_count }}
                </span>
              {% endif %}
            </div>

            {% if block.settings.description != blank %}
              <div class="bojax-topic-card__description">
                {{ block.settings.description }}
              </div>
            {% endif %}

            {% if block.settings.point_1 != blank
              or block.settings.point_2 != blank
              or block.settings.point_3 != blank
            %}
              <div class="bojax-topic-card__included">
                {% if block.settings.point_1 != blank %}
                  <div class="bojax-topic-card__included-item">
                    <span class="bojax-topic-card__small-check" aria-hidden="true">
                      <svg viewBox="0 0 20 20">
                        <path
                          d="M5 10.5 8.2 13.7 15.5 6.2"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </span>

                    <span>{{ block.settings.point_1 }}</span>
                  </div>
                {% endif %}

                {% if block.settings.point_2 != blank %}
                  <div class="bojax-topic-card__included-item">
                    <span class="bojax-topic-card__small-check" aria-hidden="true">
                      <svg viewBox="0 0 20 20">
                        <path
                          d="M5 10.5 8.2 13.7 15.5 6.2"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </span>

                    <span>{{ block.settings.point_2 }}</span>
                  </div>
                {% endif %}

                {% if block.settings.point_3 != blank %}
                  <div class="bojax-topic-card__included-item">
                    <span class="bojax-topic-card__small-check" aria-hidden="true">
                      <svg viewBox="0 0 20 20">
                        <path
                          d="M5 10.5 8.2 13.7 15.5 6.2"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </span>

                    <span>{{ block.settings.point_3 }}</span>
                  </div>
                {% endif %}
              </div>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="bojax-curriculum__empty">
        <h3>Reload the curriculum section</h3>
        <p>
          Remove this section from the homepage and add it again to load all
          of the preset curriculum topics.
        </p>
      </div>
    {% endif %}

    <div class="bojax-curriculum__closing">
      {% if section.settings.closing_eyebrow != blank %}
        <p class="bojax-curriculum__closing-eyebrow">
          {{ section.settings.closing_eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.closing_heading != blank %}
        <h3 class="bojax-curriculum__closing-heading">
          {{ section.settings.closing_heading }}
        </h3>
      {% endif %}

      {% if section.settings.closing_text != blank %}
        <div class="bojax-curriculum__closing-text">
          {{ section.settings.closing_text }}
        </div>
      {% endif %}
    </div>

    {% if section.settings.disclaimer != blank %}
      <p class="bojax-curriculum__disclaimer">
        {{ section.settings.disclaimer }}
      </p>
    {% endif %}

    {% if section.settings.button_text != blank %}
      <div class="bojax-curriculum__actions">
        <a
          class="bojax-curriculum__button"
          href="{% if section.settings.button_link != blank %}{{ section.settings.button_link }}{% else %}/products/bojax-course{% endif %}"
        >
          <span>{{ section.settings.button_text }}</span>

          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path
              d="M4 10h11M11 5l5 5-5 5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .bojax-curriculum {
    --bojax-gold: #d8b86a;
    --bojax-gold-light: #f2d995;
    --bojax-gold-pale: #fff1c4;
    --bojax-gold-soft: rgba(216, 184, 106, 0.11);
    --bojax-green: #4ce47a;

    position: relative;
    overflow: hidden;
    padding: 9rem 0;
    background:
      radial-gradient(
        circle at 50% 0,
        rgba(216, 184, 106, 0.12),
        transparent 34rem
      ),
      linear-gradient(
        180deg,
        #030303 0%,
        #090806 48%,
        #030303 100%
      );
    color: #ffffff;
  }

  .bojax-curriculum::before {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 1px;
    background:
      linear-gradient(
        90deg,
        transparent,
        var(--bojax-gold),
        rgba(255, 255, 255, 0.85),
        var(--bojax-gold),
        transparent
      );
    content: "";
    opacity: 0.75;
  }

  .bojax-curriculum__ambient {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .bojax-curriculum__ambient-orb {
    position: absolute;
    display: block;
    border-radius: 50%;
    background: var(--bojax-gold);
    filter: blur(10rem);
  }

  .bojax-curriculum__ambient-orb--left {
    top: 16rem;
    left: -24rem;
    width: 48rem;
    height: 48rem;
    opacity: 0.12;
  }

  .bojax-curriculum__ambient-orb--right {
    right: -25rem;
    bottom: 35rem;
    width: 50rem;
    height: 50rem;
    opacity: 0.09;
  }

  .bojax-curriculum__ambient-lines {
    position: absolute;
    inset: 0;
    opacity: 0.06;
    background-image:
      linear-gradient(
        rgba(216, 184, 106, 0.5) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(216, 184, 106, 0.5) 1px,
        transparent 1px
      );
    background-size: 7rem 7rem;
    mask-image: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.8),
      transparent 75%
    );
    -webkit-mask-image: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.8),
      transparent 75%
    );
  }

  .bojax-curriculum__container {
    position: relative;
    z-index: 2;
    width: min(calc(100% - 4rem), 122rem);
    margin: 0 auto;
  }

  .bojax-curriculum__header {
    max-width: 90rem;
    margin: 0 auto;
    text-align: center;
  }

  .bojax-curriculum__eyebrow {
    display: flex;
    margin: 0 0 2rem;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    color: var(--bojax-gold-light);
    font-size: 1rem;
    font-weight: 850;
    letter-spacing: 0.34em;
    line-height: 1;
    text-transform: uppercase;
  }

  .bojax-curriculum__eyebrow > span {
    width: 4rem;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--bojax-gold)
    );
  }

  .bojax-curriculum__eyebrow > span:last-child {
    background: linear-gradient(
      90deg,
      var(--bojax-gold),
      transparent
    );
  }

  .bojax-curriculum__heading {
    margin: 0;
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(4.5rem, 7.5vw, 8.2rem);
    font-weight: 500;
    letter-spacing: -0.062em;
    line-height: 0.93;
    text-wrap: balance;
  }

  .bojax-curriculum__description {
    max-width: 76rem;
    margin: 2.4rem auto 0;
    color: rgba(255, 255, 255, 0.65);
    font-size: clamp(1.5rem, 2vw, 1.9rem);
    line-height: 1.65;
  }

  .bojax-curriculum__description p,
  .bojax-curriculum__intro-description p,
  .bojax-topic-card__description p,
  .bojax-curriculum__closing-text p {
    margin: 0;
  }

  .bojax-curriculum__badge {
    display: inline-flex;
    max-width: 100%;
    margin-top: 2.7rem;
    padding: 1rem 1.5rem;
    align-items: center;
    gap: 0.9rem;
    border: 1px solid rgba(216, 184, 106, 0.26);
    border-radius: 99rem;
    background: rgba(216, 184, 106, 0.07);
    color: rgba(255, 255, 255, 0.83);
    font-size: 1.13rem;
    font-weight: 700;
  }

  .bojax-curriculum__badge-check {
    display: grid;
    flex: 0 0 2.1rem;
    width: 2.1rem;
    height: 2.1rem;
    place-items: center;
    border-radius: 50%;
    background: var(--bojax-green);
    color: #031108;
  }

  .bojax-curriculum__badge-check svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  /* Statistics */

  .bojax-curriculum__stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 5rem;
    overflow: hidden;
    border: 1px solid rgba(216, 184, 106, 0.3);
    border-radius: 2.4rem;
    background:
      linear-gradient(
        145deg,
        rgba(216, 184, 106, 0.1),
        rgba(255, 255, 255, 0.02)
      );
    box-shadow:
      0 3rem 9rem rgba(0, 0, 0, 0.38),
      inset 0 1px rgba(255, 255, 255, 0.05);
  }

  .bojax-curriculum__stat {
    display: grid;
    min-width: 0;
    min-height: 16rem;
    padding: 2.5rem 1.3rem;
    place-content: center;
    gap: 0.9rem;
    text-align: center;
  }

  .bojax-curriculum__stat + .bojax-curriculum__stat {
    border-left: 1px solid rgba(216, 184, 106, 0.18);
  }

  .bojax-curriculum__stat strong {
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3.5rem, 5vw, 5.3rem);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 0.95;
  }

  .bojax-curriculum__stat > span {
    color: var(--bojax-gold-light);
    font-size: 0.95rem;
    font-weight: 850;
    letter-spacing: 0.17em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .bojax-curriculum__stat small {
    color: rgba(255, 255, 255, 0.4);
    font-size: 1rem;
    line-height: 1.4;
  }

  /* Curriculum introduction */

  .bojax-curriculum__intro {
    display: flex;
    margin-top: 7rem;
    padding-bottom: 3rem;
    align-items: flex-end;
    justify-content: space-between;
    gap: 3rem;
    border-bottom: 1px solid rgba(216, 184, 106, 0.25);
  }

  .bojax-curriculum__intro-copy {
    max-width: 80rem;
  }

  .bojax-curriculum__intro-eyebrow {
    margin: 0 0 1.5rem;
    color: var(--bojax-gold-light);
    font-size: 1rem;
    font-weight: 850;
    letter-spacing: 0.3em;
    line-height: 1;
    text-transform: uppercase;
  }

  .bojax-curriculum__intro-heading {
    margin: 0;
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3.8rem, 6vw, 6.4rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .bojax-curriculum__intro-description {
    max-width: 72rem;
    margin-top: 1.7rem;
    color: rgba(255, 255, 255, 0.6);
    font-size: 1.48rem;
    line-height: 1.65;
  }

  .bojax-curriculum__topic-count {
    display: grid;
    flex: 0 0 auto;
    min-width: 18rem;
    padding: 1.7rem;
    gap: 0.5rem;
    border: 1px solid rgba(216, 184, 106, 0.3);
    border-radius: 1.7rem;
    background: rgba(216, 184, 106, 0.08);
    text-align: center;
  }

  .bojax-curriculum__topic-count strong {
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 3.2rem;
    line-height: 1;
  }

  .bojax-curriculum__topic-count span {
    color: var(--bojax-gold-light);
    font-size: 0.86rem;
    font-weight: 850;
    letter-spacing: 0.15em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  /* Two-column topic grid */

  .bojax-curriculum__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 2.2rem;
    gap: 1.4rem;
  }

  .bojax-topic-card {
    position: relative;
    min-width: 0;
    padding: 2.4rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 2rem;
    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.055),
        rgba(255, 255, 255, 0.014)
      );
    box-shadow: 0 2rem 6rem rgba(0, 0, 0, 0.22);
    transition:
      border-color 180ms ease,
      transform 180ms ease,
      background 180ms ease;
  }

  .bojax-topic-card:hover {
    border-color: rgba(216, 184, 106, 0.42);
    background:
      linear-gradient(
        145deg,
        rgba(216, 184, 106, 0.085),
        rgba(255, 255, 255, 0.018)
      );
    transform: translateY(-0.25rem);
  }

  .bojax-topic-card--featured {
    border-color: rgba(216, 184, 106, 0.48);
    background:
      linear-gradient(
        145deg,
        rgba(216, 184, 106, 0.11),
        rgba(255, 255, 255, 0.018)
      );
  }

  .bojax-topic-card__top {
    display: grid;
    grid-template-columns:
      3rem minmax(0, 1fr) auto;
    align-items: start;
    gap: 1.2rem;
  }

  .bojax-topic-card__main-check {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border-radius: 50%;
    background: var(--bojax-green);
    color: #031108;
    box-shadow: 0 0 2.3rem rgba(76, 228, 122, 0.2);
  }

  .bojax-topic-card__main-check svg {
    width: 1.7rem;
    height: 1.7rem;
  }

  .bojax-topic-card__heading {
    min-width: 0;
  }

  .bojax-topic-card__category {
    margin: 0 0 0.6rem;
    color: var(--bojax-gold-light);
    font-size: 0.85rem;
    font-weight: 850;
    letter-spacing: 0.17em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .bojax-topic-card__title {
    margin: 0;
    color: #ffffff;
    font-size: 1.75rem;
    font-weight: 850;
    letter-spacing: -0.026em;
    line-height: 1.22;
  }

  .bojax-topic-card__lesson-count {
    padding: 0.62rem 0.8rem;
    border: 1px solid rgba(216, 184, 106, 0.27);
    border-radius: 99rem;
    background: rgba(216, 184, 106, 0.07);
    color: var(--bojax-gold-light);
    font-size: 0.77rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    white-space: nowrap;
    text-transform: uppercase;
  }

  .bojax-topic-card__description {
    margin: 1.35rem 0 0 4.2rem;
    color: rgba(255, 255, 255, 0.53);
    font-size: 1.27rem;
    line-height: 1.58;
  }

  .bojax-topic-card__included {
    display: grid;
    margin: 1.6rem 0 0 4.2rem;
    gap: 0.95rem;
  }

  .bojax-topic-card__included-item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    color: rgba(255, 255, 255, 0.79);
    font-size: 1.16rem;
    line-height: 1.43;
  }

  .bojax-topic-card__small-check {
    display: grid;
    flex: 0 0 1.7rem;
    width: 1.7rem;
    height: 1.7rem;
    margin-top: 0.04rem;
    place-items: center;
    color: var(--bojax-green);
  }

  .bojax-topic-card__small-check svg {
    width: 1.35rem;
    height: 1.35rem;
  }

  .bojax-curriculum__empty {
    margin-top: 2.2rem;
    padding: 3rem 2rem;
    border: 1px solid rgba(216, 184, 106, 0.35);
    border-radius: 2rem;
    background: rgba(216, 184, 106, 0.08);
    text-align: center;
  }

  .bojax-curriculum__empty h3 {
    margin: 0;
    color: #ffffff;
    font-size: 2.2rem;
  }

  .bojax-curriculum__empty p {
    max-width: 60rem;
    margin: 1rem auto 0;
    color: rgba(255, 255, 255, 0.62);
    font-size: 1.3rem;
    line-height: 1.6;
  }

  /* Closing */

  .bojax-curriculum__closing {
    margin-top: 4.5rem;
    padding: 3.4rem;
    border: 1px solid rgba(216, 184, 106, 0.32);
    border-radius: 2.3rem;
    background:
      linear-gradient(
        135deg,
        rgba(216, 184, 106, 0.12),
        rgba(255, 255, 255, 0.018)
      );
    text-align: center;
  }

  .bojax-curriculum__closing-eyebrow {
    margin: 0 0 1.1rem;
    color: var(--bojax-gold-light);
    font-size: 0.94rem;
    font-weight: 850;
    letter-spacing: 0.23em;
    text-transform: uppercase;
  }

  .bojax-curriculum__closing-heading {
    margin: 0;
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3rem, 5vw, 5rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .bojax-curriculum__closing-text {
    max-width: 72rem;
