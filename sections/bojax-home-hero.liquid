<section
  id="BojaxHero-{{ section.id }}"
  class="bojax-course-hero"
  style="
    --bojax-hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --bojax-mobile-position: {{ section.settings.mobile_image_position }};
    --bojax-desktop-position: {{ section.settings.desktop_image_position }};
  "
>
  <div class="bojax-course-hero__media">
    {% if section.settings.mobile_image != blank %}
      <picture>
        <source
          media="(max-width: 749px)"
          srcset="
            {{ section.settings.mobile_image | image_url: width: 500 }} 500w,
            {{ section.settings.mobile_image | image_url: width: 750 }} 750w,
            {{ section.settings.mobile_image | image_url: width: 1000 }} 1000w
          "
          sizes="100vw"
        >

        {% if section.settings.desktop_image != blank %}
          {{
            section.settings.desktop_image
            | image_url: width: 2200
            | image_tag:
              class: 'bojax-course-hero__image',
              loading: 'eager',
              fetchpriority: 'high',
              widths: '750, 1100, 1500, 1800, 2200',
              sizes: '100vw',
              alt: section.settings.desktop_image.alt
          }}
        {% else %}
          {{
            section.settings.mobile_image
            | image_url: width: 1400
            | image_tag:
              class: 'bojax-course-hero__image',
              loading: 'eager',
              fetchpriority: 'high',
              widths: '500, 750, 1000, 1400',
              sizes: '100vw',
              alt: section.settings.mobile_image.alt
          }}
        {% endif %}
      </picture>
    {% elsif section.settings.desktop_image != blank %}
      {{
        section.settings.desktop_image
        | image_url: width: 2200
        | image_tag:
          class: 'bojax-course-hero__image',
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750, 1100, 1500, 1800, 2200',
          sizes: '100vw',
          alt: section.settings.desktop_image.alt
      }}
    {% else %}
      <div class="bojax-course-hero__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      </div>
    {% endif %}

    <div class="bojax-course-hero__overlay"></div>

    {% if section.settings.brand_label != blank %}
      <p class="bojax-course-hero__brand">
        {{ section.settings.brand_label }}
      </p>
    {% endif %}
  </div>

  <div class="bojax-course-hero__content-wrap">
    <div class="bojax-course-hero__content">
      {% if section.settings.heading != blank %}
        <h1 class="bojax-course-hero__heading">
          {{ section.settings.heading }}
        </h1>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="bojax-course-hero__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

      {% if section.settings.button_text != blank %}
        <a
          class="bojax-course-hero__button"
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link"
            aria-disabled="true"
          {% endif %}
        >
          <span>{{ section.settings.button_text }}</span>

          <svg
            aria-hidden="true"
            viewBox="0 0 20 20"
            width="20"
            height="20"
          >
            <path
              d="M4 10h11M11 5l5 5-5 5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      {% endif %}

      {% if section.settings.payment_note != blank %}
        <p class="bojax-course-hero__payment-note">
          {{ section.settings.payment_note }}
        </p>
      {% endif %}

      {% if section.settings.proof_text != blank %}
        <div class="bojax-course-hero__proof">
          {% if section.settings.show_stars %}
            <span
              class="bojax-course-hero__stars"
              aria-label="Five stars"
            >
              ★★★★★
            </span>
          {% endif %}

          <span>{{ section.settings.proof_text }}</span>
        </div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="bojax-course-hero__trust">
          {% for block in section.blocks %}
            <div
              class="bojax-course-hero__trust-item"
              {{ block.shopify_attributes }}
            >
              <span class="bojax-course-hero__trust-icon">
                {% case block.settings.icon %}
                  {% when 'bolt' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        d="M13.2 2 5 13h6l-.2 9L19 10h-6l.2-8Z"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                        stroke-linejoin="round"
                      />
                    </svg>
                  {% when 'lock' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <rect
                        x="5"
                        y="10"
                        width="14"
                        height="10"
                        rx="2"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                      />
                      <path
                        d="M8 10V7a4 4 0 0 1 8 0v3"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                        stroke-linecap="round"
                      />
                    </svg>
                  {% when 'infinity' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        d="M8.5 8.5c-2.2 0-4 1.6-4 3.5s1.8 3.5 4 3.5c3.5 0 4.9-7 7.5-7 2 0 3.5 1.6 3.5 3.5s-1.5 3.5-3.5 3.5c-3 0-4.6-7-7.5-7Z"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  {% when 'play' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <circle
                        cx="12"
                        cy="12"
                        r="9"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                      />
                      <path
                        d="m10 8 6 4-6 4V8Z"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                        stroke-linejoin="round"
                      />
                    </svg>
                  {% when 'star' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                        stroke-linejoin="round"
                      />
                    </svg>
                  {% else %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <circle
                        cx="12"
                        cy="12"
                        r="9"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                      />
                      <path
                        d="m8 12 2.5 2.5L16 9"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                {% endcase %}
              </span>

              <span class="bojax-course-hero__trust-text">
                {{ block.settings.text }}
              </span>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .bojax-course-hero {
    overflow: hidden;
    background: #000;
    color: #fff;
  }

  .bojax-course-hero__media {
    position: relative;
    height: min(68vw, 760px);
    min-height: 520px;
    overflow: hidden;
    background: #080808;
  }

  .bojax-course-hero__media picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .bojax-course-hero__image,
  .bojax-course-hero__placeholder,
  .bojax-course-hero__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .bojax-course-hero__image {
    object-fit: cover;
    object-position: var(--bojax-desktop-position, center center);
    filter: grayscale(1) contrast(1.08);
    transform: scale(1.01);
  }

  .bojax-course-hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.12) 0%,
        rgba(0, 0, 0, 0.02) 52%,
        rgba(0, 0, 0, 0.66) 100%
      ),
      rgba(0, 0, 0, var(--bojax-hero-overlay, 0.05));
    pointer-events: none;
  }

  .bojax-course-hero__brand {
    position: absolute;
    top: 34px;
    left: 50%;
    z-index: 2;
    margin: 0;
    color: #fff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.65rem;
    font-weight: 600;
    letter-spacing: 0.34em;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    transform: translateX(-50%);
  }

  .bojax-course-hero__content-wrap {
    position: relative;
    z-index: 3;
    margin-top: -76px;
    padding: 0 20px 82px;
  }

  .bojax-course-hero__content {
    width: min(100%, 780px);
    margin: 0 auto;
    padding: 62px 42px 30px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 30px;
    background:
      linear-gradient(
        180deg,
        rgba(12, 12, 12, 0.96),
        #000 34%
      );
    box-shadow: 0 -20px 70px rgba(0, 0, 0, 0.52);
    text-align: center;
  }

  .bojax-course-hero__heading {
    max-width: 720px;
    margin: 0 auto;
    color: #fff;
    font-size: clamp(4.8rem, 7vw, 8rem);
    font-weight: 900;
    letter-spacing: -0.065em;
    line-height: 0.92;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .bojax-course-hero__description {
    max-width: 650px;
    margin: 24px auto 0;
    color: rgba(255, 255, 255, 0.7);
    font-size: clamp(1.55rem, 2vw, 1.9rem);
    line-height: 1.65;
  }

  .bojax-course-hero__description p {
    margin: 0;
  }

  .bojax-course-hero__button {
    display: inline-flex;
    width: min(100%, 600px);
    min-height: 64px;
    margin-top: 30px;
    padding: 15px 30px;
    align-items: center;
    justify-content: center;
    gap: 12px;
    border: 1px solid #fff;
    border-radius: 14px;
    background: #fff;
    color: #000;
    font-size: 1.55rem;
    font-weight: 850;
    letter-spacing: 0.01em;
    line-height: 1;
    text-decoration: none;
    box-shadow: 0 18px 55px rgba(255, 255, 255, 0.12);
    transition:
      background 180ms ease,
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .bojax-course-hero__button:hover {
    background: #e9e9e9;
    color: #000;
    box-shadow: 0 24px 65px rgba(255, 255, 255, 0.18);
    transform: translateY(-2px);
  }

  .bojax-course-hero__button svg {
    flex: 0 0 auto;
    transition: transform 180ms ease;
  }

  .bojax-course-hero__button:hover svg {
    transform: translateX(4px);
  }

  .bojax-course-hero__payment-note {
    margin: 16px 0 0;
    color: rgba(255, 255, 255, 0.53);
    font-size: 1.25rem;
    letter-spacing: 0.02em;
  }

  .bojax-course-hero__proof {
    display: flex;
    margin-top: 12px;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 9px;
    color: rgba(255, 255, 255, 0.82);
    font-size: 1.35rem;
    font-weight: 700;
  }

  .bojax-course-hero__stars {
    color: #fff;
    font-size: 1.35rem;
    letter-spacing: 0.12em;
  }

  .bojax-course-hero__trust {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 650px;
    margin: 18px auto 0;
    padding-top: 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.11);
  }

  .bojax-course-hero__trust-item {
    display: grid;
    padding: 0 14px;
    justify-items: center;
    gap: 9px;
  }

  .bojax-course-hero__trust-item + .bojax-course-hero__trust-item {
    border-left: 1px solid rgba(255, 255, 255, 0.11);
  }

  .bojax-course-hero__trust-icon {
    display: grid;
    width: 35px;
    height: 35px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 50%;
    color: #fff;
  }

  .bojax-course-hero__trust-icon svg {
    width: 18px;
    height: 18px;
  }

  .bojax-course-hero__trust-text {
    color: rgba(255, 255, 255, 0.72);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.3;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .bojax-course-hero__media {
      height: auto;
      min-height: 0;
      aspect-ratio: 4 / 4.15;
      border-radius: 0 0 28px 28px;
    }

    .bojax-course-hero__image {
      object-position: var(--bojax-mobile-position, center center);
    }

    .bojax-course-hero__brand {
      top: 24px;
      max-width: calc(100% - 30px);
      font-size: 1.18rem;
      letter-spacing: 0.28em;
    }

    .bojax-course-hero__content-wrap {
      margin-top: -36px;
      padding: 0 14px 60px;
    }

    .bojax-course-hero__content {
      padding: 58px 18px 26px;
      border-radius: 26px;
    }

    .bojax-course-hero__heading {
      font-size: clamp(4.3rem, 13vw, 6.2rem);
      line-height: 0.94;
    }

    .bojax-course-hero__description {
      margin-top: 20px;
      font-size: 1.48rem;
    }

    .bojax-course-hero__button {
      width: 100%;
      min-height: 60px;
      margin-top: 26px;
      border-radius: 13px;
      font-size: 1.45rem;
    }

    .bojax-course-hero__payment-note {
      margin-top: 14px;
      font-size: 1.2rem;
    }

    .bojax-course-hero__proof {
      margin-top: 10px;
      font-size: 1.25rem;
      gap: 8px;
    }

    .bojax-course-hero__stars {
      font-size: 1.2rem;
    }

    .bojax-course-hero__trust {
      margin-top: 16px;
      padding-top: 16px;
      gap: 0;
    }

    .bojax-course-hero__trust-item {
      padding: 0 7px;
    }

    .bojax-course-hero__trust-icon {
      width: 32px;
      height: 32px;
    }

    .bojax-course-hero__trust-text {
      font-size: 1rem;
    }
  }

  @media screen and (max-width: 380px) {
    .bojax-course-hero__heading {
      font-size: 4rem;
    }

    .bojax-course-hero__brand {
      font-size: 1.05rem;
      letter-spacing: 0.24em;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bojax premium hero",
  "tag": "section",
  "class": "bojax-premium-hero-section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Optional. Use a portrait image for phones."
    },
    {
      "type": "select",
      "id": "desktop_image_position",
      "label": "Desktop image position",
      "default": "center center",
      "options": [
        { "value": "center top", "label": "Top" },
        { "value": "center center", "label": "Center" },
        { "value": "center bottom", "label": "Bottom" },
        { "value": "left center", "label": "Left" },
        { "value": "right center", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_image_position",
      "label": "Mobile image position",
      "default": "center center",
      "options": [
        { "value": "center top", "label": "Top" },
        { "value": "center center", "label": "Center" },
        { "value": "center bottom", "label": "Bottom" },
        { "value": "left center", "label": "Left" },
        { "value": "right center", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "%",
      "label": "Image darkening",
      "default": 5
    },
    {
      "type": "text",
      "id": "brand_label",
      "label": "Text at top of image",
      "default": "THE BOJAX METHOD"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Main heading",
      "default": "Get the real methods to ascend"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>The step-by-step system for improving your face, hair, style, physique, and overall appearance.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Get instant access"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "payment_note",
      "label": "Text below button",
      "default": "One-time payment • Instant access"
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Show five stars",
      "default": true
    },
    {
      "type": "text",
      "id": "proof_text",
      "label": "Social proof text",
      "default": "650+ students",
      "info": "Only use customer or student numbers that are accurate."
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "bolt",
          "options": [
            { "value": "bolt", "label": "Instant access" },
            { "value": "lock", "label": "Secure" },
            { "value": "infinity", "label": "Lifetime" },
            { "value": "play", "label": "Video" },
            { "value": "star", "label": "Star" },
            { "value": "check", "label": "Checkmark" }
          ]
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Instant access"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bojax premium hero",
      "blocks": [
        {
          "type": "trust_item",
          "settings": {
            "icon": "bolt",
            "text": "Instant access"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "lock",
            "text": "One-time payment"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "infinity",
            "text": "Lifetime updates"
          }
        }
      ]
    }
  ]
}
{% endschema %}
