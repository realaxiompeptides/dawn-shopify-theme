<script>
  (() => {
    const initializeTestimonials = (section) => {
      if (!section) return;

      const previousInstance = section.bojaxTestimonialsInstance;

      if (previousInstance && previousInstance.destroy) {
        previousInstance.destroy();
      }

      const track = section.querySelector('[data-testimonials-track]');
      const previousButton = section.querySelector('[data-testimonials-prev]');
      const nextButton = section.querySelector('[data-testimonials-next]');
      const progressBar = section.querySelector('[data-testimonials-progress]');

      if (!track || !previousButton || !nextButton) return;

      const autoplayEnabled = section.dataset.autoplay === 'true';
      const autoplaySpeed =
        Number(section.dataset.autoplaySpeed) || 6000;

      let autoplayTimer = null;
      let resizeTimer = null;
      let isPaused = false;

      const cards = Array.from(
        track.querySelectorAll('.bojax-testimonials__card')
      );

      const getGap = () => {
        const styles = window.getComputedStyle(track);
        return Number.parseFloat(styles.columnGap || styles.gap) || 0;
      };

      const getScrollStep = () => {
        const firstCard = cards[0];

        if (!firstCard) return track.clientWidth;

        return firstCard.getBoundingClientRect().width + getGap();
      };

      const getMaximumScroll = () =>
        Math.max(0, track.scrollWidth - track.clientWidth);

      const updateControls = () => {
        const maximumScroll = getMaximumScroll();
        const currentScroll = track.scrollLeft;

        previousButton.disabled = currentScroll <= 2;
        nextButton.disabled = currentScroll >= maximumScroll - 2;

        if (progressBar) {
          const percentage =
            maximumScroll > 0
              ? Math.min(100, (currentScroll / maximumScroll) * 100)
              : 100;

          progressBar.style.width = `${percentage}%`;
        }
      };

      const scrollPrevious = () => {
        track.scrollBy({
          left: -getScrollStep(),
          behavior: 'smooth'
        });
      };

      const scrollNext = () => {
        const maximumScroll = getMaximumScroll();

        if (track.scrollLeft >= maximumScroll - 4) {
          track.scrollTo({
            left: 0,
            behavior: 'smooth'
          });

          return;
        }

        track.scrollBy({
          left: getScrollStep(),
          behavior: 'smooth'
        });
      };

      const stopAutoplay = () => {
        if (autoplayTimer) {
          window.clearInterval(autoplayTimer);
          autoplayTimer = null;
        }
      };

      const startAutoplay = () => {
        stopAutoplay();

        if (
          !autoplayEnabled ||
          isPaused ||
          cards.length <= 1 ||
          window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          return;
        }

        autoplayTimer = window.setInterval(
          scrollNext,
          autoplaySpeed
        );
      };

      const pauseAutoplay = () => {
        isPaused = true;
        stopAutoplay();
      };

      const resumeAutoplay = () => {
        isPaused = false;
        startAutoplay();
      };

      const onResize = () => {
        window.clearTimeout(resizeTimer);

        resizeTimer = window.setTimeout(() => {
          updateControls();
          startAutoplay();
        }, 120);
      };

      previousButton.addEventListener('click', scrollPrevious);
      nextButton.addEventListener('click', scrollNext);
      track.addEventListener('scroll', updateControls, { passive: true });
      track.addEventListener('mouseenter', pauseAutoplay);
      track.addEventListener('mouseleave', resumeAutoplay);
      track.addEventListener('focusin', pauseAutoplay);
      track.addEventListener('focusout', resumeAutoplay);
      track.addEventListener('touchstart', pauseAutoplay, { passive: true });
      track.addEventListener('touchend', resumeAutoplay, { passive: true });
      window.addEventListener('resize', onResize);

      updateControls();
      startAutoplay();

      section.bojaxTestimonialsInstance = {
        destroy() {
          stopAutoplay();
          window.clearTimeout(resizeTimer);

          previousButton.removeEventListener('click', scrollPrevious);
          nextButton.removeEventListener('click', scrollNext);
          track.removeEventListener('scroll', updateControls);
          track.removeEventListener('mouseenter', pauseAutoplay);
          track.removeEventListener('mouseleave', resumeAutoplay);
          track.removeEventListener('focusin', pauseAutoplay);
          track.removeEventListener('focusout', resumeAutoplay);
          track.removeEventListener('touchstart', pauseAutoplay);
          track.removeEventListener('touchend', resumeAutoplay);
          window.removeEventListener('resize', onResize);
        }
      };
    };

    const initializeAllTestimonials = (root = document) => {
      if (
        root.matches &&
        root.matches('[data-bojax-testimonials]')
      ) {
        initializeTestimonials(root);
      }

      if (root.querySelectorAll) {
        root
          .querySelectorAll('[data-bojax-testimonials]')
          .forEach(initializeTestimonials);
      }
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        initializeAllTestimonials(document);
      });
    } else {
      initializeAllTestimonials(document);
    }

    document.addEventListener('shopify:section:load', (event) => {
      initializeAllTestimonials(event.target);
    });

    document.addEventListener('shopify:section:unload', (event) => {
      let section = null;

      if (
        event.target.matches &&
        event.target.matches('[data-bojax-testimonials]')
      ) {
        section = event.target;
      } else if (event.target.querySelector) {
        section = event.target.querySelector(
          '[data-bojax-testimonials]'
        );
      }

      if (
        section &&
        section.bojaxTestimonialsInstance &&
        section.bojaxTestimonialsInstance.destroy
      ) {
        section.bojaxTestimonialsInstance.destroy();
      }
    });
  })();
</script>

