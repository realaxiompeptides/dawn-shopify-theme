{%- liquid
  assign section_heading = section.settings.heading | default: 'What members are saying'
  assign section_eyebrow = section.settings.eyebrow | default: 'REAL MEMBER FEEDBACK'
  assign section_description = section.settings.description
  assign card_count = section.blocks.size
-%}

<section
  id="BojaxTestimonials-{{ section.id }}"
  class="bojax-testimonials"
  data-bojax-testimonials
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
  style="
    --bojax-testimonials-top: {{ section.settings.padding_top }}px;
    --bojax-testimonials-bottom: {{ section.settings.padding_bottom }}px;
    --bojax-testimonials-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --bojax-testimonials-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="bojax-testimonials__ambient" aria-hidden="true">
    <span class="bojax-testimonials__glow bojax-testimonials__glow--left"></span>
    <span class="bojax-testimonials__glow bojax-testimonials__glow--right"></span>
    <span class="bojax-testimonials__grid"></span>
  </div>

  <div class="bojax-testimonials__container">
    <header class="bojax-testimonials__header">
      {% if section_eyebrow != blank %}
        <p class="bojax-testimonials__eyebrow">
          {{ section_eyebrow }}
        </p>
      {% endif %}

      {% if section_heading != blank %}
        <h2 class="bojax-testimonials__heading">
          {{ section_heading }}
        </h2>
      {% endif %}

      {% if section_description != blank %}
        <div class="bojax-testimonials__description">
          {{ section_description }}
        </div>
      {% endif %}
    </header>

    {% if card_count > 0 %}
      <div class="bojax-testimonials__carousel">
        <div class="bojax-testimonials__controls">
          <p class="bojax-testimonials__count">
            <span>{{ card_count }}</span>
            member reviews
          </p>

          <div class="bojax-testimonials__arrows">
            <button
              type="button"
              class="bojax-testimonials__arrow"
              data-testimonials-prev
              aria-label="Show previous testimonials"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M14.5 5 7.5 12l7 7"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.9"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>

            <button
              type="button"
              class="bojax-testimonials__arrow"
              data-testimonials-next
              aria-label="Show next testimonials"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="m9.5 5 7 7-7 7"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.9"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
          </div>
        </div>

        <div
          class="bojax-testimonials__track"
          data-testimonials-track
          role="list"
          aria-label="Member testimonials"
        >
          {% for block in section.blocks %}
            {%- liquid
              assign reviewer_name = block.settings.name | default: 'Member name'
              assign reviewer_initial = reviewer_name | strip | slice: 0, 1 | upcase
              assign review_text = block.settings.review
            -%}

            <article
              class="bojax-testimonials__card{% if block.settings.image != blank %} bojax-testimonials__card--with-image{% endif %}{% if block.settings.featured %} bojax-testimonials__card--featured{% endif %}"
              role="listitem"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.image != blank %}
                <div class="bojax-testimonials__media bojax-testimonials__media--{{ section.settings.image_ratio }}">
                  {{
                    block.settings.image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      widths: '360, 540, 720, 960, 1200',
                      sizes: '(max-width: 749px) 88vw, (max-width: 989px) 46vw, 31vw',
                      class: 'bojax-testimonials__image',
                      alt: block.settings.image.alt
                  }}

                  {% if block.settings.image_label != blank %}
                    <span class="bojax-testimonials__image-label">
                      {{ block.settings.image_label }}
                    </span>
                  {% endif %}
                </div>
              {% endif %}

              <div class="bojax-testimonials__card-body">
                <div class="bojax-testimonials__card-top">
                  {% if section.settings.show_stars %}
                    <div
                      class="bojax-testimonials__stars"
                      aria-label="{{ block.settings.rating }} out of 5 stars"
                    >
                      {% for star in (1..5) %}
                        <svg
                          viewBox="0 0 20 20"
                          aria-hidden="true"
                          class="{% if star <= block.settings.rating %}is-filled{% endif %}"
                        >
                          <path d="m10 1.7 2.48 5.03 5.55.8-4.01 3.92.95 5.52L10 14.36l-4.97 2.61.95-5.52-4.01-3.92 5.55-.8L10 1.7Z"/>
                        </svg>
                      {% endfor %}
                    </div>
                  {% endif %}

                  <span class="bojax-testimonials__quote-mark" aria-hidden="true">
                    “
                  </span>
                </div>

                {% if block.settings.review_title != blank %}
                  <h3 class="bojax-testimonials__review-title">
                    {{ block.settings.review_title }}
                  </h3>
                {% endif %}

                {% if review_text != blank %}
                  <blockquote class="bojax-testimonials__review">
                    {{ review_text }}
                  </blockquote>
                {% endif %}

                <footer class="bojax-testimonials__reviewer">
                  <span class="bojax-testimonials__avatar" aria-hidden="true">
                    {{ reviewer_initial }}
                  </span>

                  <span class="bojax-testimonials__reviewer-copy">
                    <strong>{{ reviewer_name }}</strong>

                    {% if block.settings.member_details != blank %}
                      <span>{{ block.settings.member_details }}</span>
                    {% endif %}
                  </span>

                  {% if block.settings.verified %}
                    <span
                      class="bojax-testimonials__verified"
                      title="Verified member"
                      aria-label="Verified member"
                    >
                      <svg viewBox="0 0 20 20" aria-hidden="true">
                        <path
                          d="m10 1.8 2.1 1.42 2.52-.17.8 2.4 2.12 1.4-.8 2.4.8 2.4-2.12 1.4-.8 2.4-2.52-.17L10 18.2l-2.1-1.42-2.52.17-.8-2.4-2.12-1.4.8-2.4-.8-2.4 2.12-1.4.8-2.4 2.52.17L10 1.8Z"
                          fill="currentColor"
                        />
                        <path
                          d="m6.9 10.1 2 2 4.2-4.35"
                          fill="none"
                          stroke="#070704"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </span>
                  {% endif %}
                </footer>
              </div>
            </article>
          {% endfor %}
        </div>

        <div class="bojax-testimonials__progress" aria-hidden="true">
          <span data-testimonials-progress></span>
        </div>

        <p class="bojax-testimonials__swipe-hint">
          Swipe to read more reviews
          <span aria-hidden="true">→</span>
        </p>
      </div>
    {% else %}
      <div class="bojax-testimonials__empty">
        Add testimonial blocks in the theme editor.
      </div>
    {% endif %}

    {% if section.settings.button_text != blank %}
      <div class="bojax-testimonials__cta">
        <a
          class="bojax-testimonials__button"
          href="{% if section.settings.button_link != blank %}{{ section.settings.button_link }}{% else %}/products/bojax-course{% endif %}"
        >
          <span>{{ section.settings.button_text }}</span>

          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path
              d="M4 10h11M11 5l5 5-5 5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>

        {% if section.settings.button_note != blank %}
          <p class="bojax-testimonials__button-note">
            {{ section.settings.button_note }}
          </p>
        {% endif %}
      </div>
    {% endif %}

    {% if section.settings.disclaimer != blank %}
      <p class="bojax-testimonials__disclaimer">
        {{ section.settings.disclaimer }}
      </p>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .bojax-testimonials {
    --bojax-review-gold: #d8b86a;
    --bojax-review-gold-light: #f3d990;
    --bojax-review-cream: #fff3d0;
    --bojax-review-green: #58e786;

    position: relative;
    overflow: hidden;
    padding-top: var(--bojax-testimonials-top, 56px);
    padding-bottom: var(--bojax-testimonials-bottom, 64px);
    background:
      radial-gradient(
        circle at 50% 0,
        rgba(216, 184, 106, 0.15),
        transparent 35rem
      ),
      linear-gradient(180deg, #030303 0%, #090806 52%, #030303 100%);
    color: #ffffff;
  }

  .bojax-testimonials::before {
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(216, 184, 106, 0.72),
        rgba(255, 255, 255, 0.75),
        rgba(216, 184, 106, 0.72),
        transparent
      );
    content: "";
  }

  .bojax-testimonials__ambient {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .bojax-testimonials__glow {
    position: absolute;
    display: block;
    width: 44rem;
    height: 44rem;
    border-radius: 50%;
    background: var(--bojax-review-gold);
    filter: blur(10rem);
  }

  .bojax-testimonials__glow--left {
    top: 6rem;
    left: -25rem;
    opacity: 0.09;
  }

  .bojax-testimonials__glow--right {
    right: -25rem;
    bottom: -4rem;
    opacity: 0.07;
  }

  .bojax-testimonials__grid {
    position: absolute;
    inset: 0;
    opacity: 0.03;
    background-image:
      linear-gradient(
        rgba(216, 184, 106, 0.45) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(216, 184, 106, 0.45) 1px,
        transparent 1px
      );
    background-size: 7rem 7rem;
    -webkit-mask-image:
      linear-gradient(180deg, rgba(0, 0, 0, 0.85), transparent 82%);
    mask-image:
      linear-gradient(180deg, rgba(0, 0, 0, 0.85), transparent 82%);
  }

  .bojax-testimonials__container {
    position: relative;
    z-index: 2;
    width: min(calc(100% - 4rem), 118rem);
    margin: 0 auto;
  }

  .bojax-testimonials__header {
    max-width: 82rem;
    margin: 0 auto;
    text-align: center;
  }

  .bojax-testimonials__eyebrow {
    margin: 0 0 1.3rem;
    color: var(--bojax-review-gold-light);
    font-size: 0.95rem;
    font-weight: 850;
    letter-spacing: 0.3em;
    line-height: 1;
    text-transform: uppercase;
  }

  .bojax-testimonials__heading {
    margin: 0;
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(4rem, 7vw, 7rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.97;
    text-wrap: balance;
  }

  .bojax-testimonials__description {
    max-width: 70rem;
    margin: 2rem auto 0;
    color: rgba(255, 255, 255, 0.62);
    font-size: clamp(1.4rem, 2vw, 1.75rem);
    line-height: 1.65;
  }

  .bojax-testimonials__description p {
    margin: 0;
  }

  .bojax-testimonials__carousel {
    margin-top: 4rem;
  }

  .bojax-testimonials__controls {
    display: flex;
    margin-bottom: 1.8rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .bojax-testimonials__count {
    margin: 0;
    color: rgba(255, 255, 255, 0.48);
    font-size: 1rem;
    font-weight: 760;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .bojax-testimonials__count span {
    color: var(--bojax-review-gold-light);
  }

  .bojax-testimonials__arrows {
    display: flex;
    gap: 0.8rem;
  }

  .bojax-testimonials__arrow {
    display: grid;
    width: 4.4rem;
    height: 4.4rem;
    padding: 0;
    place-items: center;
    border: 1px solid rgba(216, 184, 106, 0.32);
    border-radius: 50%;
    background: rgba(216, 184, 106, 0.07);
    color: var(--bojax-review-gold-light);
    cursor: pointer;
    transition:
      border-color 180ms ease,
      background 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .bojax-testimonials__arrow:hover {
    border-color: var(--bojax-review-gold-light);
    background: rgba(216, 184, 106, 0.16);
    color: #ffffff;
    transform: translateY(-0.1rem);
  }

  .bojax-testimonials__arrow:disabled {
    opacity: 0.28;
    cursor: default;
    transform: none;
  }

  .bojax-testimonials__arrow svg {
    width: 2rem;
    height: 2rem;
  }

  .bojax-testimonials__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 3.2rem) / 3);
    gap: 1.6rem;
    overflow-x: auto;
    padding: 0.4rem 0.2rem 2rem;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-inline: contain;
  }

  .bojax-testimonials__track::-webkit-scrollbar {
    display: none;
  }

  .bojax-testimonials__card {
    display: flex;
    min-width: 0;
    overflow: hidden;
    scroll-snap-align: start;
    flex-direction: column;
    border: 1px solid rgba(216, 184, 106, 0.22);
    border-radius: 2.2rem;
    background:
      radial-gradient(
        circle at 50% 0,
        rgba(216, 184, 106, 0.09),
        transparent 24rem
      ),
      linear-gradient(
        145deg,
        rgba(20, 18, 13, 0.98),
        rgba(6, 6, 5, 0.99)
      );
    box-shadow:
      0 2.4rem 7rem rgba(0, 0, 0, 0.34),
      inset 0 1px rgba(255, 255, 255, 0.035);
  }

  .bojax-testimonials__card--featured {
    border-color: rgba(242, 217, 144, 0.54);
    box-shadow:
      0 2.8rem 8rem rgba(0, 0, 0, 0.42),
      0 0 4rem rgba(216, 184, 106, 0.09),
      inset 0 1px rgba(255, 255, 255, 0.045);
  }

  .bojax-testimonials__media {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid rgba(216, 184, 106, 0.18);
    background: rgba(255, 255, 255, 0.035);
  }

  .bojax-testimonials__media--landscape {
    aspect-ratio: 16 / 10;
  }

  .bojax-testimonials__media--square {
    aspect-ratio: 1 / 1;
  }

  .bojax-testimonials__media--portrait {
    aspect-ratio: 4 / 5;
  }

  .bojax-testimonials__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bojax-testimonials__image-label {
    position: absolute;
    right: 1.2rem;
    bottom: 1.2rem;
    max-width: calc(100% - 2.4rem);
    padding: 0.65rem 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 99rem;
    background: rgba(0, 0, 0, 0.72);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
    backdrop-filter: blur(0.8rem);
  }

  .bojax-testimonials__card-body {
    display: flex;
    flex: 1 1 auto;
    min-height: 34rem;
    padding: 2.4rem;
    flex-direction: column;
  }

  .bojax-testimonials__card--with-image .bojax-testimonials__card-body {
    min-height: 31rem;
  }

  .bojax-testimonials__card-top {
    display: flex;
    min-height: 3rem;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .bojax-testimonials__stars {
    display: flex;
    gap: 0.28rem;
  }

  .bojax-testimonials__stars svg {
    width: 1.55rem;
    height: 1.55rem;
    fill: rgba(255, 255, 255, 0.12);
  }

  .bojax-testimonials__stars svg.is-filled {
    fill: var(--bojax-review-gold-light);
    filter: drop-shadow(0 0 0.65rem rgba(216, 184, 106, 0.26));
  }

  .bojax-testimonials__quote-mark {
    color: rgba(216, 184, 106, 0.28);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 4.7rem;
    line-height: 0.7;
  }

  .bojax-testimonials__review-title {
    margin: 1.7rem 0 0;
    color: #ffffff;
    font-size: 1.55rem;
    font-weight: 830;
    letter-spacing: -0.025em;
    line-height: 1.3;
  }

  .bojax-testimonials__review {
    margin: 1.3rem 0 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 1.28rem;
    line-height: 1.67;
  }

  .bojax-testimonials__reviewer {
    display: flex;
    margin-top: auto;
    padding-top: 2.4rem;
    align-items: center;
    gap: 1rem;
  }

  .bojax-testimonials__avatar {
    display: grid;
    flex: 0 0 4.2rem;
    width: 4.2rem;
    height: 4.2rem;
    place-items: center;
    border: 1px solid rgba(216, 184, 106, 0.32);
    border-radius: 50%;
    background:
      linear-gradient(
        145deg,
        rgba(216, 184, 106, 0.18),
        rgba(216, 184, 106, 0.04)
      );
    color: var(--bojax-review-gold-light);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.65rem;
    font-weight: 700;
  }

  .bojax-testimonials__reviewer-copy {
    display: grid;
    min-width: 0;
    gap: 0.25rem;
  }

  .bojax-testimonials__reviewer-copy strong {
    overflow: hidden;
    color: #ffffff;
    font-size: 1.12rem;
    font-weight: 850;
    line-height: 1.25;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .bojax-testimonials__reviewer-copy > span {
    overflow: hidden;
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.9rem;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .bojax-testimonials__verified {
    display: grid;
    flex: 0 0 2.1rem;
    width: 2.1rem;
    height: 2.1rem;
    margin-left: auto;
    place-items: center;
    color: var(--bojax-review-green);
  }

  .bojax-testimonials__verified svg {
    width: 2.1rem;
    height: 2.1rem;
  }

  .bojax-testimonials__progress {
    height: 2px;
    margin-top: 0.5rem;
    overflow: hidden;
    border-radius: 99rem;
    background: rgba(255, 255, 255, 0.08);
  }

  .bojax-testimonials__progress span {
    display: block;
    width: 0;
    height: 100%;
    border-radius: inherit;
    background:
      linear-gradient(
        90deg,
        var(--bojax-review-gold),
        var(--bojax-review-gold-light)
      );
    transition: width 160ms linear;
  }

  .bojax-testimonials__swipe-hint {
    display: none;
    margin: 1.2rem 0 0;
    color: rgba(255, 255, 255, 0.38);
    font-size: 0.82rem;
    font-weight: 760;
    letter-spacing: 0.12em;
    text-align: center;
    text-transform: uppercase;
  }

  .bojax-testimonials__swipe-hint span {
    color: var(--bojax-review-gold-light);
  }

  .bojax-testimonials__cta {
    display: grid;
    max-width: 52rem;
    margin: 3.2rem auto 0;
    gap: 1.1rem;
    text-align: center;
  }

  .bojax-testimonials__button {
    display: inline-flex;
    min-height: 6.2rem;
    padding: 1.4rem 2.5rem;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    border: 1px solid #ffffff;
    border-radius: 99rem;
    background:
      linear-gradient(
        135deg,
        #ffffff,
        var(--bojax-review-cream)
      );
    color: #080704;
    font-size: 1.45rem;
    font-weight: 900;
    line-height: 1.2;
    text-decoration: none;
    box-shadow:
      0 2rem 5rem rgba(0, 0, 0, 0.35),
      0 0 4rem rgba(216, 184, 106, 0.12);
    transition:
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .bojax-testimonials__button:hover {
    color: #080704;
    box-shadow:
      0 2.5rem 6rem rgba(0, 0, 0, 0.43),
      0 0 5rem rgba(216, 184, 106, 0.2);
    transform: translateY(-0.2rem);
  }

  .bojax-testimonials__button svg {
    width: 2rem;
    height: 2rem;
  }

  .bojax-testimonials__button-note {
    margin: 0;
    color: rgba(255, 255, 255, 0.45);
    font-size: 1rem;
    line-height: 1.45;
  }

  .bojax-testimonials__disclaimer {
    max-width: 76rem;
    margin: 2rem auto 0;
    color: rgba(255, 255, 255, 0.27);
    font-size: 0.9rem;
    line-height: 1.55;
    text-align: center;
  }

  .bojax-testimonials__empty {
    margin-top: 3rem;
    padding: 3rem;
    border: 1px dashed rgba(216, 184, 106, 0.3);
    border-radius: 2rem;
    color: rgba(255, 255, 255, 0.5);
    text-align: center;
  }

  @media screen and (max-width: 989px) {
    .bojax-testimonials__track {
      grid-auto-columns: calc((100% - 1.6rem) / 2);
    }
  }

  @media screen and (max-width: 749px) {
    .bojax-testimonials {
      padding-top: var(--bojax-testimonials-top-mobile, 40px);
      padding-bottom: var(--bojax-testimonials-bottom-mobile, 48px);
    }

    .bojax-testimonials__container {
      width: calc(100% - 2.8rem);
    }

    .bojax-testimonials__eyebrow {
      margin-bottom: 1rem;
      font-size: 0.78rem;
      letter-spacing: 0.22em;
    }

    .bojax-testimonials__heading {
      font-size: clamp(3.6rem, 12vw, 5.1rem);
    }

    .bojax-testimonials__description {
      margin-top: 1.7rem;
      font-size: 1.28rem;
    }

    .bojax-testimonials__carousel {
      margin-top: 3rem;
    }

    .bojax-testimonials__controls {
      margin-bottom: 1.2rem;
    }

    .bojax-testimonials__count {
      font-size: 0.75rem;
      letter-spacing: 0.12em;
    }

    .bojax-testimonials__arrow {
      width: 4rem;
