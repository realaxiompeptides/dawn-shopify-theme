    font-weight: 700;
    letter-spacing: 0.32em;
    line-height: 1;
    text-transform: uppercase;
    text-align: center;
  }

  .bojax-pricing__heading {
    margin: 0;
    color: #fff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(4rem, 7vw, 7rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-align: center;
    text-wrap: balance;
  }

  .bojax-pricing__description {
    max-width: 760px;
    margin: 22px auto 0;
    color: rgba(255,255,255,0.72);
    font-size: 1.95rem;
    line-height: 1.7;
    text-align: center;
  }

  .bojax-pricing__description p {
    margin: 0;
  }

  .bojax-pricing__card {
    margin-top: 34px;
    padding: 1px;
    border-radius: 32px;
    background: linear-gradient(135deg, rgba(212, 176, 94, 0.65), rgba(212, 176, 94, 0.14));
    box-shadow: 0 30px 80px rgba(0,0,0,0.5);
  }

  .bojax-pricing__card-inner {
    padding: 34px 28px 28px;
    border-radius: 31px;
    background:
      radial-gradient(circle at top center, rgba(201,164,92,0.12), transparent 48%),
      linear-gradient(180deg, rgba(17,17,17,0.98), rgba(5,5,5,0.98));
  }

  .bojax-pricing__card-eyebrow {
    margin: 0 0 18px;
    color: #edd59a;
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 0.34em;
    line-height: 1;
    text-transform: uppercase;
    text-align: center;
  }

  .bojax-pricing__price-row {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .bojax-pricing__price-main {
    color: #fff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(5.4rem, 9vw, 9rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.06em;
    text-align: center;
  }

  .bojax-pricing__price-compare {
    color: rgba(255,255,255,0.35);
    font-size: clamp(2rem, 3.5vw, 3.4rem);
    font-weight: 600;
    text-decoration: line-through;
    line-height: 1;
  }

  .bojax-pricing__subtext {
