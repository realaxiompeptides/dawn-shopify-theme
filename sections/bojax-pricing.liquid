<script>
  (() => {
    const sectionId = 'BojaxPricing-{{ section.id }}';
    let intervalId;

    function initializeCountdown() {
      const section = document.getElementById(sectionId);
      if (!section) return;

      const countdown = section.querySelector('[data-bojax-countdown]');
      if (!countdown) return;

      clearInterval(intervalId);

      const hoursElement = countdown.querySelector('[data-countdown-hours]');
      const minutesElement = countdown.querySelector('[data-countdown-minutes]');
      const secondsElement = countdown.querySelector('[data-countdown-seconds]');
      const headingElement = countdown.querySelector('[data-bojax-countdown-heading]');

      let minimumHours = parseFloat(countdown.dataset.minHours);
      let maximumHours = parseFloat(countdown.dataset.maxHours);

      if (!Number.isFinite(minimumHours) || minimumHours <= 0) {
        minimumHours = 5.25;
      }

      if (!Number.isFinite(maximumHours) || maximumHours <= minimumHours) {
        maximumHours = minimumHours + 1;
      }

      const storageKey =
        countdown.dataset.storageKey ||
        'bojax-sale-expiration-v4-{{ section.id }}';

      function createExpiration() {
        const minimumTime = minimumHours * 60 * 60 * 1000;
        const maximumTime = maximumHours * 60 * 60 * 1000;
        return Date.now() + Math.floor(
          minimumTime + Math.random() * (maximumTime - minimumTime)
        );
      }

      function readExpiration() {
        try {
          return parseInt(localStorage.getItem(storageKey), 10);
        } catch (error) {
          return NaN;
        }
      }

      function saveExpiration(value) {
        try {
          localStorage.setItem(storageKey, String(value));
        } catch (error) {
          // The countdown can still run without localStorage.
        }
      }

      let expiration = readExpiration();

      if (!Number.isFinite(expiration) || expiration <= Date.now()) {
        expiration = createExpiration();
        saveExpiration(expiration);
      }

      function expireSale() {
        const offerCard = section.querySelector('[data-bojax-offer-card]');
        const offerLabel = section.querySelector('[data-bojax-offer-label]');
        const purchaseButton = section.querySelector('[data-bojax-sale-button]');
        const purchaseLink = section.querySelector('[data-bojax-sale-link]');
        const buttonText = section.querySelector('[data-bojax-button-text]');
        const buttonArrow = section.querySelector('[data-bojax-button-arrow]');

        clearInterval(intervalId);
        intervalId = null;

        hoursElement.textContent = '00';
        minutesElement.textContent = '00';
        secondsElement.textContent = '00';

        if (headingElement) headingElement.textContent = 'The sale has ended';
        if (offerLabel) offerLabel.textContent = 'SALE ENDED';

        countdown.classList.add('is-expired');
        if (offerCard) offerCard.classList.add('is-expired');

        if (buttonText) buttonText.textContent = 'Sale Ended';
        if (buttonArrow) buttonArrow.style.display = 'none';

        if (purchaseButton) {
          purchaseButton.disabled = true;
          purchaseButton.setAttribute('aria-disabled', 'true');
          purchaseButton.classList.add('is-expired');
        }

        if (purchaseLink) {
          purchaseLink.removeAttribute('href');
          purchaseLink.setAttribute('aria-disabled', 'true');
          purchaseLink.classList.add('is-expired');
        }
      }

      function updateCountdown() {
        const remaining = expiration - Date.now();

        if (remaining <= 0) {
          expireSale();
          return;
        }

        const totalSeconds = Math.floor(remaining / 1000);
        const hours = Math.floor(totalSeconds / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = totalSeconds % 60;

        hoursElement.textContent = String(hours).padStart(2, '0');
        minutesElement.textContent = String(minutes).padStart(2, '0');
        secondsElement.textContent = String(seconds).padStart(2, '0');
      }

      updateCountdown();
      intervalId = setInterval(updateCountdown, 1000);
    }

    function startCountdown() {
      setTimeout(initializeCountdown, 50);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', startCountdown);
    } else {
      startCountdown();
    }

    document.addEventListener('shopify:section:load', (event) => {
      if (
        event.target.id === sectionId ||
        event.target.querySelector?.('#' + sectionId)
      ) {
        startCountdown();
      }
    });

    document.addEventListener('shopify:section:unload', (event) => {
      if (event.target.id === sectionId) {
        clearInterval(intervalId);
      }
    });
  })();
</script>

