{%- liquid
  assign pricing_product = section.settings.product

  if pricing_product == blank
    assign pricing_product = all_products['bojax-course']
  endif

  if pricing_product != blank
    assign pricing_variant = pricing_product.selected_or_first_available_variant
  else
    assign pricing_variant = blank
  endif

  assign pricing_form_id = 'BojaxPricingForm-' | append: section.id
  assign fallback_price = section.settings.fallback_price | default: '$29.99'
  assign fallback_compare_price = section.settings.fallback_compare_price | default: '$59.99'

  if pricing_product != blank and pricing_variant != blank
    assign displayed_price = pricing_variant.price | money

    if pricing_variant.compare_at_price != blank
      assign displayed_compare_price = pricing_variant.compare_at_price | money
    else
      assign displayed_compare_price = fallback_compare_price
    endif
  else
    assign displayed_price = fallback_price
    assign displayed_compare_price = fallback_compare_price
  endif

  assign feature_1 = section.settings.feature_1 | default: 'Complete looksmaxxing curriculum'
  assign feature_2 = section.settings.feature_2 | default: '40+ detailed video lessons'
  assign feature_3 = section.settings.feature_3 | default: 'Submit questions to Bojax anytime'
  assign feature_4 = section.settings.feature_4 | default: 'Live teaching and member Q&A calls'
  assign feature_5 = section.settings.feature_5 | default: 'Instant access immediately after checkout'
  assign feature_6 = section.settings.feature_6 | default: 'Lifetime access to the complete course'
  assign feature_7 = section.settings.feature_7 | default: 'All future lessons and course updates'
  assign feature_8 = section.settings.feature_8 | default: 'Private members-only support access'

  assign countdown_heading = section.settings.countdown_heading | default: 'Sale ends after the timer ends'
  assign minimum_hours = section.settings.minimum_hours | default: 5.25
  assign maximum_hours = section.settings.maximum_hours | default: 8.75
  assign support_heading = section.settings.support_heading | default: 'Direct access to Bojax and live teaching'
  assign support_text = section.settings.support_text | default: 'Members can submit questions at any time and join live group calls where Bojax teaches course topics and answers member questions. Response times and call schedules may vary.'
  assign button_text = section.settings.button_text | default: 'Get Lifetime Access — $29.99'
  assign countdown_storage_key = 'bojax-pricing-countdown-v4-' | append: section.id
-%}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

<section
  id="BojaxPricing-{{ section.id }}"
  class="bojax-pricing"
  data-bojax-pricing
  data-section-id="{{ section.id }}"
  style="
    --bojax-pricing-top: {{ section.settings.padding_top | default: 48 }}px;
    --bojax-pricing-bottom: {{ section.settings.padding_bottom | default: 56 }}px;
    --bojax-pricing-top-mobile: {{ section.settings.padding_top_mobile | default: 32 }}px;
    --bojax-pricing-bottom-mobile: {{ section.settings.padding_bottom_mobile | default: 40 }}px;
  "
>
  <div class="bojax-pricing__ambient" aria-hidden="true">
    <span class="bojax-pricing__orb bojax-pricing__orb--left"></span>
    <span class="bojax-pricing__orb bojax-pricing__orb--right"></span>
    <span class="bojax-pricing__lines"></span>
  </div>

  <div class="bojax-pricing__container">
    <header class="bojax-pricing__header">
      {% if section.settings.eyebrow != blank %}
        <p class="bojax-pricing__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="bojax-pricing__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="bojax-pricing__description">{{ section.settings.description }}</div>
      {% endif %}
    </header>

    <div class="bojax-pricing__offer" data-bojax-offer-card>
      <div class="bojax-pricing__offer-inner">
        {% if section.settings.offer_label != blank %}
          <p class="bojax-pricing__offer-label">{{ section.settings.offer_label }}</p>
        {% endif %}

        <div class="bojax-pricing__price-row">
          <span class="bojax-pricing__price">{{ displayed_price }}</span>

          {% if pricing_variant != blank and pricing_variant.compare_at_price != blank and pricing_variant.compare_at_price > pricing_variant.price %}
            <s class="bojax-pricing__compare-price">{{ displayed_compare_price }}</s>
          {% elsif section.settings.show_compare_price %}
            <s class="bojax-pricing__compare-price">{{ fallback_compare_price }}</s>
          {% endif %}
        </div>

        {% if section.settings.price_subtext != blank %}
          <p class="bojax-pricing__price-subtext">{{ section.settings.price_subtext }}</p>
        {% endif %}

        {% if section.settings.show_countdown %}
          <div
            id="BojaxCountdown-{{ section.id }}"
            class="bojax-pricing__urgency"
            data-bojax-countdown
            data-min-hours="{{ minimum_hours }}"
            data-max-hours="{{ maximum_hours }}"
            data-storage-key="{{ countdown_storage_key }}"
          >
            <div class="bojax-pricing__urgency-heading">
              <span class="bojax-pricing__urgency-dot" aria-hidden="true"></span>
              <span>{{ countdown_heading }}</span>
            </div>

            <div class="bojax-pricing__timer" role="timer" aria-live="off" aria-label="Sale countdown">
              <div class="bojax-pricing__time-unit">
                <strong data-countdown-hours>00</strong>
                <span>Hours</span>
              </div>
              <span class="bojax-pricing__time-divider" aria-hidden="true">:</span>
              <div class="bojax-pricing__time-unit">
                <strong data-countdown-minutes>00</strong>
                <span>Minutes</span>
              </div>
              <span class="bojax-pricing__time-divider" aria-hidden="true">:</span>
              <div class="bojax-pricing__time-unit">
                <strong data-countdown-seconds>00</strong>
                <span>Seconds</span>
              </div>
            </div>
          </div>
        {% endif %}

        <div class="bojax-pricing__divider"></div>

        <div class="bojax-pricing__included-heading">
          <p>Everything included with your purchase</p>
        </div>

        <div class="bojax-pricing__features">
          {% for i in (1..8) %}
            {% case i %}
              {% when 1 %}{% assign feature_text = feature_1 %}
              {% when 2 %}{% assign feature_text = feature_2 %}
              {% when 3 %}{% assign feature_text = feature_3 %}
              {% when 4 %}{% assign feature_text = feature_4 %}
              {% when 5 %}{% assign feature_text = feature_5 %}
              {% when 6 %}{% assign feature_text = feature_6 %}
              {% when 7 %}{% assign feature_text = feature_7 %}
              {% when 8 %}{% assign feature_text = feature_8 %}
            {% endcase %}

            {% if feature_text != blank %}
              <div class="bojax-pricing__feature">
                <span class="bojax-pricing__check" aria-hidden="true">
                  <svg viewBox="0 0 20 20">
                    <path d="M5 10.5 8.2 13.7 15.5 6.2" fill="none" stroke="currentColor" stroke-width="2.35" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span>{{ feature_text }}</span>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        {% if support_heading != blank or support_text != blank %}
          <div class="bojax-pricing__support-note">
            <span class="bojax-pricing__support-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M5 5.5h14v10H9l-4 3v-13Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                <path d="M8 9h8M8 12h5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
              </svg>
            </span>
            <div>
              {% if support_heading != blank %}<strong>{{ support_heading }}</strong>{% endif %}
              {% if support_text != blank %}<p>{{ support_text }}</p>{% endif %}
            </div>
          </div>
        {% endif %}

        <div class="bojax-pricing__purchase">
          {% if pricing_product != blank and pricing_variant != blank %}
            <product-form class="bojax-pricing__product-form" data-section-id="{{ section.id }}" data-hide-errors="false">
              {% form 'product', pricing_product, id: pricing_form_id, class: 'bojax-pricing__form', novalidate: 'novalidate', data-type: 'add-to-cart-form' %}
                <input type="hidden" name="id" value="{{ pricing_variant.id }}" class="product-variant-id">

                <button
                  type="submit"
                  name="add"
                  class="bojax-pricing__button"
                  {% unless pricing_variant.available %}disabled{% endunless %}
                >
                  <span class="bojax-pricing__button-content">
                    <span class="bojax-pricing__button-text">
                      {% if pricing_variant.available %}{{ button_text }}{% else %}Sold out{% endif %}
                    </span>

                    {% if pricing_variant.available %}
                      <span class="bojax-pricing__button-arrow" aria-hidden="true">
                        <svg viewBox="0 0 20 20">
                          <path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </span>
                    {% endif %}
                  </span>

                  {% render 'loading-spinner' %}
                </button>
              {% endform %}
            </product-form>
          {% else %}
            <a class="bojax-pricing__button" href="/products/bojax-course">
              <span class="bojax-pricing__button-content">
                <span class="bojax-pricing__button-text">{{ button_text }}</span>
                <span class="bojax-pricing__button-arrow" aria-hidden="true">
                  <svg viewBox="0 0 20 20">
                    <path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </span>
            </a>
          {% endif %}
        </div>

        {% if section.settings.non_recurring_text != blank %}
          <p class="bojax-pricing__non-recurring">{{ section.settings.non_recurring_text }}</p>
        {% endif %}

        <div class="bojax-pricing__payments">
          {% if section.settings.payment_heading != blank %}
            <p class="bojax-pricing__payment-heading">{{ section.settings.payment_heading }}</p>
          {% endif %}

          {% if shop.enabled_payment_types.size > 0 %}
            <ul class="bojax-pricing__payment-icons" role="list" aria-label="Accepted payment methods">
              {% for type in shop.enabled_payment_types %}
                <li class="bojax-pricing__payment-icon">{{ type | payment_type_svg_tag }}</li>
              {% endfor %}
            </ul>
          {% endif %}

          {% if section.settings.payment_note != blank %}
            <p class="bojax-pricing__payment-note">{{ section.settings.payment_note }}</p>
          {% endif %}
        </div>
      </div>
    </div>

    {% if section.settings.legal_note != blank %}
      <div class="bojax-pricing__legal">{{ section.settings.legal_note }}</div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .bojax-pricing{
    --bojax-gold:#d8b86a;
    --bojax-gold-light:#f2d995;
    --bojax-gold-pale:#fff0c4;
    --bojax-green:#4ce47a;
    --bojax-urgent:#f0c568;
    position:relative;
    overflow:hidden;
    padding-top:var(--bojax-pricing-top,48px);
    padding-bottom:var(--bojax-pricing-bottom,56px);
    background:radial-gradient(circle at 50% 0,rgba(216,184,106,.17),transparent 36rem),linear-gradient(180deg,#030303 0%,#0a0906 50%,#030303 100%);
    color:#fff;
  }
  .bojax-pricing::before{position:absolute;inset:0 0 auto;height:1px;background:linear-gradient(90deg,transparent,var(--bojax-gold),rgba(255,255,255,.82),var(--bojax-gold),transparent);content:"";opacity:.78}
  .bojax-pricing__ambient{position:absolute;inset:0;overflow:hidden;pointer-events:none}
  .bojax-pricing__orb{position:absolute;display:block;border-radius:50%;background:var(--bojax-gold);filter:blur(10rem)}
  .bojax-pricing__orb--left{top:8rem;left:-24rem;width:46rem;height:46rem;opacity:.11}
  .bojax-pricing__orb--right{right:-25rem;bottom:-4rem;width:48rem;height:48rem;opacity:.08}
  .bojax-pricing__lines{position:absolute;inset:0;opacity:.035;background-image:linear-gradient(rgba(216,184,106,.5) 1px,transparent 1px),linear-gradient(90deg,rgba(216,184,106,.5) 1px,transparent 1px);background-size:7rem 7rem;-webkit-mask-image:linear-gradient(180deg,rgba(0,0,0,.8),transparent 78%);mask-image:linear-gradient(180deg,rgba(0,0,0,.8),transparent 78%)}
  .bojax-pricing__container{position:relative;z-index:2;width:min(calc(100% - 4rem),92rem);margin:0 auto}
  .bojax-pricing__header{max-width:78rem;margin:0 auto;text-align:center}
  .bojax-pricing__eyebrow{margin:0 0 1.4rem;color:var(--bojax-gold-light);font-size:1rem;font-weight:850;letter-spacing:.32em;line-height:1;text-transform:uppercase}
  .bojax-pricing__heading{margin:0;color:#fff;font-family:Georgia,"Times New Roman",serif;font-size:clamp(4rem,7vw,7rem);font-weight:500;letter-spacing:-.06em;line-height:.97;text-wrap:balance}
  .bojax-pricing__description{max-width:68rem;margin:2.2rem auto 0;color:rgba(255,255,255,.66);font-size:clamp(1.5rem,2vw,1.85rem);line-height:1.65}
  .bojax-pricing__description p,.bojax-pricing__legal p{margin:0}
  .bojax-pricing__offer{margin-top:4rem;padding:1px;border-radius:2.7rem;background:linear-gradient(135deg,rgba(242,217,149,.74),rgba(216,184,106,.13) 44%,rgba(216,184,106,.53));box-shadow:0 3rem 9rem rgba(0,0,0,.46),0 0 5rem rgba(216,184,106,.08)}
  .bojax-pricing__offer-inner{padding:4.2rem 4rem 3.6rem;border-radius:calc(2.7rem - 1px);background:radial-gradient(circle at 50% 0,rgba(216,184,106,.17),transparent 34rem),linear-gradient(145deg,rgba(17,16,12,.99),rgba(4,4,4,.995));text-align:center}
  .bojax-pricing__offer-label{margin:0;color:var(--bojax-gold-light);font-size:1rem;font-weight:850;letter-spacing:.27em;line-height:1;text-transform:uppercase}
  .bojax-pricing__price-row{display:flex;margin-top:2.2rem;align-items:center;justify-content:center;flex-wrap:wrap;gap:1.5rem}
  .bojax-pricing__price{color:#fff;font-family:Georgia,"Times New Roman",serif;font-size:clamp(5.5rem,10vw,9rem);font-weight:700;letter-spacing:-.075em;line-height:.9;text-shadow:0 0 3rem rgba(216,184,106,.12)}
  .bojax-pricing__compare-price{color:rgba(255,255,255,.31);font-size:clamp(2rem,3vw,3rem);line-height:1;text-decoration-thickness:.15rem}
  .bojax-pricing__price-subtext{max-width:66rem;margin:2.7rem auto 0;color:rgba(255,255,255,.62);font-size:1.35rem;line-height:1.55}
  .bojax-pricing__urgency{max-width:64rem;margin:2.8rem auto 0;padding:2rem;border:1px solid rgba(216,184,106,.35);border-radius:1.8rem;background:linear-gradient(135deg,rgba(216,184,106,.13),rgba(216,184,106,.035));box-shadow:inset 0 1px rgba(255,255,255,.04),0 1.8rem 4rem rgba(0,0,0,.18)}
  .bojax-pricing__urgency-heading{display:flex;align-items:center;justify-content:center;gap:.8rem;color:var(--bojax-gold-light);font-size:.95rem;font-weight:850;letter-spacing:.18em;line-height:1.3;text-transform:uppercase}
  .bojax-pricing__urgency-dot{display:block;width:.8rem;height:.8rem;border-radius:50%;background:var(--bojax-urgent);box-shadow:0 0 0 .4rem rgba(240,197,104,.09),0 0 1.5rem rgba(240,197,104,.45);animation:bojaxUrgencyPulse 1.8s ease-in-out infinite}
  .bojax-pricing__timer{display:flex;margin-top:1.5rem;align-items:flex-start;justify-content:center;gap:1rem}
  .bojax-pricing__time-unit{display:grid;min-width:7.5rem;gap:.45rem;text-align:center}
  .bojax-pricing__time-unit strong{color:#fff;font-family:Georgia,"Times New Roman",serif;font-size:3.7rem;font-weight:700;letter-spacing:-.04em;line-height:.95;font-variant-numeric:tabular-nums}
  .bojax-pricing__time-unit span{color:rgba(255,255,255,.44);font-size:.72rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
  .bojax-pricing__time-divider{margin-top:.1rem;color:var(--bojax-gold);font-family:Georgia,"Times New Roman",serif;font-size:3.2rem;line-height:1}
  @keyframes bojaxUrgencyPulse{0%,100%{opacity:.65;transform:scale(.9)}50%{opacity:1;transform:scale(1.1)}}
  .bojax-pricing__divider{height:1px;margin:3.4rem 0 2.7rem;background:linear-gradient(90deg,transparent,rgba(216,184,106,.42),transparent)}
  .bojax-pricing__included-heading{margin:0 0 2rem;text-align:center}
  .bojax-pricing__included-heading p{margin:0;color:rgba(255,255,255,.78);font-size:1.05rem;font-weight:850;letter-spacing:.16em;text-transform:uppercase}
  .bojax-pricing__features{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));max-width:76rem;margin:0 auto;gap:1.35rem 2.3rem;text-align:left}
  .bojax-pricing__feature{display:flex;min-width:0;align-items:flex-start;gap:1rem;color:rgba(255,255,255,.84);font-size:1.3rem;line-height:1.45}
  .bojax-pricing__check{display:grid;flex:0 0 2.25rem;width:2.25rem;height:2.25rem;margin-top:.05rem;place-items:center;border-radius:50%;background:var(--bojax-green);color:#031108;box-shadow:0 0 2rem rgba(76,228,122,.17)}
  .bojax-pricing__check svg{width:1.3rem;height:1.3rem}
  .bojax-pricing__support-note{display:flex;max-width:76rem;margin:3rem auto 0;padding:1.8rem 1.9rem;align-items:flex-start;gap:1.3rem;border:1px solid rgba(216,184,106,.27);border-radius:1.7rem;background:linear-gradient(135deg,rgba(216,184,106,.1),rgba(255,255,255,.015));text-align:left}
  .bojax-pricing__support-icon{display:grid;flex:0 0 4.3rem;width:4.3rem;height:4.3rem;place-items:center;border:1px solid rgba(216,184,106,.3);border-radius:1.2rem;background:rgba(216,184,106,.1);color:var(--bojax-gold-light)}
  .bojax-pricing__support-icon svg{width:2.3rem;height:2.3rem}
  .bojax-pricing__support-note strong{display:block;color:#fff;font-size:1.35rem;font-weight:850;line-height:1.3}
  .bojax-pricing__support-note p{margin:.65rem 0 0;color:rgba(255,255,255,.55);font-size:1.13rem;line-height:1.55}
  .bojax-pricing__purchase{max-width:76rem;margin:3.2rem auto 0}
  .bojax-pricing__product-form,.bojax-pricing__form{display:block;width:100%}
  .bojax-pricing__button{position:relative;display:flex;width:100%;min-height:6.8rem;padding:1.5rem 2.5rem;align-items:center;justify-content:center;overflow:hidden;border:1px solid #fff;border-radius:99rem;background:linear-gradient(135deg,#fff,var(--bojax-gold-pale));color:#080704;font-size:1.6rem;font-weight:900;line-height:1.2;text-align:center;text-decoration:none;cursor:pointer;box-shadow:0 2rem 5rem rgba(0,0,0,.36),0 0 4rem rgba(216,184,106,.14);transition:box-shadow 180ms ease,transform 180ms ease}
  .bojax-pricing__button:hover{color:#080704;box-shadow:0 2.5rem 6rem rgba(0,0,0,.45),0 0 5rem rgba(216,184,106,.21);transform:translateY(-.2rem)}
  .bojax-pricing__button:disabled{border-color:rgba(255,255,255,.2);background:rgba(255,255,255,.12);color:rgba(255,255,255,.5);cursor:not-allowed;box-shadow:none;pointer-events:none;transform:none}
  .bojax-pricing__button-content{display:inline-flex;align-items:center;justify-content:center;gap:1.2rem}
  .bojax-pricing__button-arrow{display:inline-grid;width:2rem;height:2rem;place-items:center}
  .bojax-pricing__button-arrow svg{width:2rem;height:2rem}
  .bojax-pricing__button .loading__spinner{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%)}
  .bojax-pricing__button.loading .bojax-pricing__button-content{visibility:hidden}
  .bojax-pricing__non-recurring{margin:2.2rem 0 0;color:rgba(255,255,255,.6);font-size:1.18rem;font-weight:600;line-height:1.5;text-align:center}
  .bojax-pricing__payments{margin-top:2.6rem;padding:0;border:0;background:transparent;text-align:center}
  .bojax-pricing__payment-heading{margin:0;color:rgba(255,255,255,.46);font-size:.88rem;font-weight:850;letter-spacing:.2em;line-height:1.3;text-transform:uppercase}
  .bojax-pricing__payment-icons{display:flex;margin:1.35rem 0 0;padding:0;align-items:center;justify-content:center;flex-wrap:wrap;gap:.7rem;list-style:none}
  .bojax-pricing__payment-icon{display:grid;min-width:4.4rem;height:2.8rem;padding:.2rem .3rem;place-items:center;border:0;background:transparent}
  .bojax-pricing__payment-icon svg{display:block;width:auto;max-width:4.4rem;height:2.4rem}
  .bojax-pricing__payment-note{max-width:56rem;margin:1.3rem auto 0;color:rgba(255,255,255,.31);font-size:1rem;line-height:1.5}
  .bojax-pricing__legal{max-width:80rem;margin:2.2rem auto 0;color:rgba(255,255,255,.33);font-size:1.03rem;line-height:1.6;text-align:center}
  .bojax-pricing__legal a{color:rgba(255,255,255,.64);text-underline-offset:.3rem}

  @media screen and (max-width:749px){
    .bojax-pricing{padding-top:var(--bojax-pricing-top-mobile,32px);padding-bottom:var(--bojax-pricing-bottom-mobile,40px)}
    .bojax-pricing__container{width:calc(100% - 2.8rem)}
    .bojax-pricing__eyebrow{margin-bottom:1.1rem;font-size:.84rem;letter-spacing:.24em}
    .bojax-pricing__heading{font-size:clamp(3.7rem,12vw,5.2rem)}
    .bojax-pricing__description{margin-top:1.8rem;font-size:1.38rem}
    .bojax-pricing__offer{margin-top:3rem;border-radius:2.1rem}
    .bojax-pricing__offer-inner{padding:2.8rem 1.5rem 2.4rem;border-radius:calc(2.1rem - 1px)}
    .bojax-pricing__offer-label{font-size:.82rem;letter-spacing:.22em}
    .bojax-pricing__price-row{margin-top:2rem;gap:1rem}
    .bojax-pricing__price{font-size:clamp(5rem,18vw,7rem)}
    .bojax-pricing__compare-price{font-size:2rem}
    .bojax-pricing__price-subtext{margin-top:2.4rem;font-size:1.18rem}
    .bojax-pricing__urgency{margin-top:2.3rem;padding:1.6rem 1rem;border-radius:1.5rem}
    .bojax-pricing__urgency-heading{font-size:.75rem;letter-spacing:.13em}
    .bojax-pricing__timer{margin-top:1.3rem;gap:.45rem}
    .bojax-pricing__time-unit{min-width:5.7rem}
    .bojax-pricing__time-unit strong{font-size:3rem}
    .bojax-pricing__time-unit span{font-size:.58rem;letter-spacing:.1em}
    .bojax-pricing__time-divider{font-size:2.7rem}
    .bojax-pricing__divider{margin:2.9rem 0 2.4rem}
    .bojax-pricing__included-heading{margin-bottom:1.8rem}
    .bojax-pricing__included-heading p{font-size:.8rem;letter-spacing:.13em}
    .bojax-pricing__features{grid-template-columns:1fr;gap:1.15rem}
    .bojax-pricing__feature{font-size:1.18rem}
    .bojax-pricing__support-note{margin-top:2.5rem;padding:1.5rem}
