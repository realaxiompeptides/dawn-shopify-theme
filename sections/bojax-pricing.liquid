    margin: 28px auto 0;
    color: rgba(255,255,255,0.72);
    font-size: 1.8rem;
    line-height: 1.65;
    text-align: center;
  }

  .bojax-pricing__countdown-wrap {
    margin-top: 20px;
    margin-bottom: 26px;
    text-align: center;
  }

  .bojax-pricing__countdown-label {
    margin: 0 0 10px;
    color: #d7bc7b;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }

  .bojax-pricing__countdown {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 144px;
    min-height: 48px;
    padding: 10px 18px;
    border: 1px solid rgba(212,176,94,0.28);
    border-radius: 999px;
    background: rgba(212,176,94,0.08);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.02);
  }

  .bojax-pricing__countdown-time {
    color: #fff;
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .bojax-pricing__benefits {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bojax-pricing__benefits li {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    color: #fff;
    font-size: 1.95rem;
    line-height: 1.45;
  }

  .bojax-pricing__check {
    display: inline-grid;
    width: 32px;
    height: 32px;
    flex: 0 0 32px;
    place-items: center;
    margin-top: 1px;
    border-radius: 50%;
    background: #4fe173;
    color: #071108;
    font-size: 1.8rem;
    font-weight: 900;
    line-height: 1;
  }

  .bojax-pricing__form {
    margin-top: 28px;
  }

  .bojax-pricing__button {
    display: inline-flex;
    width: 100%;
    min-height: 74px;
    padding: 18px 26px;
    align-items: center;
    justify-content: center;
    gap: 14px;
    border: none;
    border-radius: 999px;
    background: linear-gradient(180deg, #fffdf8, #efe3bc);
    color: #090909;
    font-size: 2.15rem;
    font-weight: 850;
    line-height: 1;
    text-align: center;
    cursor: pointer;
    box-shadow: 0 20px 44px rgba(212,176,94,0.18);
    transition: transform 180ms ease, box-shadow 180ms ease, filter 180ms ease;
  }

  .bojax-pricing__button:hover {
    transform: translateY(-2px);
    box-shadow: 0 24px 54px rgba(212,176,94,0.22);
    filter: brightness(1.02);
  }

  .bojax-pricing__button-arrow {
    font-size: 2.4rem;
    line-height: 1;
  }

  .bojax-pricing__button--disabled {
    margin-top: 28px;
    opacity: 0.6;
    cursor: not-allowed;
  }

  .bojax-pricing__purchase-note {
    margin: 18px 0 0;
    color: rgba(255,255,255,0.78);
    font-size: 1.55rem;
    line-height: 1.55;
    text-align: center;
  }

  .bojax-pricing__payments {
    margin-top: 18px;
    text-align: center;
  }

  .bojax-pricing__payments-heading {
    margin: 0 0 10px;
    color: rgba(255,255,255,0.72);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .bojax-pricing__payment-icons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 12px;
  }

  .bojax-pricing__payment-icon {
