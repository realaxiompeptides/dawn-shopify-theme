{%- liquid
  assign pricing_product = section.settings.product

  if pricing_product == blank
    assign pricing_product = all_products['bojax-course']
  endif

  assign pricing_variant = pricing_product.selected_or_first_available_variant
  assign pricing_form_id = 'BojaxPricingForm-' | append: section.id

  if pricing_product != blank and pricing_variant != blank
    assign displayed_price = pricing_variant.price | money
    assign displayed_compare_price = pricing_variant.compare_at_price | money
  else
    assign displayed_price = section.settings.fallback_price
    assign displayed_compare_price = section.settings.fallback_compare_price
  endif
-%}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

<section
  id="BojaxPricing-{{ section.id }}"
  class="bojax-pricing"
  data-bojax-pricing
  style="
    --bojax-pricing-top: {{ section.settings.padding_top }}px;
    --bojax-pricing-bottom: {{ section.settings.padding_bottom }}px;
    --bojax-pricing-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --bojax-pricing-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="bojax-pricing__ambient" aria-hidden="true">
    <span class="bojax-pricing__orb bojax-pricing__orb--left"></span>
    <span class="bojax-pricing__orb bojax-pricing__orb--right"></span>
    <span class="bojax-pricing__lines"></span>
  </div>

  <div class="bojax-pricing__container">
    <header class="bojax-pricing__header">
      {% if section.settings.eyebrow != blank %}
        <p class="bojax-pricing__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="bojax-pricing__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="bojax-pricing__description">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </header>

    <div class="bojax-pricing__offer">
      <div class="bojax-pricing__offer-inner">
        {% if section.settings.offer_label != blank %}
          <p class="bojax-pricing__offer-label">
            {{ section.settings.offer_label }}
          </p>
        {% endif %}

        <div class="bojax-pricing__price-row">
          <span class="bojax-pricing__price">
            {{ displayed_price }}
          </span>

          {% if pricing_variant != blank
            and pricing_variant.compare_at_price > pricing_variant.price
          %}
            <s class="bojax-pricing__compare-price">
              {{ displayed_compare_price }}
            </s>
          {% elsif section.settings.show_fallback_compare_price
            and section.settings.fallback_compare_price != blank
          %}
            <s class="bojax-pricing__compare-price">
              {{ section.settings.fallback_compare_price }}
            </s>
          {% endif %}
        </div>

        {% if section.settings.price_subtext != blank %}
          <p class="bojax-pricing__price-subtext">
            {{ section.settings.price_subtext }}
          </p>
        {% endif %}

        {% if section.settings.show_countdown %}
          <div
            class="bojax-pricing__urgency"
            data-bojax-countdown
            data-min-hours="{{ section.settings.minimum_hours }}"
            data-max-hours="{{ section.settings.maximum_hours }}"
            data-storage-key="bojax-pricing-expiration-{{ section.id }}"
          >
            <div class="bojax-pricing__urgency-heading">
              <span class="bojax-pricing__urgency-dot" aria-hidden="true"></span>

              <span>
                {{ section.settings.countdown_heading }}
              </span>
            </div>

            <div
              class="bojax-pricing__timer"
              role="timer"
              aria-live="off"
              aria-label="Checkout session countdown"
            >
              <div class="bojax-pricing__time-unit">
                <strong data-countdown-hours>06</strong>
                <span>Hours</span>
              </div>

              <span class="bojax-pricing__time-divider" aria-hidden="true">
                :
              </span>

              <div class="bojax-pricing__time-unit">
                <strong data-countdown-minutes>00</strong>
                <span>Minutes</span>
              </div>

              <span class="bojax-pricing__time-divider" aria-hidden="true">
                :
              </span>

              <div class="bojax-pricing__time-unit">
                <strong data-countdown-seconds>00</strong>
                <span>Seconds</span>
              </div>
            </div>

            {% if section.settings.countdown_note != blank %}
              <p class="bojax-pricing__urgency-note">
                {{ section.settings.countdown_note }}
              </p>
            {% endif %}
          </div>
        {% endif %}

        <div class="bojax-pricing__divider"></div>

        <div class="bojax-pricing__features">
          {% for i in (1..8) %}
            {% assign feature_key = 'feature_' | append: i %}
            {% assign feature_text = section.settings[feature_key] %}

            {% if feature_text != blank %}
              <div class="bojax-pricing__feature">
                <span class="bojax-pricing__check" aria-hidden="true">
                  <svg viewBox="0 0 20 20">
                    <path
                      d="M5 10.5 8.2 13.7 15.5 6.2"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.35"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>

                <span>{{ feature_text }}</span>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <div class="bojax-pricing__support-note">
          <span class="bojax-pricing__support-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path
                d="M5 5.5h14v10H9l-4 3v-13Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linejoin="round"
              />
              <path
                d="M8 9h8M8 12h5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
              />
            </svg>
          </span>

          <div>
            <strong>{{ section.settings.support_heading }}</strong>

            {% if section.settings.support_text != blank %}
              <p>{{ section.settings.support_text }}</p>
            {% endif %}
          </div>
        </div>

        <div class="bojax-pricing__purchase">
          {% if pricing_product != blank and pricing_variant != blank %}
            <product-form
              class="bojax-pricing__product-form"
              data-section-id="{{ section.id }}"
              data-hide-errors="false"
            >
              {% form 'product',
                pricing_product,
                id: pricing_form_id,
                class: 'bojax-pricing__form',
                novalidate: 'novalidate',
                data-type: 'add-to-cart-form'
              %}
                <input
                  type="hidden"
                  name="id"
                  value="{{ pricing_variant.id }}"
                  class="product-variant-id"
                >

                <button
                  type="submit"
                  name="add"
                  class="bojax-pricing__button"
                  {% unless pricing_variant.available %}
                    disabled
                  {% endunless %}
                >
                  <span class="bojax-pricing__button-content">
                    <span class="bojax-pricing__button-text">
                      {% if pricing_variant.available %}
                        {{ section.settings.button_text }}
                      {% else %}
                        Sold out
                      {% endif %}
                    </span>

                    {% if pricing_variant.available %}
                      <span
                        class="bojax-pricing__button-arrow"
                        aria-hidden="true"
                      >
                        <svg viewBox="0 0 20 20">
                          <path
                            d="M4 10h11M11 5l5 5-5 5"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </span>
                    {% endif %}
                  </span>

                  {% render 'loading-spinner' %}
                </button>
              {% endform %}
            </product-form>
          {% else %}
            <a
              class="bojax-pricing__button"
              href="/products/bojax-course"
            >
              <span class="bojax-pricing__button-content">
                <span class="bojax-pricing__button-text">
                  {{ section.settings.button_text }}
                </span>

                <span
                  class="bojax-pricing__button-arrow"
                  aria-hidden="true"
                >
                  <svg viewBox="0 0 20 20">
                    <path
                      d="M4 10h11M11 5l5 5-5 5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </span>
            </a>
          {% endif %}
        </div>

        {% if section.settings.non_recurring_text != blank %}
          <p class="bojax-pricing__non-recurring">
            {{ section.settings.non_recurring_text }}
          </p>
        {% endif %}

        <div class="bojax-pricing__payments">
          {% if section.settings.payment_heading != blank %}
            <p class="bojax-pricing__payment-heading">
              {{ section.settings.payment_heading }}
            </p>
          {% endif %}

          {% if shop.enabled_payment_types.size > 0 %}
            <ul
              class="bojax-pricing__payment-icons"
              role="list"
              aria-label="Accepted payment methods"
            >
              {% for type in shop.enabled_payment_types %}
                <li class="bojax-pricing__payment-icon">
                  {{ type | payment_type_svg_tag }}
                </li>
              {% endfor %}
            </ul>
          {% endif %}

          {% if section.settings.payment_note != blank %}
            <p class="bojax-pricing__payment-note">
              {{ section.settings.payment_note }}
            </p>
          {% endif %}
        </div>
      </div>
    </div>

    {% if section.settings.legal_note != blank %}
      <div class="bojax-pricing__legal">
        {{ section.settings.legal_note }}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .bojax-pricing {
    --bojax-gold: #d8b86a;
    --bojax-gold-light: #f2d995;
    --bojax-gold-pale: #fff0c4;
    --bojax-green: #4ce47a;
    --bojax-urgent: #f0c568;

    position: relative;
    overflow: hidden;

    padding-top: var(--bojax-pricing-top, 48px);
    padding-bottom: var(--bojax-pricing-bottom, 56px);

    background:
      radial-gradient(
        circle at 50% 0,
        rgba(216, 184, 106, 0.16),
        transparent 36rem
      ),
      linear-gradient(
        180deg,
        #030303 0%,
        #0a0906 50%,
        #030303 100%
      );

    color: #ffffff;
  }

  .bojax-pricing::before {
    position: absolute;
    inset: 0 0 auto;
    height: 1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        var(--bojax-gold),
        rgba(255, 255, 255, 0.82),
        var(--bojax-gold),
        transparent
      );

    content: "";
    opacity: 0.78;
  }

  .bojax-pricing__ambient {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .bojax-pricing__orb {
    position: absolute;
    display: block;
    border-radius: 50%;
    background: var(--bojax-gold);
    filter: blur(10rem);
  }

  .bojax-pricing__orb--left {
    top: 8rem;
    left: -24rem;
    width: 46rem;
    height: 46rem;
    opacity: 0.11;
  }

  .bojax-pricing__orb--right {
    right: -25rem;
    bottom: -4rem;
    width: 48rem;
    height: 48rem;
    opacity: 0.08;
  }

  .bojax-pricing__lines {
    position: absolute;
    inset: 0;
    opacity: 0.035;

    background-image:
      linear-gradient(
        rgba(216, 184, 106, 0.5) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(216, 184, 106, 0.5) 1px,
        transparent 1px
      );

    background-size: 7rem 7rem;

    mask-image:
      linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.8),
        transparent 78%
      );

    -webkit-mask-image:
      linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.8),
        transparent 78%
      );
  }

  .bojax-pricing__container {
    position: relative;
    z-index: 2;

    width: min(calc(100% - 4rem), 92rem);
    margin: 0 auto;
  }

  .bojax-pricing__header {
    max-width: 78rem;
    margin: 0 auto;
    text-align: center;
  }

  .bojax-pricing__eyebrow {
    margin: 0 0 1.4rem;

    color: var(--bojax-gold-light);

    font-size: 1rem;
    font-weight: 850;
    letter-spacing: 0.32em;
    line-height: 1;
    text-transform: uppercase;
  }

  .bojax-pricing__heading {
    margin: 0;

    color: #ffffff;

    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(4rem, 7vw, 7rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.97;

    text-wrap: balance;
  }

  .bojax-pricing__description {
    max-width: 68rem;
    margin: 2rem auto 0;

    color: rgba(255, 255, 255, 0.63);

    font-size: clamp(1.5rem, 2vw, 1.85rem);
    line-height: 1.65;
  }

  .bojax-pricing__description p,
  .bojax-pricing__legal p {
    margin: 0;
  }

  .bojax-pricing__offer {
    margin-top: 3.8rem;
    padding: 1px;

    border-radius: 2.7rem;

    background:
      linear-gradient(
        135deg,
        rgba(242, 217, 149, 0.7),
        rgba(216, 184, 106, 0.13) 44%,
        rgba(216, 184, 106, 0.5)
      );

    box-shadow:
      0 3rem 9rem rgba(0, 0, 0, 0.46),
      0 0 5rem rgba(216, 184, 106, 0.08);
  }

  .bojax-pricing__offer-inner {
    padding: 4rem;

    border-radius: calc(2.7rem - 1px);

    background:
      radial-gradient(
        circle at 50% 0,
        rgba(216, 184, 106, 0.16),
        transparent 34rem
      ),
      linear-gradient(
        145deg,
        rgba(17, 16, 12, 0.99),
        rgba(4, 4, 4, 0.995)
      );

    text-align: center;
  }

  .bojax-pricing__offer-label {
    margin: 0;

    color: var(--bojax-gold-light);

    font-size: 1rem;
    font-weight: 850;
    letter-spacing: 0.27em;
    line-height: 1;
    text-transform: uppercase;
  }

  .bojax-pricing__price-row {
    display: flex;
    margin-top: 2rem;

    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .bojax-pricing__price {
    color: #ffffff;

    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(5.5rem, 10vw, 9rem);
    font-weight: 700;
    letter-spacing: -0.075em;
    line-height: 0.9;

    text-shadow:
      0 0 3rem rgba(216, 184, 106, 0.12);
  }

  .bojax-pricing__compare-price {
    color: rgba(255, 255, 255, 0.3);

    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 1;

    text-decoration-thickness: 0.15rem;
  }

  .bojax-pricing__price-subtext {
    max-width: 66rem;
    margin: 2.4rem auto 0;

    color: rgba(255, 255, 255, 0.6);

    font-size: 1.35rem;
    line-height: 1.55;
  }

  /* Countdown */

  .bojax-pricing__urgency {
    max-width: 64rem;
    margin: 2.6rem auto 0;
    padding: 1.8rem 2rem;

    border: 1px solid rgba(216, 184, 106, 0.32);
    border-radius: 1.8rem;

    background:
      linear-gradient(
        135deg,
        rgba(216, 184, 106, 0.11),
        rgba(216, 184, 106, 0.035)
      );

    box-shadow:
      inset 0 1px rgba(255, 255, 255, 0.035),
      0 1.8rem 4rem rgba(0, 0, 0, 0.18);
  }

  .bojax-pricing__urgency-heading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;

    color: var(--bojax-gold-light);

    font-size: 0.95rem;
    font-weight: 850;
    letter-spacing: 0.18em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .bojax-pricing__urgency-dot {
    display: block;
    width: 0.8rem;
    height: 0.8rem;

    border-radius: 50%;
    background: var(--bojax-urgent);

    box-shadow:
      0 0 0 0.4rem rgba(240, 197, 104, 0.09),
      0 0 1.5rem rgba(240, 197, 104, 0.45);

    animation: bojaxUrgencyPulse 1.8s ease-in-out infinite;
  }

  .bojax-pricing__timer {
    display: flex;
    margin-top: 1.4rem;

    align-items: flex-start;
    justify-content: center;
    gap: 1rem;
  }

  .bojax-pricing__time-unit {
    display: grid;
    min-width: 7.5rem;
    gap: 0.45rem;
    text-align: center;
  }

  .bojax-pricing__time-unit strong {
    color: #ffffff;

    font-family: Georgia, "Times New Roman", serif;
    font-size: 3.7rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.95;

    font-variant-numeric: tabular-nums;
  }

  .bojax-pricing__time-unit span {
    color: rgba(255, 255, 255, 0.44);

    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .bojax-pricing__time-divider {
    margin-top: 0.1rem;

    color: var(--bojax-gold);

    font-family: Georgia, "Times New Roman", serif;
    font-size: 3.2rem;
    line-height: 1;
  }

  .bojax-pricing__urgency-note {
    margin: 1.3rem 0 0;

    color: rgba(255, 255, 255, 0.42);

    font-size: 1rem;
    line-height: 1.5;
  }

  @keyframes bojaxUrgencyPulse {
    0%,
    100% {
      opacity: 0.65;
      transform: scale(0.9);
    }

    50% {
      opacity: 1;
      transform: scale(1.1);
    }
  }

  .bojax-pricing__divider {
    height: 1px;
    margin: 3.1rem 0;

    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(216, 184, 106, 0.42),
        transparent
      );
  }

  /* Benefits */

  .bojax-pricing__features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));

    max-width: 76rem;
    margin: 0 auto;

    gap: 1.25rem 2.3rem;
    text-align: left;
  }

  .bojax-pricing__feature {
    display: flex;
    min-width: 0;

    align-items: flex-start;
    gap: 1rem;

    color: rgba(255, 255, 255, 0.82);

    font-size: 1.3rem;
    line-height: 1.45;
  }

  .bojax-pricing__check {
    display: grid;
    flex: 0 0 2.25rem;

    width: 2.25rem;
    height: 2.25rem;
    margin-top: 0.05rem;

    place-items: center;

    border-radius: 50%;
    background: var(--bojax-green);
    color: #031108;

    box-shadow:
      0 0 2rem rgba(76, 228, 122, 0.17);
  }

  .bojax-pricing__check svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  /* Support highlight */

  .bojax-pricing__support-note {
    display: flex;
    max-width: 76rem;
    margin: 2.8rem auto 0;
    padding: 1.7rem 1.9rem;

    align-items: flex-start;
    gap: 1.3rem;

    border: 1px solid rgba(216, 184, 106, 0.24);
    border-radius: 1.7rem;

    background:
      linear-gradient(
        135deg,
        rgba(216, 184, 106, 0.08),
        rgba(255, 255, 255, 0.015)
      );

    text-align: left;
  }

  .bojax-pricing__support-icon {
    display: grid;
    flex: 0 0 4.3rem;

    width: 4.3rem;
    height: 4.3rem;

    place-items: center;

    border: 1px solid rgba(216, 184, 106, 0.27);
    border-radius: 1.2rem;

    background: rgba(216, 184, 106, 0.08);
    color: var(--bojax-gold-light);
  }

  .bojax-pricing__support-icon svg {
    width: 2.3rem;
    height: 2.3rem;
  }

  .bojax-pricing__support-note strong {
    display: block;

    color: #ffffff;

    font-size: 1.35rem;
    font-weight: 850;
    line-height: 1.3;
  }

  .bojax-pricing__support-note p {
    margin: 0.55rem 0 0;

    color: rgba(255, 255, 255, 0.52);

    font-size: 1.13rem;
    line-height: 1.55;
  }

  /* Purchase button */

  .bojax-pricing__purchase {
    max-width: 76rem;
    margin: 3rem auto 0;
  }

  .bojax-pricing__product-form,
  .bojax-pricing__form {
    display: block;
    width: 100%;
  }

  .bojax-pricing__button {
    position: relative;

    display: flex;
    width: 100%;
    min-height: 6.8rem;
    padding: 1.5rem 2.5rem;

    align-items: center;
    justify-content: center;

    overflow: hidden;

    border: 1px solid #ffffff;
    border-radius: 99rem;

    background:
      linear-gradient(
        135deg,
        #ffffff,
        var(--bojax-gold-pale)
      );

    color: #080704;

    font-size: 1.6rem;
    font-weight: 900;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;

    cursor: pointer;

    box-shadow:
      0 2rem 5rem rgba(0, 0, 0, 0.36),
      0 0 4rem rgba(216, 184, 106, 0.14);

    transition:
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .bojax-pricing__button:hover {
    color: #080704;

    box-shadow:
      0 2.5rem 6rem rgba(0, 0, 0, 0.45),
      0 0 5rem rgba(216, 184, 106, 0.21);

    transform: translateY(-0.2rem);
  }

  .bojax-pricing__button:disabled {
    cursor: not-allowed;
    opacity: 0.55;
    transform: none;
  }

  .bojax-pricing__button-content {
    display: inline-flex;

    align-items: center;
    justify-content: center;
    gap: 1.2rem;
  }

  .bojax-pricing__button-arrow {
    display: inline-grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
  }

  .bojax-pricing__button-arrow svg {
    width: 2rem;
    height: 2rem;
  }

  .bojax-pricing__button .loading__spinner {
    position: absolute;
    top: 50%;
    left: 50%;

    transform: translate(-50%, -50%);
  }

  .bojax-pricing__button.loading .bojax-pricing__button-content {
    visibility: hidden;
  }

  .bojax-pricing__non-recurring {
    margin: 2rem 0 0;

    color: rgba(255, 255, 255, 0.57);

    font-size: 1.18rem;
    font-weight: 600;
    line-height: 1.5;
    text-align: center;
  }

  /* Payment methods */

  .bojax-pricing__payments {
    margin-top: 2.3rem;
    padding: 0;

    border: 0;
    background: transparent;

    text-align: center;
  }

  .bojax-pricing__payment-heading {
    margin: 0;

    color: rgba(255, 255, 255, 0.44);

    font-size: 0.88rem;
    font-weight: 850;
