<section id="BojaxPricing-{{ section.id }}" class="bojax-pricing-section">
  <div class="page-width">
    <div class="bojax-pricing">
      {% if section.settings.eyebrow != blank %}
        <p class="bojax-pricing__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="bojax-pricing__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="bojax-pricing__description rte">
          {{ section.settings.description }}
        </div>
      {% endif %}

      <div class="bojax-pricing__card">
        <div class="bojax-pricing__card-inner">
          {% if section.settings.price_eyebrow != blank %}
            <p class="bojax-pricing__card-eyebrow">{{ section.settings.price_eyebrow }}</p>
          {% endif %}

          <div class="bojax-pricing__price-row">
            <div class="bojax-pricing__price-main">
              {{ section.settings.price }}
            </div>

            {% if section.settings.compare_price != blank %}
              <div class="bojax-pricing__price-compare">
                {{ section.settings.compare_price }}
              </div>
            {% endif %}
          </div>

          {% if section.settings.subtext != blank %}
            <p class="bojax-pricing__subtext">
              {{ section.settings.subtext }}
            </p>
          {% endif %}

          <div class="bojax-pricing__countdown-wrap">
            {% if section.settings.countdown_label != blank %}
              <p class="bojax-pricing__countdown-label">
                {{ section.settings.countdown_label }}
              </p>
            {% endif %}
            <div
              class="bojax-pricing__countdown"
              data-minutes="{{ section.settings.countdown_minutes }}"
              data-storage-key="bojax-pricing-countdown-{{ section.id }}"
            >
              <span class="bojax-pricing__countdown-time">15:00</span>
            </div>
          </div>

          <ul class="bojax-pricing__benefits" role="list">
            <li>
              <span class="bojax-pricing__check">✓</span>
              <span>Complete looksmaxxing curriculum</span>
            </li>
            <li>
              <span class="bojax-pricing__check">✓</span>
              <span>40+ detailed video lessons</span>
            </li>
            <li>
              <span class="bojax-pricing__check">✓</span>
              <span>24/7 access to message Bojax with questions</span>
            </li>
            <li>
              <span class="bojax-pricing__check">✓</span>
              <span>Live calls where Bojax teaches advanced topics</span>
            </li>
            <li>
              <span class="bojax-pricing__check">✓</span>
              <span>Instant access after checkout</span>
            </li>
            <li>
              <span class="bojax-pricing__check">✓</span>
              <span>Lifetime access to your purchase</span>
            </li>
            <li>
              <span class="bojax-pricing__check">✓</span>
              <span>Future course updates included</span>
            </li>
          </ul>

          {% assign pricing_product = all_products[section.settings.product_handle] %}
          {% if pricing_product != blank and pricing_product.selected_or_first_available_variant != blank %}
            <form class="bojax-pricing__form" data-bojax-atc-form>
              <input
                type="hidden"
                name="id"
                value="{{ pricing_product.selected_or_first_available_variant.id }}"
              >
              <button type="submit" class="bojax-pricing__button">
                <span>{{ section.settings.button_text }}</span>
                <span class="bojax-pricing__button-arrow">→</span>
              </button>
            </form>
          {% else %}
            <div class="bojax-pricing__button bojax-pricing__button--disabled">
              <span>Select a product in the section settings</span>
            </div>
          {% endif %}

          {% if section.settings.purchase_note != blank %}
            <p class="bojax-pricing__purchase-note">
              {{ section.settings.purchase_note }}
            </p>
          {% endif %}

          {% if shop.enabled_payment_types.size > 0 %}
            <div class="bojax-pricing__payments">
              {% if section.settings.payment_heading != blank %}
                <p class="bojax-pricing__payments-heading">{{ section.settings.payment_heading }}</p>
              {% endif %}

              <div class="bojax-pricing__payment-icons">
                {% for type in shop.enabled_payment_types %}
                  <span class="bojax-pricing__payment-icon">
                    {{ type | payment_type_svg_tag }}
                  </span>
                {% endfor %}
              </div>
            </div>
          {% endif %}
        </div>
      </div>

      {% if section.settings.footer_note != blank %}
        <p class="bojax-pricing__footer-note">{{ section.settings.footer_note }}</p>
      {% endif %}
    </div>
  </div>
</section>

