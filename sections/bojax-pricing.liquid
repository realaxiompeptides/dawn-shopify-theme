{%- liquid
  assign pricing_product = section.settings.product
  if pricing_product == blank
    assign pricing_product = all_products['bojax-course']
  endif

  assign pricing_variant = pricing_product.selected_or_first_available_variant
  assign pricing_form_id = 'BojaxPricingForm-' | append: section.id
  assign fallback_price = section.settings.fallback_price | default: '$29.99'
  assign fallback_compare_price = section.settings.fallback_compare_price | default: '$59.99'

  if pricing_product != blank and pricing_variant != blank
    assign displayed_price = pricing_variant.price | money
    if pricing_variant.compare_at_price != blank
      assign displayed_compare_price = pricing_variant.compare_at_price | money
    else
      assign displayed_compare_price = fallback_compare_price
    endif
  else
    assign displayed_price = fallback_price
    assign displayed_compare_price = fallback_compare_price
  endif

  assign feature_1 = section.settings.feature_1 | default: 'Complete looksmaxxing curriculum'
  assign feature_2 = section.settings.feature_2 | default: '40+ detailed video lessons'
  assign feature_3 = section.settings.feature_3 | default: 'Submit questions to Bojax anytime'
  assign feature_4 = section.settings.feature_4 | default: 'Live teaching and member Q&A calls'
  assign feature_5 = section.settings.feature_5 | default: 'Instant access immediately after checkout'
  assign feature_6 = section.settings.feature_6 | default: 'Lifetime access to the complete course'
  assign feature_7 = section.settings.feature_7 | default: 'All future lessons and course updates'
  assign feature_8 = section.settings.feature_8 | default: 'Private members-only support access'

  assign countdown_heading = 'Sale ends after the timer ends'
  assign minimum_hours = section.settings.minimum_hours | default: 5.25
  assign maximum_hours = section.settings.maximum_hours | default: 8.75

  assign support_heading = section.settings.support_heading | default: 'Direct access to Bojax and live teaching'
  assign support_text = section.settings.support_text | default: 'Members can submit questions at any time and join live group calls where Bojax teaches course topics and answers member questions. Response times and call schedules may vary.'
  assign button_text = section.settings.button_text | default: 'Get Lifetime Access — $29.99'
-%}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

<section
  id="BojaxPricing-{{ section.id }}"
  class="bojax-pricing"
  data-bojax-pricing
  style="
    --bojax-pricing-top: {{ section.settings.padding_top | default: 48 }}px;
    --bojax-pricing-bottom: {{ section.settings.padding_bottom | default: 56 }}px;
    --bojax-pricing-top-mobile: {{ section.settings.padding_top_mobile | default: 32 }}px;
    --bojax-pricing-bottom-mobile: {{ section.settings.padding_bottom_mobile | default: 40 }}px;
  "
>
  <div class="bojax-pricing__ambient" aria-hidden="true">
    <span class="bojax-pricing__orb bojax-pricing__orb--left"></span>
    <span class="bojax-pricing__orb bojax-pricing__orb--right"></span>
    <span class="bojax-pricing__lines"></span>
  </div>

  <div class="bojax-pricing__container">
    <header class="bojax-pricing__header">
      <p class="bojax-pricing__eyebrow">
        {{ section.settings.eyebrow | default: 'ONE-TIME PAYMENT' }}
      </p>

      <h2 class="bojax-pricing__heading">
        {{ section.settings.heading | default: 'Get the complete Bojax Method' }}
      </h2>

      <div class="bojax-pricing__description">
        {% if section.settings.description != blank %}
          {{ section.settings.description }}
        {% else %}
          <p>
            Unlock the complete course, member support and live teaching calls
            with one payment. No monthly billing and no recurring subscription.
          </p>
        {% endif %}
      </div>
    </header>

    <div class="bojax-pricing__offer" data-bojax-offer-card>
      <div class="bojax-pricing__offer-inner">
        <p class="bojax-pricing__offer-label" data-bojax-offer-label>
          {{ section.settings.offer_label | default: 'CURRENT MEMBER PRICE' }}
        </p>

        <div class="bojax-pricing__price-row">
          <span class="bojax-pricing__price">{{ displayed_price }}</span>

          {% if pricing_variant != blank
            and pricing_variant.compare_at_price != blank
            and pricing_variant.compare_at_price > pricing_variant.price
          %}
            <s class="bojax-pricing__compare-price">{{ displayed_compare_price }}</s>
          {% elsif section.settings.show_fallback_compare_price != false %}
            <s class="bojax-pricing__compare-price">{{ fallback_compare_price }}</s>
          {% endif %}
        </div>

        <p class="bojax-pricing__price-subtext">
          {{ section.settings.price_subtext
            | default: 'One-time purchase • Instant digital delivery • Lifetime course access'
          }}
        </p>

        {% unless section.settings.show_countdown == false %}
          <div
            class="bojax-pricing__urgency"
            data-bojax-countdown
            data-min-hours="{{ minimum_hours }}"
            data-max-hours="{{ maximum_hours }}"
            data-storage-key="bojax-sale-expiration-v4-{{ section.id }}"
          >
            <div class="bojax-pricing__urgency-heading">
              <span class="bojax-pricing__urgency-dot" aria-hidden="true"></span>
              <span data-bojax-countdown-heading>{{ countdown_heading }}</span>
            </div>

            <div
              class="bojax-pricing__timer"
              role="timer"
              aria-live="off"
              aria-label="Sale countdown"
            >
              <div class="bojax-pricing__time-unit">
                <strong data-countdown-hours>06</strong>
                <span>Hours</span>
              </div>

              <span class="bojax-pricing__time-divider" aria-hidden="true">:</span>

              <div class="bojax-pricing__time-unit">
                <strong data-countdown-minutes>00</strong>
                <span>Minutes</span>
              </div>

              <span class="bojax-pricing__time-divider" aria-hidden="true">:</span>

              <div class="bojax-pricing__time-unit">
                <strong data-countdown-seconds>00</strong>
                <span>Seconds</span>
              </div>
            </div>
          </div>
        {% endunless %}

        <div class="bojax-pricing__divider"></div>

        <div class="bojax-pricing__included-heading">
          <p>Everything included with your purchase</p>
        </div>

        <div class="bojax-pricing__features">
          {% for i in (1..8) %}
            {% case i %}
              {% when 1 %}
                {% assign feature_text = feature_1 %}
              {% when 2 %}
                {% assign feature_text = feature_2 %}
              {% when 3 %}
                {% assign feature_text = feature_3 %}
              {% when 4 %}
                {% assign feature_text = feature_4 %}
              {% when 5 %}
                {% assign feature_text = feature_5 %}
              {% when 6 %}
                {% assign feature_text = feature_6 %}
              {% when 7 %}
                {% assign feature_text = feature_7 %}
              {% when 8 %}
                {% assign feature_text = feature_8 %}
            {% endcase %}

            <div class="bojax-pricing__feature">
              <span class="bojax-pricing__check" aria-hidden="true">
                <svg viewBox="0 0 20 20">
                  <path
                    d="M5 10.5 8.2 13.7 15.5 6.2"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.35"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>

              <span>{{ feature_text }}</span>
            </div>
          {% endfor %}
        </div>

        <div class="bojax-pricing__support-note">
          <span class="bojax-pricing__support-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path
                d="M5 5.5h14v10H9l-4 3v-13Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linejoin="round"
              />
              <path
                d="M8 9h8M8 12h5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
              />
            </svg>
          </span>

          <div>
            <strong>{{ support_heading }}</strong>
            <p>{{ support_text }}</p>
          </div>
        </div>

        <div class="bojax-pricing__purchase">
          {% if pricing_product != blank and pricing_variant != blank %}
            <product-form
              class="bojax-pricing__product-form"
              data-section-id="{{ section.id }}"
              data-hide-errors="false"
            >
              {% form 'product',
                pricing_product,
                id: pricing_form_id,
                class: 'bojax-pricing__form',
                novalidate: 'novalidate',
                data-type: 'add-to-cart-form'
              %}
                <input
                  type="hidden"
                  name="id"
                  value="{{ pricing_variant.id }}"
                  class="product-variant-id"
                >

                <button
                  type="submit"
                  name="add"
                  class="bojax-pricing__button"
                  data-bojax-sale-button
                  {% unless pricing_variant.available %}
                    disabled
                  {% endunless %}
                >
                  <span class="bojax-pricing__button-content">
                    <span
                      class="bojax-pricing__button-text"
                      data-bojax-button-text
                    >
                      {% if pricing_variant.available %}
                        {{ button_text }}
                      {% else %}
                        Sold out
                      {% endif %}
                    </span>

                    {% if pricing_variant.available %}
                      <span
                        class="bojax-pricing__button-arrow"
                        aria-hidden="true"
                        data-bojax-button-arrow
                      >
                        <svg viewBox="0 0 20 20">
                          <path
                            d="M4 10h11M11 5l5 5-5 5"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </span>
                    {% endif %}
                  </span>

                  {% render 'loading-spinner' %}
                </button>
              {% endform %}
            </product-form>
          {% else %}
            <a
              class="bojax-pricing__button"
              href="/products/bojax-course"
              data-bojax-sale-link
            >
              <span class="bojax-pricing__button-content">
                <span
                  class="bojax-pricing__button-text"
                  data-bojax-button-text
                >
                  {{ button_text }}
                </span>

                <span
                  class="bojax-pricing__button-arrow"
                  aria-hidden="true"
                  data-bojax-button-arrow
                >
                  <svg viewBox="0 0 20 20">
                    <path
                      d="M4 10h11M11 5l5 5-5 5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </span>
            </a>
          {% endif %}
        </div>

        <p class="bojax-pricing__non-recurring">
          {{ section.settings.non_recurring_text
            | default: '$29.99 one-time purchase • Non-recurring • No subscription'
          }}
        </p>

        <div class="bojax-pricing__payments">
          <p class="bojax-pricing__payment-heading">
            {{ section.settings.payment_heading | default: 'Accepted payment methods' }}
          </p>

          {% if shop.enabled_payment_types.size > 0 %}
            <ul
              class="bojax-pricing__payment-icons"
              role="list"
              aria-label="Accepted payment methods"
            >
              {% for type in shop.enabled_payment_types %}
                <li class="bojax-pricing__payment-icon">
                  {{ type | payment_type_svg_tag }}
                </li>
              {% endfor %}
            </ul>
          {% endif %}

          <p class="bojax-pricing__payment-note">
            {{ section.settings.payment_note
              | default: 'Available payment options may vary by location, currency and checkout eligibility.'
            }}
          </p>
        </div>
      </div>
    </div>

    <div class="bojax-pricing__legal">
      {% if section.settings.legal_note != blank %}
        {{ section.settings.legal_note }}
      {% else %}
        <p>
          By completing your purchase, you agree to the store’s terms and
          refund policy. Individual results vary.
        </p>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .bojax-pricing {
    --bojax-gold: #d8b86a;
    --bojax-gold-light: #f2d995;
    --bojax-gold-pale: #fff0c4;
    --bojax-green: #4ce47a;
    --bojax-urgent: #f0c568;
    position: relative;
    overflow: hidden;
    padding-top: var(--bojax-pricing-top, 48px);
    padding-bottom: var(--bojax-pricing-bottom, 56px);
    background:
      radial-gradient(circle at 50% 0, rgba(216, 184, 106, 0.17), transparent 36rem),
      linear-gradient(180deg, #030303 0%, #0a0906 50%, #030303 100%);
    color: #fff;
  }

  .bojax-pricing::before {
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--bojax-gold),
      rgba(255, 255, 255, 0.82),
      var(--bojax-gold),
      transparent
    );
    content: "";
    opacity: 0.78;
  }

  .bojax-pricing__ambient {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .bojax-pricing__orb {
    position: absolute;
    display: block;
    border-radius: 50%;
    background: var(--bojax-gold);
    filter: blur(10rem);
  }

  .bojax-pricing__orb--left {
    top: 8rem;
    left: -24rem;
    width: 46rem;
    height: 46rem;
    opacity: 0.11;
  }

  .bojax-pricing__orb--right {
    right: -25rem;
    bottom: -4rem;
    width: 48rem;
    height: 48rem;
    opacity: 0.08;
  }

  .bojax-pricing__lines {
    position: absolute;
    inset: 0;
    opacity: 0.035;
    background-image:
      linear-gradient(rgba(216, 184, 106, 0.5) 1px, transparent 1px),
      linear-gradient(90deg, rgba(216, 184, 106, 0.5) 1px, transparent 1px);
    background-size: 7rem 7rem;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.8), transparent 78%);
    -webkit-mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.8), transparent 78%);
  }

  .bojax-pricing__container {
    position: relative;
    z-index: 2;
    width: min(calc(100% - 4rem), 92rem);
    margin: 0 auto;
  }

  .bojax-pricing__header {
    max-width: 78rem;
    margin: 0 auto;
    text-align: center;
  }

  .bojax-pricing__eyebrow {
    margin: 0 0 1.4rem;
    color: var(--bojax-gold-light);
    font-size: 1rem;
    font-weight: 850;
    letter-spacing: 0.32em;
    line-height: 1;
    text-transform: uppercase;
  }

  .bojax-pricing__heading {
    margin: 0;
    color: #fff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(4rem, 7vw, 7rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.97;
    text-wrap: balance;
  }

  .bojax-pricing__description {
    max-width: 68rem;
    margin: 2.2rem auto 0;
    color: rgba(255, 255, 255, 0.66);
    font-size: clamp(1.5rem, 2vw, 1.85rem);
    line-height: 1.65;
  }

  .bojax-pricing__description p,
  .bojax-pricing__legal p {
    margin: 0;
  }

  .bojax-pricing__offer {
    margin-top: 4rem;
    padding: 1px;
    border-radius: 2.7rem;
    background: linear-gradient(
      135deg,
      rgba(242, 217, 149, 0.74),
      rgba(216, 184, 106, 0.13) 44%,
      rgba(216, 184, 106, 0.53)
    );
    box-shadow:
      0 3rem 9rem rgba(0, 0, 0, 0.46),
      0 0 5rem rgba(216, 184, 106, 0.08);
  }

  .bojax-pricing__offer.is-expired {
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.19),
      rgba(255, 255, 255, 0.05),
      rgba(255, 255, 255, 0.12)
    );
  }

  .bojax-pricing__offer-inner {
    padding: 4.2rem 4rem 3.6rem;
    border-radius: calc(2.7rem - 1px);
    background:
      radial-gradient(circle at 50% 0, rgba(216, 184, 106, 0.17), transparent 34rem),
      linear-gradient(145deg, rgba(17, 16, 12, 0.99), rgba(4, 4, 4, 0.995));
    text-align: center;
  }

  .bojax-pricing__offer-label {
    margin: 0;
    color: var(--bojax-gold-light);
    font-size: 1rem;
    font-weight: 850;
    letter-spacing: 0.27em;
    line-height: 1;
    text-transform: uppercase;
  }

  .bojax-pricing__price-row {
    display: flex;
    margin-top: 2.2rem;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .bojax-pricing__price {
    color: #fff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(5.5rem, 10vw, 9rem);
    font-weight: 700;
    letter-spacing: -0.075em;
    line-height: 0.9;
    text-shadow: 0 0 3rem rgba(216, 184, 106, 0.12);
  }

  .bojax-pricing__compare-price {
    color: rgba(255, 255, 255, 0.31);
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 1;
    text-decoration-thickness: 0.15rem;
  }

  .bojax-pricing__price-subtext {
    max-width: 66rem;
    margin: 2.7rem auto 0;
    color: rgba(255, 255, 255, 0.62);
    font-size: 1.35rem;
    line-height: 1.55;
  }

  .bojax-pricing__urgency {
    max-width: 64rem;
    margin: 2.8rem auto 0;
    padding: 2rem;
    border: 1px solid rgba(216, 184, 106, 0.35);
    border-radius: 1.8rem;
    background: linear-gradient(
      135deg,
      rgba(216, 184, 106, 0.13),
      rgba(216, 184, 106, 0.035)
    );
    box-shadow:
      inset 0 1px rgba(255, 255, 255, 0.04),
      0 1.8rem 4rem rgba(0, 0, 0, 0.18);
  }

  .bojax-pricing__urgency.is-expired {
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.04);
  }

  .bojax-pricing__urgency-heading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    color: var(--bojax-gold-light);
    font-size: 0.95rem;
    font-weight: 850;
    letter-spacing: 0.18em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .bojax-pricing__urgency.is-expired .bojax-pricing__urgency-heading {
    color: rgba(255, 255, 255, 0.65);
  }

  .bojax-pricing__urgency-dot {
    display: block;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: var(--bojax-urgent);
    box-shadow:
      0 0 0 0.4rem rgba(240, 197, 104, 0.09),
      0 0 1.5rem rgba(240, 197, 104, 0.45);
    animation: bojaxUrgencyPulse 1.8s ease-in-out infinite;
  }

  .bojax-pricing__urgency.is-expired .bojax-pricing__urgency-dot {
    background: rgba(255, 255, 255, 0.5);
    box-shadow: none;
    animation: none;
  }

  .bojax-pricing__timer {
    display: flex;
    margin-top: 1.5rem;
    align-items: flex-start;
    justify-content: center;
    gap: 1rem;
  }

  .bojax-pricing__time-unit {
    display: grid;
    min-width: 7.5rem;
    gap: 0.45rem;
    text-align: center;
  }

  .bojax-pricing__time-unit strong {
    color: #fff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 3.7rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.95;
    font-variant-numeric: tabular-nums;
  }

  .bojax-pricing__time-unit span {
    color: rgba(255, 255, 255, 0.44);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .bojax-pricing__time-divider {
    margin-top: 0.1rem;
    color: var(--bojax-gold);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 3.2rem;
    line-height: 1;
  }

  @keyframes bojaxUrgencyPulse {
    0%,
    100% {
      opacity: 0.65;
      transform: scale(0.9);
    }

    50% {
      opacity: 1;
      transform: scale(1.1);
    }
  }

  .bojax-pricing__divider {
    height: 1px;
    margin: 3.4rem 0 2.7rem;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(216, 184, 106, 0.42),
      transparent
    );
  }

  .bojax-pricing__included-heading {
    margin: 0 0 2rem;
    text-align: center;
  }

  .bojax-pricing__included-heading p {
    margin: 0;
    color: rgba(255, 255, 255, 0.78);
    font-size: 1.05rem;
    font-weight: 850;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .bojax-pricing__features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 76rem;
    margin: 0 auto;
    gap: 1.35rem 2.3rem;
    text-align: left;
  }

  .bojax-pricing__feature {
    display: flex;
    min-width: 0;
    align-items: flex-start;
    gap: 1rem;
    color: rgba(255, 255, 255, 0.84);
    font-size: 1.3rem;
    line-height: 1.45;
  }

  .bojax-pricing__check {
    display: grid;
    flex: 0 0 2.25rem;
    width: 2.25rem;
    height: 2.25rem;
    margin-top: 0.05rem;
    place-items: center;
    border-radius: 50%;
    background: var(--bojax-green);
    color: #031108;
    box-shadow: 0 0 2rem rgba(76, 228, 122, 0.17);
  }

  .bojax-pricing__check svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  .bojax-pricing__support-note {
    display: flex;
    max-width: 76rem;
    margin: 3rem auto 0;
    padding: 1.8rem 1.9rem;
    align-items: flex-start;
    gap: 1.3rem;
    border: 1px solid rgba(216, 184, 106, 0.27);
    border-radius: 1.7rem;
    background: linear-gradient(
      135deg,
      rgba(216, 184, 106, 0.1),
      rgba(255, 255, 255, 0.015)
    );
    text-align: left;
  }

  .bojax-pricing__support-icon {
    display: grid;
    flex: 0 0 4.3rem;
    width: 4.3rem;
    height: 4.3rem;
    place-items: center;
    border: 1px solid rgba(216, 184, 106, 0.3);
    border-radius: 1.2rem;
    background: rgba(216, 184, 106, 0.1);
    color: var(--bojax-gold-light);
  }

  .bojax-pricing__support-icon svg {
    width: 2.3rem;
    height: 2.3rem;
  }

  .bojax-pricing__support-note strong {
    display: block;
    color: #fff;
    font-size: 1.35rem;
    font-weight: 850;
    line-height: 1.3;
  }

  .bojax-pricing__support-note p {
    margin: 0.65rem 0 0;
    color: rgba(255, 255, 255, 0.55);
    font-size: 1.13rem;
    line-height: 1.55;
  }

  .bojax-pricing__purchase {
    max-width: 76rem;
    margin: 3.2rem auto 0;
  }

  .bojax-pricing__product-form,
  .bojax-pricing__form {
    display: block;
    width: 100%;
  }

  .bojax-pricing__button {
    position: relative;
    display: flex;
    width: 100%;
    min-height: 6.8rem;
