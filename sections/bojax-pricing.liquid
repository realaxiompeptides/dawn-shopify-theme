{%- liquid
  assign pricing_product = section.settings.product

  if pricing_product == blank
    assign pricing_product = all_products['bojax-course']
  endif

  assign pricing_variant = pricing_product.selected_or_first_available_variant
  assign pricing_form_id = 'BojaxPricingForm-' | append: section.id

  if pricing_product != blank and pricing_variant != blank
    assign displayed_price = pricing_variant.price | money
    assign displayed_compare_price = pricing_variant.compare_at_price | money
  else
    assign displayed_price = section.settings.fallback_price
    assign displayed_compare_price = section.settings.fallback_compare_price
  endif
-%}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

<section
  id="BojaxPricing-{{ section.id }}"
  class="bojax-pricing"
>
  <div class="bojax-pricing__ambient" aria-hidden="true">
    <span class="bojax-pricing__orb bojax-pricing__orb--left"></span>
    <span class="bojax-pricing__orb bojax-pricing__orb--right"></span>
  </div>

  <div class="bojax-pricing__container">
    <header class="bojax-pricing__header">
      {% if section.settings.eyebrow != blank %}
        <p class="bojax-pricing__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="bojax-pricing__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="bojax-pricing__description">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </header>

    <div class="bojax-pricing__offer">
      {% if section.settings.offer_label != blank %}
        <p class="bojax-pricing__offer-label">
          {{ section.settings.offer_label }}
        </p>
      {% endif %}

      <div class="bojax-pricing__price-row">
        <span class="bojax-pricing__price">
          {{ displayed_price }}
        </span>

        {% if pricing_variant != blank
          and pricing_variant.compare_at_price > pricing_variant.price
        %}
          <s class="bojax-pricing__compare-price">
            {{ displayed_compare_price }}
          </s>
        {% elsif section.settings.show_fallback_compare_price
          and section.settings.fallback_compare_price != blank
        %}
          <s class="bojax-pricing__compare-price">
            {{ section.settings.fallback_compare_price }}
          </s>
        {% endif %}
      </div>

      {% if section.settings.price_subtext != blank %}
        <p class="bojax-pricing__price-subtext">
          {{ section.settings.price_subtext }}
        </p>
      {% endif %}

      <div class="bojax-pricing__divider"></div>

      <div class="bojax-pricing__features">
        {% for i in (1..5) %}
          {% assign feature_key = 'feature_' | append: i %}
          {% assign feature_text = section.settings[feature_key] %}

          {% if feature_text != blank %}
            <div class="bojax-pricing__feature">
              <span class="bojax-pricing__check" aria-hidden="true">
                <svg viewBox="0 0 20 20">
                  <path
                    d="M5 10.5 8.2 13.7 15.5 6.2"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>

              <span>{{ feature_text }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="bojax-pricing__purchase">
        {% if pricing_product != blank and pricing_variant != blank %}
          <product-form
            class="bojax-pricing__product-form"
            data-section-id="{{ section.id }}"
            data-hide-errors="false"
          >
            {% form 'product',
              pricing_product,
              id: pricing_form_id,
              class: 'bojax-pricing__form',
              novalidate: 'novalidate',
              data-type: 'add-to-cart-form'
            %}
              <input
                type="hidden"
                name="id"
                value="{{ pricing_variant.id }}"
                class="product-variant-id"
              >

              <button
                type="submit"
                name="add"
                class="bojax-pricing__button"
                {% unless pricing_variant.available %}
                  disabled
                {% endunless %}
              >
                <span class="bojax-pricing__button-content">
                  <span class="bojax-pricing__button-text">
                    {% if pricing_variant.available %}
                      {{ section.settings.button_text }}
                      <span aria-hidden="true">—</span>
                      {{ displayed_price }}
                    {% else %}
                      Sold out
                    {% endif %}
                  </span>

                  <span class="bojax-pricing__button-arrow" aria-hidden="true">
                    <svg viewBox="0 0 20 20">
                      <path
                        d="M4 10h11M11 5l5 5-5 5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                </span>

                {% render 'loading-spinner' %}
              </button>
            {% endform %}
          </product-form>
        {% else %}
          <a
            class="bojax-pricing__button"
            href="/products/bojax-course"
          >
            <span class="bojax-pricing__button-content">
              <span class="bojax-pricing__button-text">
                {{ section.settings.button_text }}
                <span aria-hidden="true">—</span>
                {{ displayed_price }}
              </span>

              <span class="bojax-pricing__button-arrow" aria-hidden="true">
                <svg viewBox="0 0 20 20">
                  <path
                    d="M4 10h11M11 5l5 5-5 5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </span>
          </a>
        {% endif %}
      </div>

      {% if section.settings.non_recurring_text != blank %}
        <p class="bojax-pricing__non-recurring">
          {{ section.settings.non_recurring_text }}
        </p>
      {% endif %}

      <div class="bojax-pricing__payments">
        {% if section.settings.payment_heading != blank %}
          <p class="bojax-pricing__payment-heading">
            {{ section.settings.payment_heading }}
          </p>
        {% endif %}

        {% if shop.enabled_payment_types.size > 0 %}
          <ul
            class="bojax-pricing__payment-icons"
            role="list"
            aria-label="Accepted payment methods"
          >
            {% for type in shop.enabled_payment_types %}
              <li class="bojax-pricing__payment-icon">
                {{ type | payment_type_svg_tag }}
              </li>
            {% endfor %}
          </ul>
        {% endif %}

        {% if section.settings.payment_note != blank %}
          <p class="bojax-pricing__payment-note">
            {{ section.settings.payment_note }}
          </p>
        {% endif %}
      </div>
    </div>

    {% if section.settings.legal_note != blank %}
      <div class="bojax-pricing__legal">
        {{ section.settings.legal_note }}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .bojax-pricing {
    --bojax-price-gold: #d8b86a;
    --bojax-price-gold-light: #f4dda1;
    --bojax-price-gold-pale: #fff0c4;
    --bojax-price-green: #4ce47a;

    position: relative;
    overflow: hidden;
    padding: 8rem 0;

    background:
      radial-gradient(
        circle at 50% 0,
        rgba(216, 184, 106, 0.13),
        transparent 34rem
      ),
      linear-gradient(
        180deg,
        #030303 0%,
        #090806 52%,
        #030303 100%
      );

    color: #ffffff;
  }

  .bojax-pricing::before {
    position: absolute;
    inset: 0 0 auto;
    height: 1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        var(--bojax-price-gold),
        rgba(255, 255, 255, 0.85),
        var(--bojax-price-gold),
        transparent
      );

    content: "";
    opacity: 0.72;
  }

  .bojax-pricing__ambient {
    position: absolute;
    inset: 0;

    overflow: hidden;
    pointer-events: none;
  }

  .bojax-pricing__orb {
    position: absolute;
    display: block;

    border-radius: 50%;
    background: var(--bojax-price-gold);

    filter: blur(10rem);
  }

  .bojax-pricing__orb--left {
    top: 10rem;
    left: -24rem;

    width: 46rem;
    height: 46rem;

    opacity: 0.1;
  }

  .bojax-pricing__orb--right {
    right: -25rem;
    bottom: -5rem;

    width: 48rem;
    height: 48rem;

    opacity: 0.08;
  }

  .bojax-pricing__container {
    position: relative;
    z-index: 2;

    width: min(calc(100% - 4rem), 92rem);
    margin: 0 auto;
  }

  .bojax-pricing__header {
    max-width: 78rem;
    margin: 0 auto;

    text-align: center;
  }

  .bojax-pricing__eyebrow {
    margin: 0 0 1.7rem;

    color: var(--bojax-price-gold-light);

    font-size: 1rem;
    font-weight: 850;
    letter-spacing: 0.33em;
    line-height: 1;
    text-transform: uppercase;
  }

  .bojax-pricing__heading {
    margin: 0;

    color: #ffffff;

    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(4rem, 7vw, 7rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.97;

    text-wrap: balance;
  }

  .bojax-pricing__description {
    max-width: 68rem;
    margin: 2rem auto 0;

    color: rgba(255, 255, 255, 0.62);

    font-size: clamp(1.5rem, 2vw, 1.85rem);
    line-height: 1.65;
  }

  .bojax-pricing__description p,
  .bojax-pricing__legal p {
    margin: 0;
  }

  /* Main pricing box */

  .bojax-pricing__offer {
    margin-top: 4.5rem;
    padding: 4rem;

    border: 1px solid rgba(216, 184, 106, 0.34);
    border-radius: 2.6rem;

    background:
      radial-gradient(
        circle at 50% 0,
        rgba(216, 184, 106, 0.14),
        transparent 34rem
      ),
      linear-gradient(
        145deg,
        rgba(216, 184, 106, 0.07),
        rgba(255, 255, 255, 0.018)
      );

    box-shadow:
      0 3rem 9rem rgba(0, 0, 0, 0.4),
      inset 0 1px rgba(255, 255, 255, 0.05);

    text-align: center;
  }

  .bojax-pricing__offer-label {
    margin: 0;

    color: var(--bojax-price-gold-light);

    font-size: 1rem;
    font-weight: 850;
    letter-spacing: 0.27em;
    line-height: 1;
    text-transform: uppercase;
  }

  .bojax-pricing__price-row {
    display: flex;
    margin-top: 2rem;

    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .bojax-pricing__price {
    color: #ffffff;

    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(5.5rem, 10vw, 9rem);
    font-weight: 700;
    letter-spacing: -0.075em;
    line-height: 0.9;
  }

  .bojax-pricing__compare-price {
    color: rgba(255, 255, 255, 0.31);

    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 1;

    text-decoration-thickness: 0.15rem;
  }

  .bojax-pricing__price-subtext {
    max-width: 66rem;
    margin: 1.8rem auto 0;

    color: rgba(255, 255, 255, 0.53);

    font-size: 1.35rem;
    line-height: 1.55;
  }

  .bojax-pricing__divider {
    height: 1px;
    margin: 3rem 0;

    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(216, 184, 106, 0.38),
        transparent
      );
  }

  /* Included list */

  .bojax-pricing__features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));

    max-width: 72rem;
    margin: 0 auto;

    gap: 1.2rem 2.2rem;
    text-align: left;
  }

  .bojax-pricing__feature {
    display: flex;
    min-width: 0;

    align-items: flex-start;
    gap: 1rem;

    color: rgba(255, 255, 255, 0.8);

    font-size: 1.3rem;
    line-height: 1.45;
  }

  .bojax-pricing__check {
    display: grid;
    flex: 0 0 2.25rem;

    width: 2.25rem;
    height: 2.25rem;
    margin-top: 0.05rem;

    place-items: center;

    border-radius: 50%;
    background: var(--bojax-price-green);
    color: #031108;

    box-shadow:
      0 0 2rem rgba(76, 228, 122, 0.16);
  }

  .bojax-pricing__check svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  /* Add-to-cart button */

  .bojax-pricing__purchase {
    max-width: 76rem;
    margin: 3rem auto 0;
  }

  .bojax-pricing__product-form,
  .bojax-pricing__form {
    display: block;
    width: 100%;
  }

  .bojax-pricing__button {
    position: relative;

    display: flex;
    width: 100%;
    min-height: 6.8rem;
    padding: 1.5rem 2.5rem;

    align-items: center;
    justify-content: center;

    overflow: hidden;

    border: 1px solid #ffffff;
    border-radius: 99rem;

    background:
      linear-gradient(
        135deg,
        #ffffff,
        var(--bojax-price-gold-pale)
      );

    color: #080704;

    font-size: 1.6rem;
    font-weight: 900;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;

    cursor: pointer;

    box-shadow:
      0 2rem 5rem rgba(0, 0, 0, 0.36),
      0 0 4rem rgba(216, 184, 106, 0.13);

    transition:
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .bojax-pricing__button:hover {
    color: #080704;

    box-shadow:
      0 2.5rem 6rem rgba(0, 0, 0, 0.45),
      0 0 5rem rgba(216, 184, 106, 0.2);

    transform: translateY(-0.2rem);
  }

  .bojax-pricing__button:disabled {
    cursor: not-allowed;
    opacity: 0.55;
    transform: none;
  }

  .bojax-pricing__button-content {
    display: inline-flex;

    align-items: center;
    justify-content: center;
    gap: 1.2rem;
  }

  .bojax-pricing__button-arrow {
    display: inline-grid;

    width: 2rem;
    height: 2rem;

    place-items: center;
  }

  .bojax-pricing__button-arrow svg {
    width: 2rem;
    height: 2rem;
  }

  .bojax-pricing__button .loading__spinner {
    position: absolute;
    top: 50%;
    left: 50%;

    transform: translate(-50%, -50%);
  }

  .bojax-pricing__button.loading .bojax-pricing__button-content {
    visibility: hidden;
  }

  /* Non-recurring text: no green check */

  .bojax-pricing__non-recurring {
    margin: 1.8rem 0 0;

    color: rgba(255, 255, 255, 0.58);

    font-size: 1.18rem;
    font-weight: 600;
    letter-spacing: 0.015em;
    line-height: 1.5;
    text-align: center;
  }

  /* Payment methods directly under text */

  .bojax-pricing__payments {
    margin-top: 2.1rem;
    padding: 0;

    border: 0;
    border-radius: 0;

    background: transparent;
    box-shadow: none;

    text-align: center;
  }

  .bojax-pricing__payment-heading {
    margin: 0;

    color: rgba(255, 255, 255, 0.45);

    font-size: 0.88rem;
    font-weight: 850;
    letter-spacing: 0.2em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .bojax-pricing__payment-icons {
    display: flex;
    margin: 1.35rem 0 0;
    padding: 0;

    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.7rem;

    list-style: none;
  }

  .bojax-pricing__payment-icon {
    display: grid;

    width: auto;
    min-width: 4.4rem;
    height: 2.8rem;
    min-height: 0;
    padding: 0.2rem 0.3rem;

    place-items: center;

    border: 0;
    border-radius: 0;

    background: transparent;
    box-shadow: none;
  }

  .bojax-pricing__payment-icon svg {
    display: block;

    width: auto;
    max-width: 4.4rem;
    height: 2.4rem;
  }

  .bojax-pricing__payment-note {
    max-width: 56rem;
    margin: 1.3rem auto 0;

    color: rgba(255, 255, 255, 0.3);

    font-size: 1rem;
    line-height: 1.5;
  }

  .bojax-pricing__legal {
    max-width: 80rem;
    margin: 2rem auto 0;

    color: rgba(255, 255, 255, 0.32);

    font-size: 1.03rem;
    line-height: 1.6;
    text-align: center;
  }

  .bojax-pricing__legal a {
    color: rgba(255, 255, 255, 0.62);
    text-underline-offset: 0.3rem;
  }

  @media screen and (max-width: 749px) {
    .bojax-pricing {
      padding: 6.2rem 0;
    }

    .bojax-pricing__container {
      width: calc(100% - 2.8rem);
    }

    .bojax-pricing__eyebrow {
      font-size: 0.84rem;
      letter-spacing: 0.24em;
    }

    .bojax-pricing__heading {
      font-size: clamp(3.7rem, 12vw, 5.2rem);
    }

    .bojax-pricing__description {
      font-size: 1.38rem;
    }

    .bojax-pricing__offer {
      margin-top: 3.5rem;
      padding: 2.7rem 1.5rem;

      border-radius: 2rem;
    }

    .bojax-pricing__offer-label {
      font-size: 0.82rem;
      letter-spacing: 0.23em;
    }

    .bojax-pricing__price-row {
      gap: 1rem;
    }

    .bojax-pricing__price {
      font-size: clamp(5rem, 18vw, 7rem);
    }

    .bojax-pricing__compare-price {
      font-size: 2rem;
    }

    .bojax-pricing__price-subtext {
      font-size: 1.18rem;
    }

    .bojax-pricing__divider {
      margin: 2.5rem 0;
    }

    .bojax-pricing__features {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .bojax-pricing__feature {
      font-size: 1.18rem;
    }

    .bojax-pricing__button {
      min-height: 6.2rem;
      padding: 1.3rem 1.4rem;

      font-size: 1.32rem;
    }

    .bojax-pricing__button-content {
      gap: 0.8rem;
    }

    .bojax-pricing__non-recurring {
      margin-top: 1.55rem;

      font-size: 1.03rem;
      line-height: 1.45;
    }

    .bojax-pricing__payments {
      margin-top: 1.8rem;
    }

    .bojax-pricing__payment-heading {
      font-size: 0.72rem;
      letter-spacing: 0.16em;
    }

    .bojax-pricing__payment-icons {
      margin-top: 1.1rem;
      gap: 0.4rem;
    }

    .bojax-pricing__payment-icon {
      min-width: 3.8rem;
      height: 2.5rem;
      padding: 0.1rem 0.2rem;
    }

    .bojax-pricing__payment-icon svg {
      max-width: 3.8rem;
      height: 2.1rem;
    }

    .bojax-pricing__payment-note {
      margin-top: 1.1rem;

      font-size: 0.88rem;
    }

    .bojax-pricing__legal {
      font-size: 0.9rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bojax pricing",
  "tag": "section",
  "class": "bojax-pricing-section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Course product"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "ONE-TIME PAYMENT"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Get the complete Bojax Method"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Unlock the complete course with one payment. No subscription, no monthly billing and no recurring charges.</p>"
    },
    {
      "type": "text",
      "id": "offer_label",
      "label": "Price label",
      "default": "PAY ONCE • KEEP ACCESS"
    },
    {
      "type": "text",
      "id": "fallback_price",
      "label": "Fallback price",
      "default": "$29.99"
    },
    {
      "type": "checkbox",
      "id": "show_fallback_compare_price",
      "label": "Show crossed-out price",
      "default": true
    },
    {
      "type": "text",
      "id": "fallback_compare_price",
      "label": "Fallback crossed-out price",
      "default": "$59.99"
    },
    {
      "type": "text",
      "id": "price_subtext",
      "label": "Text below price",
      "default": "One-time purchase • Instant digital delivery • Lifetime course access"
    },
    {
      "type": "text",
      "id": "feature_1",
      "label": "Included item 1",
      "default": "Complete looksmaxxing curriculum"
    },
    {
      "type": "text",
      "id": "feature_2",
      "label": "Included item 2",
      "default": "40+ detailed video lessons"
    },
    {
      "type": "text",
      "id": "feature_3",
      "label": "Included item 3",
      "default": "Instant access after checkout"
    },
    {
      "type": "text",
      "id": "feature_4",
      "label": "Included item 4",
      "default": "Lifetime access to your purchase"
    },
    {
      "type": "text",
      "id": "feature_5",
      "label": "Included item 5",
      "default": "Future course updates included"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Purchase button text",
      "default": "Get instant access"
    },
    {
      "type": "text",
      "id": "non_recurring_text",
      "label": "Non-recurring message",
      "default": "$29.99 one-time purchase • Non-recurring • No subscription"
    },
    {
      "type": "header",
      "content": "Payment methods"
    },
    {
      "type": "text",
      "id": "payment_heading",
      "label": "Payment heading",
      "default": "Accepted payment methods"
    },
    {
      "type": "text",
      "id": "payment_note",
      "label": "Payment note",
      "default": "Available payment options may vary by location, currency and checkout eligibility."
    },
    {
      "type": "richtext",
      "id": "legal_note",
      "label": "Legal note",
      "default": "<p>By completing your purchase, you agree to the store’s terms and refund policy. Individual results vary.</p>"
    }
  ],
  "presets": [
    {
      "name": "Bojax pricing"
    }
  ]
}
{% endschema %}
