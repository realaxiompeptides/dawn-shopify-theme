<script>
  (function () {
    var sectionId = '{{ section.id }}';
    var sectionElementId = 'BojaxPricing-' + sectionId;
    var countdownElementId = 'BojaxCountdown-' + sectionId;

    window.BojaxPricingCountdownRegistry = window.BojaxPricingCountdownRegistry || {};

    function clearSectionInterval() {
      var existingInterval = window.BojaxPricingCountdownRegistry[sectionId];

      if (existingInterval) {
        window.clearInterval(existingInterval);
        delete window.BojaxPricingCountdownRegistry[sectionId];
      }
    }

    function safelyReadStorage(storageKey) {
      try {
        return window.localStorage.getItem(storageKey);
      } catch (error) {
        return null;
      }
    }

    function safelyWriteStorage(storageKey, value) {
      try {
        window.localStorage.setItem(storageKey, value);
      } catch (error) {}
    }

    function createRandomDurationMilliseconds(minimumHours, maximumHours) {
      var minimumSeconds = Math.round(minimumHours * 3600);
      var maximumSeconds = Math.round(maximumHours * 3600);

      if (maximumSeconds < minimumSeconds) {
        maximumSeconds = minimumSeconds;
      }

      return (
        minimumSeconds +
        Math.floor(Math.random() * (maximumSeconds - minimumSeconds + 1))
      ) * 1000;
    }

    function createNewExpiration(storageKey, minimumHours, maximumHours) {
      var expirationTime =
        Date.now() +
        createRandomDurationMilliseconds(minimumHours, maximumHours);

      safelyWriteStorage(storageKey, String(expirationTime));
      return expirationTime;
    }

    function getExpirationTime(storageKey, minimumHours, maximumHours) {
      var storedExpiration = Number(safelyReadStorage(storageKey));

      if (Number.isFinite(storedExpiration) && storedExpiration > Date.now()) {
        return storedExpiration;
      }

      return createNewExpiration(storageKey, minimumHours, maximumHours);
    }

    function padNumber(number) {
      return String(number).padStart(2, '0');
    }

    function initializeBojaxCountdown() {
      var sectionElement = document.getElementById(sectionElementId);
      var countdownElement = document.getElementById(countdownElementId);

      if (!sectionElement || !countdownElement) {
        clearSectionInterval();
        return;
      }

      clearSectionInterval();

      var hoursElement = countdownElement.querySelector('[data-countdown-hours]');
      var minutesElement = countdownElement.querySelector('[data-countdown-minutes]');
      var secondsElement = countdownElement.querySelector('[data-countdown-seconds]');

      if (!hoursElement || !minutesElement || !secondsElement) return;

      var minimumHours = Number.parseFloat(countdownElement.dataset.minHours);
      var maximumHours = Number.parseFloat(countdownElement.dataset.maxHours);

      if (!Number.isFinite(minimumHours)) minimumHours = 5.25;
      if (!Number.isFinite(maximumHours)) maximumHours = 8.75;
      if (minimumHours < 0.25) minimumHours = 0.25;
      if (maximumHours < minimumHours) maximumHours = minimumHours;

      var storageKey =
        countdownElement.dataset.storageKey ||
        'bojax-pricing-countdown-v4-' + sectionId;

      var expirationTime = getExpirationTime(
        storageKey,
        minimumHours,
        maximumHours
      );

      function updateCountdown() {
        var remainingMilliseconds = expirationTime - Date.now();

        if (remainingMilliseconds <= 0) {
          expirationTime = createNewExpiration(
            storageKey,
            minimumHours,
            maximumHours
          );
          remainingMilliseconds = expirationTime - Date.now();
        }

        var remainingSeconds = Math.max(
          0,
          Math.ceil(remainingMilliseconds / 1000)
        );

        var hours = Math.floor(remainingSeconds / 3600);
        var minutes = Math.floor((remainingSeconds % 3600) / 60);
        var seconds = remainingSeconds % 60;

        hoursElement.textContent = padNumber(hours);
        minutesElement.textContent = padNumber(minutes);
        secondsElement.textContent = padNumber(seconds);
      }

      updateCountdown();

      window.BojaxPricingCountdownRegistry[sectionId] =
        window.setInterval(updateCountdown, 1000);
    }

    if (document.readyState === 'loading') {
      document.addEventListener(
        'DOMContentLoaded',
        initializeBojaxCountdown,
        { once: true }
      );
    } else {
      initializeBojaxCountdown();
    }

    window.addEventListener('pageshow', initializeBojaxCountdown);

    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail && event.detail.sectionId === sectionId) {
        initializeBojaxCountdown();
      }
    });

    document.addEventListener('shopify:section:unload', function (event) {
      if (event.detail && event.detail.sectionId === sectionId) {
        clearSectionInterval();
      }
    });
  })();
</script>

