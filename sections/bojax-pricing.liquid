<script>
  (() => {
    const initializeBojaxPricing = (section) => {
      if (
        !section ||
        section.dataset.bojaxPricingInitialized === 'true'
      ) {
        return;
      }

      section.dataset.bojaxPricingInitialized = 'true';

      const countdown = section.querySelector(
        '[data-bojax-countdown]'
      );

      if (!countdown) return;

      const hoursElement = countdown.querySelector(
        '[data-countdown-hours]'
      );

      const minutesElement = countdown.querySelector(
        '[data-countdown-minutes]'
      );

      const secondsElement = countdown.querySelector(
        '[data-countdown-seconds]'
      );

      const minimumHours =
        parseFloat(countdown.dataset.minHours) || 5.25;

      const maximumHours =
        parseFloat(countdown.dataset.maxHours) || 8.75;

      const storageKey =
        countdown.dataset.storageKey ||
        'bojax-pricing-expiration';

      const createExpiration = () => {
        const minimumMilliseconds =
          minimumHours * 60 * 60 * 1000;

        const maximumMilliseconds =
          maximumHours * 60 * 60 * 1000;

        const randomDuration =
          minimumMilliseconds +
          Math.random() *
            (maximumMilliseconds - minimumMilliseconds);

        const expiration =
          Date.now() + Math.round(randomDuration);

        try {
          window.localStorage.setItem(
            storageKey,
            String(expiration)
          );
        } catch (error) {
          console.warn(
            '[Bojax pricing] Countdown storage unavailable.',
            error
          );
        }

        return expiration;
      };

      const getExpiration = () => {
        try {
          const savedExpiration = Number(
            window.localStorage.getItem(storageKey)
          );

          if (
            Number.isFinite(savedExpiration) &&
            savedExpiration > Date.now()
          ) {
            return savedExpiration;
          }
        } catch (error) {
          console.warn(
            '[Bojax pricing] Countdown storage unavailable.',
            error
          );
        }

        return createExpiration();
      };

      let expiration = getExpiration();

      const renderCountdown = () => {
        let remaining = expiration - Date.now();

        if (remaining <= 0) {
          expiration = createExpiration();
          remaining = expiration - Date.now();
        }

        const totalSeconds = Math.max(
          0,
          Math.floor(remaining / 1000)
        );

        const hours = Math.floor(totalSeconds / 3600);
        const minutes = Math.floor(
          (totalSeconds % 3600) / 60
        );
        const seconds = totalSeconds % 60;

        if (hoursElement) {
          hoursElement.textContent = String(hours).padStart(
            2,
            '0'
          );
        }

        if (minutesElement) {
          minutesElement.textContent = String(minutes).padStart(
            2,
            '0'
          );
        }

        if (secondsElement) {
          secondsElement.textContent = String(seconds).padStart(
            2,
            '0'
          );
        }
      };

      renderCountdown();

      const interval = window.setInterval(
        renderCountdown,
        1000
      );

      section.addEventListener(
        'shopify:section:unload',
        () => {
          window.clearInterval(interval);
        },
        {
          once: true
        }
      );
    };

    const initializeAllBojaxPricing = (root = document) => {
      if (
        root.matches &&
        root.matches('[data-bojax-pricing]')
      ) {
        initializeBojaxPricing(root);
      }

      root
        .querySelectorAll?.('[data-bojax-pricing]')
        .forEach(initializeBojaxPricing);
    };

    if (document.readyState === 'loading') {
      document.addEventListener(
        'DOMContentLoaded',
        () => {
          initializeAllBojaxPricing(document);
        }
      );
    } else {
      initializeAllBojaxPricing(document);
    }

    document.addEventListener(
      'shopify:section:load',
      (event) => {
        initializeAllBojaxPricing(event.target);
      }
    );
  })();
</script>

