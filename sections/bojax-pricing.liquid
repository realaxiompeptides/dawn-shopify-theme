    }

    .bojax-pricing__eyebrow {
      margin-bottom: 8px;
      font-size: 1.05rem;
      letter-spacing: 0.26em;
    }

    .bojax-pricing__heading {
      font-size: clamp(3.9rem, 11.8vw, 5.8rem);
      line-height: 0.95;
    }

    .bojax-pricing__description {
      margin-top: 18px;
      font-size: 1.72rem;
      line-height: 1.65;
    }

    .bojax-pricing__card {
      margin-top: 24px;
      border-radius: 24px;
    }

    .bojax-pricing__card-inner {
      padding: 24px 18px 22px;
      border-radius: 23px;
    }

    .bojax-pricing__card-eyebrow {
      margin-bottom: 14px;
      font-size: 1rem;
      letter-spacing: 0.28em;
    }

    .bojax-pricing__price-row {
      gap: 8px;
    }

    .bojax-pricing__subtext {
      margin-top: 24px;
      font-size: 1.62rem;
      line-height: 1.6;
    }

    .bojax-pricing__countdown-wrap {
      margin-top: 16px;
      margin-bottom: 22px;
    }

    .bojax-pricing__countdown-label {
      font-size: 1rem;
    }

    .bojax-pricing__countdown {
      min-width: 126px;
      min-height: 42px;
      padding: 8px 14px;
    }

    .bojax-pricing__countdown-time {
      font-size: 1.8rem;
    }

    .bojax-pricing__benefits {
      gap: 12px;
    }

    .bojax-pricing__benefits li {
      gap: 12px;
      font-size: 1.72rem;
      line-height: 1.45;
    }

    .bojax-pricing__check {
      width: 30px;
      height: 30px;
      flex-basis: 30px;
      font-size: 1.7rem;
    }

    .bojax-pricing__form {
      margin-top: 24px;
    }

    .bojax-pricing__button {
      min-height: 66px;
      padding: 16px 22px;
      font-size: 1.92rem;
    }

    .bojax-pricing__button-arrow {
      font-size: 2.2rem;
    }

    .bojax-pricing__purchase-note {
      margin-top: 16px;
      font-size: 1.42rem;
      line-height: 1.5;
    }

    .bojax-pricing__payments {
      margin-top: 16px;
    }

    .bojax-pricing__payment-icons {
      gap: 8px 10px;
    }

    .bojax-pricing__payment-icon svg {
      width: 40px;
    }

    .bojax-pricing__footer-note {
      font-size: 1.2rem;
      line-height: 1.55;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.getElementById('BojaxPricing-{{ section.id }}');
    if (!section) return;

    const countdown = section.querySelector('.bojax-pricing__countdown');
    if (countdown) {
      const storageKey = countdown.dataset.storageKey;
      const minutes = parseInt(countdown.dataset.minutes, 10) || 15;
      const display = countdown.querySelector('.bojax-pricing__countdown-time');

      function getTargetTime() {
        const existing = localStorage.getItem(storageKey);
        const now = Date.now();

        if (existing && parseInt(existing, 10) > now) {
          return parseInt(existing, 10);
        }

        const next = now + (minutes * 60 * 1000);
        localStorage.setItem(storageKey, next.toString());
        return next;
      }

      let targetTime = getTargetTime();

      function updateCountdown() {
        const now = Date.now();
        let diff = targetTime - now;

        if (diff <= 0) {
          targetTime = now + (minutes * 60 * 1000);
          localStorage.setItem(storageKey, targetTime.toString());
          diff = targetTime - now;
        }

        const totalSeconds = Math.floor(diff / 1000);
        const mins = Math.floor(totalSeconds / 60);
        const secs = totalSeconds % 60;

        if (display) {
          display.textContent = String(mins).padStart(2, '0') + ':' + String(secs).padStart(2, '0');
        }
      }

      updateCountdown();
      setInterval(updateCountdown, 1000);
    }

    const form = section.querySelector('[data-bojax-atc-form]');
    if (form) {
      form.addEventListener('submit', async function(e) {
        e.preventDefault();

        const button = form.querySelector('button[type="submit"]');
        const formData = new FormData(form);

        if (button) {
          button.disabled = true;
          button.style.opacity = '0.7';
        }

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Accept': 'application/json'
            },
            body: formData
          });

          if (!response.ok) throw new Error('Add to cart failed');

          await response.json();

          const cartNotification = document.querySelector('cart-notification');
          if (cartNotification && typeof cartNotification.renderContents === 'function') {
            const cartResponse = await fetch('/?sections=cart-notification-product,cart-notification-button,cart-icon-bubble');
            const cartSectionsText = await cartResponse.text();
            const parsed = JSON.parse(cartSectionsText);

            cartNotification.renderContents({
              key: Date.now(),
              sections: parsed,
              items: []
            });

            if (typeof cartNotification.open === 'function') {
              cartNotification.open();
            }
          } else {
            window.location.href = '/cart';
          }
        } catch (error) {
          window.location.href = '/cart';
        } finally {
          if (button) {
            button.disabled = false;
            button.style.opacity = '';
          }
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "Bojax course pricing",
  "tag": "section",
  "class": "bojax-course-pricing-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "One-time payment"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get the complete Bojax Method"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Unlock the complete course with one payment. No subscription, no monthly billing and no recurring charges.</p>"
    },
    {
      "type": "text",
      "id": "price_eyebrow",
      "label": "Price eyebrow",
      "default": "Today's price • keep access"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Main price",
      "default": "$29.99"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Compare-at price",
      "default": "$59.99"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Text under price",
      "default": "One-time purchase • Instant digital delivery • Lifetime course access"
    },
    {
      "type": "text",
      "id": "countdown_label",
      "label": "Countdown label",
      "default": "Your price is reserved for this session"
    },
    {
      "type": "range",
      "id": "countdown_minutes",
      "label": "Countdown minutes",
      "min": 5,
      "max": 60,
      "step": 1,
      "default": 15
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Get Lifetime Access — $29.99"
    },
    {
      "type": "text",
      "id": "product_handle",
      "label": "Product handle",
      "default": "bojax-course",
      "info": "Example: bojax-course"
    },
    {
      "type": "text",
      "id": "purchase_note",
      "label": "Purchase note",
      "default": "$29.99 one-time purchase • Non-recurring • No subscription"
    },
    {
      "type": "text",
      "id": "payment_heading",
      "label": "Payment heading",
      "default": "Accepted payment methods"
    },
    {
      "type": "text",
      "id": "footer_note",
      "label": "Footer note",
      "default": "By completing your purchase, you agree to the store’s terms and refund policy. Individual results vary."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Bojax course pricing"
    }
  ]
}
{% endschema %}
