{% comment %}
  Bojax premium cart drawer.
  Keeps Dawn's required IDs/classes so AJAX add-to-cart and cart updates continue working.
  Bojax-specific benefits render only inside the bojax-course product card.
{% endcomment %}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>

<style>
  .drawer { visibility: hidden; }
</style>

<cart-drawer class="drawer{% if cart == empty %} is-empty{% endif %}" data-cart-empty="{% if cart == empty %}true{% else %}false{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>

    <div
      class="drawer__inner bojax-course-drawer"
      role="dialog"
      aria-modal="true"
      aria-label="Your cart"
      tabindex="-1"
    >
      <div class="drawer__header bojax-course-drawer__header">
        <div>
          <p class="bojax-course-drawer__eyebrow">YOUR CART</p>
          <h2 class="drawer__heading">Your items are reserved</h2>
        </div>

        <button
          class="drawer__close bojax-course-drawer__close"
          type="button"
          onclick="this.closest('cart-drawer').close()"
          aria-label="Close cart"
        >
          <span class="svg-wrapper">{{- 'icon-close.svg' | inline_asset_content -}}</span>
        </button>
      </div>

      {%- if cart == empty -%}
        <div class="drawer__inner-empty bojax-course-drawer__empty">
          <div class="cart-drawer__warnings center">
            <div class="cart-drawer__empty-content">
              <h2 class="cart__empty-text">Your cart is empty</h2>
              <p>Add an item to continue.</p>
              <button class="button bojax-course-drawer__primary" type="button" onclick="this.closest('cart-drawer').close()">
                Continue shopping
              </button>
            </div>
          </div>
        </div>
      {%- else -%}
        <cart-drawer-items
          view-event-payload="{{ cart | standard_event_data: 'view', context: 'dialog' | escape }}"
          view-event-trigger="manual"
        >
          <form action="{{ routes.cart_url }}" id="CartDrawer-Form" class="cart__contents cart-drawer__form" method="post">
            <div id="CartDrawer-CartItems" class="drawer__contents js-contents bojax-course-drawer__body">
              <div class="bojax-course-drawer__reservation" aria-live="polite">
                <span class="bojax-course-drawer__reservation-icon" aria-hidden="true">✓</span>
                <div>
                  <span class="bojax-course-drawer__reservation-label">Cart reserved for</span>
                  <strong class="bojax-course-drawer__timer" data-bojax-cart-timer>15:00</strong>
                </div>
              </div>

              <div class="bojax-course-drawer__items">
                {%- for item in cart.items -%}
                  <article
                    id="CartDrawer-Item-{{ item.index | plus: 1 }}"
                    class="bojax-course-drawer__item cart-item{% if item.product.handle == 'bojax-course' %} bojax-course-drawer__item--bojax{% endif %}"
                  >
                    <div class="bojax-course-drawer__item-main">
                      <div class="bojax-course-drawer__media">
                        {%- if item.image -%}
                          <img
                            src="{{ item.image | image_url: width: 360 }}"
                            alt="{{ item.image.alt | default: item.product.title | escape }}"
                            loading="lazy"
                            width="180"
                            height="180"
                          >
                        {%- else -%}
                          <div class="bojax-course-drawer__media-placeholder">
                            {{ item.product.title | slice: 0, 2 | upcase }}
                          </div>
                        {%- endif -%}
                      </div>

                      <div class="bojax-course-drawer__details">
                        {%- if item.product.handle == 'bojax-course' -%}
                          <p class="bojax-course-drawer__access">Lifetime course access</p>
                        {%- endif -%}

                        <h3>{{ item.product.title | escape }}</h3>

                        {%- unless item.product.has_only_default_variant -%}
                          <p class="bojax-course-drawer__variant">{{ item.variant.title | escape }}</p>
                        {%- endunless -%}

                        <div class="bojax-course-drawer__price">
                          {%- if item.original_line_price != item.final_line_price -%}
                            <s>{{ item.original_line_price | money }}</s>
                          {%- endif -%}
                          <strong>{{ item.final_line_price | money }}</strong>
                        </div>

                        <input
                          type="hidden"
                          name="updates[]"
                          value="{{ item.quantity }}"
                          data-index="{{ item.index | plus: 1 }}"
                        >

                        <cart-remove-button
                          id="CartDrawer-Remove-{{ item.index | plus: 1 }}"
                          data-index="{{ item.index | plus: 1 }}"
                        >
                          <button
                            type="button"
                            class="bojax-course-drawer__remove"
                            aria-label="Remove {{ item.title | escape }}"
                            data-variant-id="{{ item.variant.id }}"
                          >
                            Remove
                          </button>
                        </cart-remove-button>
                      </div>
                    </div>

                    {%- if item.product.handle == 'bojax-course' -%}
                      <div class="bojax-course-drawer__included">
                        <h3>Included with your access</h3>
                        <ul>
                          <li><span aria-hidden="true">✓</span> 40+ detailed video lessons</li>
                          <li><span aria-hidden="true">✓</span> Instant digital access</li>
                          <li><span aria-hidden="true">✓</span> Lifetime course updates</li>
                          <li><span aria-hidden="true">✓</span> Direct access to Bojax</li>
                        </ul>
                      </div>
                    {%- endif -%}
                  </article>
                {%- endfor -%}
              </div>

              <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
              <p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status">Loading</p>

              <div id="CartDrawer-CartErrors" role="alert"></div>
            </div>
          </form>
        </cart-drawer-items>

        <div class="drawer__footer bojax-course-drawer__footer">
          <div class="bojax-course-drawer__total">
            <span>Total</span>
            <strong>{{ cart.total_price | money_with_currency }}</strong>
          </div>

          <button
            type="submit"
            id="CartDrawer-Checkout"
            class="button cart__checkout-button bojax-course-drawer__primary"
            name="checkout"
            form="CartDrawer-Form"
          >
            Complete checkout
            <span aria-hidden="true">→</span>
          </button>

          <a href="{{ routes.cart_url }}" class="bojax-course-drawer__secondary">View cart</a>

          <ul
            class="bojax-course-drawer__payments"
            role="list"
            aria-label="Accepted payment methods"
          >
            {%- if shop.enabled_payment_types.size > 0 -%}
              {%- for type in shop.enabled_payment_types -%}
                <li class="bojax-course-drawer__payment-icon">
                  {{ type | payment_type_svg_tag }}
                </li>
              {%- endfor -%}
            {%- else -%}
              {%- assign fallback_payment_types = 'visa,master,american_express,apple_pay,shopify_pay' | split: ',' -%}
              {%- for type in fallback_payment_types -%}
                <li class="bojax-course-drawer__payment-icon">
                  {{ type | payment_type_svg_tag }}
                </li>
              {%- endfor -%}
            {%- endif -%}
          </ul>

          <div class="bojax-course-drawer__secure">
            <span aria-hidden="true">🔒</span>
            Secure checkout · One-time payment
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</cart-drawer>
