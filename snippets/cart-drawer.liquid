{%- for item in cart.items -%}
  <div
    id="CartDrawer-Item-{{ item.index | plus: 1 }}"
    class="
      bojax-cart-item
      {% if item.product.handle == 'bojax-course' %}
        bojax-cart-item--course
      {% endif %}
    "
    role="row"
  >
    <div class="bojax-cart-item__main">
      <div class="bojax-cart-item__media">
        {%- if item.image -%}
          <a
            href="{{ item.url }}"
            class="bojax-cart-item__image-link"
            tabindex="-1"
            aria-hidden="true"
          >
            <img
              class="bojax-cart-item__image"
              src="{{ item.image | image_url: width: 320 }}"
              alt="{{ item.image.alt | escape }}"
              loading="lazy"
              width="160"
              height="{{ 160 | divided_by: item.image.aspect_ratio | ceil }}"
            >
          </a>
        {%- endif -%}
      </div>

      <div class="bojax-cart-item__details">
        {%- if item.product.handle == 'bojax-course' -%}
          <span class="bojax-cart-item__eyebrow">
            Lifetime course access
          </span>
        {%- endif -%}

        <a
          href="{{ item.url }}"
          class="bojax-cart-item__title"
        >
          {{ item.product.title | escape }}
        </a>

        {%- if item.product.has_only_default_variant == false
          or item.properties.size != 0
          or item.selling_plan_allocation != null
        -%}
          <dl class="bojax-cart-item__options">
            {%- unless item.product.has_only_default_variant -%}
              {%- for option in item.options_with_values -%}
                <div class="product-option">
                  <dt>{{ option.name }}:</dt>
                  <dd>{{ option.value }}</dd>
                </div>
              {%- endfor -%}
            {%- endunless -%}

            {%- for property in item.properties -%}
              {%- assign property_first_char = property.first | slice: 0 -%}

              {%- if property.last != blank and property_first_char != '_' -%}
                <div class="product-option">
                  <dt>{{ property.first }}:</dt>
                  <dd>
                    {%- if property.last contains '/uploads/' -%}
                      <a
                        href="{{ property.last }}"
                        class="link"
                        target="_blank"
                      >
                        {{ property.last | split: '/' | last }}
                      </a>
                    {%- else -%}
                      {{ property.last }}
                    {%- endif -%}
                  </dd>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </dl>

          <p class="product-option">
            {{ item.selling_plan_allocation.selling_plan.name }}
          </p>
        {%- endif -%}

        <div class="bojax-cart-item__price">
          {{ item.final_line_price | money }}
        </div>

        <cart-remove-button
          id="CartDrawer-Remove-{{ item.index | plus: 1 }}"
          data-index="{{ item.index | plus: 1 }}"
        >
          <button
            type="button"
            class="bojax-cart-item__remove"
            aria-label="{{ 'sections.cart.remove_title' | t: title: item.title }}"
          >
            Remove
          </button>
        </cart-remove-button>
      </div>
    </div>

    {%- if item.product.handle == 'bojax-course' -%}
      <div class="bojax-cart-item__benefits">
        <div class="bojax-cart-item__benefit">
          <span aria-hidden="true">✓</span>
          <span>40+ detailed video lessons</span>
        </div>

        <div class="bojax-cart-item__benefit">
          <span aria-hidden="true">✓</span>
          <span>Instant digital access</span>
        </div>

        <div class="bojax-cart-item__benefit">
          <span aria-hidden="true">✓</span>
          <span>Lifetime course updates</span>
        </div>

        <div class="bojax-cart-item__benefit">
          <span aria-hidden="true">✓</span>
          <span>Direct access to Bojax</span>
        </div>
      </div>
    {%- endif -%}
  </div>
{%- endfor -%}
